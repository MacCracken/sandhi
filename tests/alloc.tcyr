# sandhi alloc test suite — covers the v1.1.0 Allocator-as-first-arg
# migration. Lives in its own .tcyr so it doesn't push tests/sandhi.tcyr
# over the per-program fixup-table cap (architecture/001).
#
# Each batch of the migration adds a `test_alloc_batchN_*` group below
# that drives the per-request-arena pattern + OOM coverage for at least
# one `_a` variant in that batch (proposal acceptance gates 4 + 5).

include "src/version_str.cyr"
include "src/error.cyr"
include "src/obs/trace.cyr"
include "src/obs/prof.cyr"
include "src/http/headers.cyr"
include "src/http/url.cyr"
include "src/tls_policy/session_cache.cyr"
include "src/http/conn.cyr"
include "src/tls_policy/policy.cyr"
include "src/tls_policy/fingerprint.cyr"
# apply.cyr + alpn.cyr (below) define the policy pre/post-open helpers and
# sandhi_conn_alpn_is_h2 that the included h2 dispatch path references. They were
# tolerated as unreachable-NOP warnings before, but cyrius 6.3.x's linker refuses
# to emit with reachable-undefined fns, so this subset suite must include them
# (mirrors tests/sandhi.tcyr). Function symbols resolve at link, so the relative
# include order only matters for top-level decls — both depend only on
# conn/policy/fingerprint, already above.
include "src/tls_policy/apply.cyr"
include "src/http/response.cyr"
include "src/net/resolve.cyr"
include "src/http/client.cyr"
include "src/http/pool.cyr"
include "src/http/h2/huffman.cyr"
include "src/http/h2/hpack.cyr"
include "src/http/h2/frame.cyr"
include "src/http/h2/conn.cyr"
include "src/http/h2/request.cyr"
include "src/http/h2/response.cyr"
include "src/http/h2/pool_glue.cyr"
include "src/http/h2/dispatch.cyr"
include "src/http/sse.cyr"
include "src/http/stream.cyr"
include "src/http/retry.cyr"
include "src/tls_policy/alpn.cyr"
include "src/server/mod.cyr"
include "src/rpc/json.cyr"
include "src/rpc/dispatch.cyr"
include "src/rpc/webdriver.cyr"
include "src/rpc/appium.cyr"
include "src/rpc/mcp.cyr"
include "src/discovery/service.cyr"
include "src/discovery/chain.cyr"
include "src/discovery/daimon.cyr"
include "src/discovery/local.cyr"
include "src/main.cyr"  # sandhi_version() — referenced by http/client.cyr's UA builder

# ================================================================
# Batch 1 — leaves
# ================================================================

# url.cyr — per-request-arena round-trip. Parse two URLs into the
# same arena across a reset; verify reset reclaims the first parse.
fn test_alloc_batch1_url_arena_reset() {
    var a = arena_allocator(4096);
    assert_eq(a != 0, 1, "arena_allocator(4096) constructed");

    var u1 = sandhi_url_parse_a(a, "http://example.com:8080/foo?bar=baz");
    assert_eq(u1 != 0, 1, "url parse #1 into arena succeeded");
    assert_eq(sandhi_url_scheme(u1), SANDHI_URL_HTTP, "scheme #1");
    assert_eq(sandhi_url_port(u1), 8080, "port #1");
    assert_streq(sandhi_url_host(u1), "example.com", "host #1");
    assert_streq(sandhi_url_path(u1), "/foo", "path #1");
    assert_streq(sandhi_url_query(u1), "bar=baz", "query #1");

    var used_after_first = arena_used(allocator_state(a));
    assert_eq(used_after_first > 0, 1, "arena bytes consumed by parse #1");

    reset_via(a);

    var used_after_reset = arena_used(allocator_state(a));
    assert_eq(used_after_reset, 0, "reset_via clears arena");

    var u2 = sandhi_url_parse_a(a, "https://[::1]:443/");
    assert_eq(u2 != 0, 1, "url parse #2 into reset arena succeeded");
    assert_eq(sandhi_url_scheme(u2), SANDHI_URL_HTTPS, "scheme #2");
    assert_eq(sandhi_url_port(u2), 443, "port #2");
    assert_streq(sandhi_url_host(u2), "::1", "v6 host stripped of brackets");
    return 0;
}

# url.cyr — OOM via fail_after_n_allocs. The host parse path takes
# 2 allocs (host cstr + struct) for the simplest input
# "http://example.com/"; failing after 1 should yield 0 cleanly.
fn test_alloc_batch1_url_oom() {
    var a = fail_after_n_allocs(1);
    assert_eq(a != 0, 1, "fail_after_n_allocs(1) constructed");
    var u = sandhi_url_parse_a(a, "http://example.com/");
    assert_eq(u, 0, "OOM at second alloc → parse returns 0, no abort");
    return 0;
}

# headers.cyr — arena reset reclaims a parsed header block.
fn test_alloc_batch1_headers_arena_reset() {
    var a = arena_allocator(4096);
    var raw = "X-One: alpha\r\nX-Two: beta\r\n\r\n";
    var rlen = strlen(raw);

    var h1 = sandhi_headers_parse_a(a, raw, rlen);
    assert_eq(h1 != 0, 1, "headers parse #1 into arena");
    assert_eq(sandhi_headers_count(h1), 2, "two entries parsed");
    assert_streq(sandhi_headers_get(h1, "x-one"), "alpha", "case-insensitive get");

    var used_after_first = arena_used(allocator_state(a));
    reset_via(a);
    assert_eq(arena_used(allocator_state(a)), 0, "arena cleared");
    assert_eq(used_after_first > 0, 1, "first parse did consume bytes");

    var h2 = sandhi_headers_parse_a(a, raw, rlen);
    assert_eq(h2 != 0, 1, "headers parse #2 into reset arena");
    assert_eq(sandhi_headers_count(h2), 2, "two entries parsed (round 2)");
    return 0;
}

# headers.cyr — OOM. add_a returns -2 on alloc failure (not -1
# which is byte-rejection). Drive a 0-budget allocator to confirm.
fn test_alloc_batch1_headers_add_oom() {
    var a = arena_allocator(4096);
    var h = sandhi_headers_new_a(a);
    assert_eq(h != 0, 1, "block allocated");

    # Switch to a failing alloc for the actual add. fail_after(0)
    # makes EVERY alloc fail.
    var failer = fail_after_n_allocs(0);
    var rc = sandhi_headers_add_a(failer, h, "X-Test", "value");
    assert_eq(rc, 0 - 2, "add_a returns -2 on OOM");
    return 0;
}

# service.cyr — service_new_a OOM yields 0 cleanly.
fn test_alloc_batch1_service_oom() {
    var failer = fail_after_n_allocs(0);
    var s = sandhi_service_new_a(failer, "x", "host", 80, 0);
    assert_eq(s, 0, "service_new_a returns 0 on OOM");
    return 0;
}

# pool.cyr — pool_new_a stores the allocator on the struct.
fn test_alloc_batch1_pool_alloc_slot() {
    var a = arena_allocator(8192);
    var p = sandhi_http_pool_new_a(a, 4, 60000);
    assert_eq(p != 0, 1, "pool_new_a succeeded");
    assert_eq(sandhi_http_pool_max_per_host(p), 4, "max_per_host stored");
    # Confirm the allocator slot round-trips: _sandhi_pool_alloc(p)
    # must be the same pointer we handed in.
    assert_eq(_sandhi_pool_alloc(p) == a, 1, "pool stores allocator handle");
    return 0;
}

# h2/frame.cyr — hdr_new_a + hdr_decode_a + OOM round-trip.
fn test_alloc_batch1_h2_hdr_arena() {
    var a = arena_allocator(1024);
    var h = sandhi_h2_hdr_new_a(a, 16, SANDHI_H2_FRAME_DATA, 0, 1);
    assert_eq(h != 0, 1, "h2 hdr alloced into arena");
    assert_eq(sandhi_h2_hdr_length(h), 16, "length round-trip");
    assert_eq(sandhi_h2_hdr_type(h), SANDHI_H2_FRAME_DATA, "type round-trip");
    assert_eq(sandhi_h2_hdr_stream_id(h), 1, "stream_id round-trip");

    var failer = fail_after_n_allocs(0);
    var h_oom = sandhi_h2_hdr_new_a(failer, 0, 0, 0, 0);
    assert_eq(h_oom, 0, "hdr_new_a returns 0 on OOM");
    return 0;
}

# ================================================================
# Batch 2 — TLS + h2 leaves
# ================================================================

# fingerprint.cyr — normalize/encode/eq into an arena, then OOM.
fn test_alloc_batch2_fingerprint_arena() {
    var a = arena_allocator(1024);

    var raw = "E3:B0:C4:42:98:FC:1C:14";
    var n = sandhi_fp_normalize_a(a, raw);
    assert_eq(n != 0, 1, "fp_normalize_a into arena");
    assert_streq(n, "e3b0c44298fc1c14", "lowercased + delimiters stripped");

    var bytes[3];
    store8(&bytes + 0, 0xab);
    store8(&bytes + 1, 0xcd);
    store8(&bytes + 2, 0xef);
    var hex = sandhi_fp_encode_bytes_a(a, &bytes, 3);
    assert_streq(hex, "abcdef", "encode_bytes_a into arena");

    assert_eq(sandhi_fp_eq_a(a, "AB:CD:EF", "abcdef"), 1, "fp_eq_a delimiter+case insensitive");
    assert_eq(sandhi_fp_eq_a(a, "abcdef", "abcd00"), 0, "fp_eq_a different fingerprint");

    var failer = fail_after_n_allocs(0);
    assert_eq(sandhi_fp_normalize_a(failer, "abcd"), 0, "normalize_a OOM → 0");
    assert_eq(sandhi_fp_encode_bytes_a(failer, &bytes, 3), 0, "encode_bytes_a OOM → 0");
    return 0;
}

# policy.cyr — combined policy built into an arena and reset.
fn test_alloc_batch2_policy_arena_combine() {
    var a = arena_allocator(2048);

    var pinned = sandhi_tls_policy_new_pinned_a(a, "deadbeef");
    var mtls   = sandhi_tls_policy_new_mtls_a(a, "/cert.pem", "/key.pem");
    assert_eq(pinned != 0, 1, "pinned policy in arena");
    assert_eq(mtls   != 0, 1, "mtls policy in arena");

    var combined = sandhi_tls_policy_combine_a(a, pinned, mtls);
    assert_eq(combined != 0, 1, "combine_a into arena");
    var flags = sandhi_tls_policy_flags(combined);
    assert_eq(flags & SANDHI_TLS_POLICY_PINNED, SANDHI_TLS_POLICY_PINNED, "flags carry pinned");
    assert_eq(flags & SANDHI_TLS_POLICY_MTLS,   SANDHI_TLS_POLICY_MTLS,   "flags carry mtls");
    assert_streq(sandhi_tls_policy_pinned_hash(combined), "deadbeef", "pin survives combine");
    assert_streq(sandhi_tls_policy_mtls_cert(combined),   "/cert.pem", "cert survives combine");

    reset_via(a);
    assert_eq(arena_used(allocator_state(a)), 0, "policy arena reset");

    var failer = fail_after_n_allocs(0);
    assert_eq(sandhi_tls_policy_new_default_a(failer), 0, "default_a OOM → 0");
    return 0;
}

# huffman.cyr — decode_a into an arena. The static decode tree is
# pinned to default_alloc, so resetting the per-call arena does NOT
# break subsequent decodes.
fn test_alloc_batch2_huffman_decode_arena() {
    # RFC 7541 C.4.1 — Huffman("www.example.com") =
    # f1e3 c2e5 f23a 6ba0 ab90 f4ff (12 bytes).
    var enc[12];
    store8(&enc + 0,  0xf1); store8(&enc + 1,  0xe3);
    store8(&enc + 2,  0xc2); store8(&enc + 3,  0xe5);
    store8(&enc + 4,  0xf2); store8(&enc + 5,  0x3a);
    store8(&enc + 6,  0x6b); store8(&enc + 7,  0xa0);
    store8(&enc + 8,  0xab); store8(&enc + 9,  0x90);
    store8(&enc + 10, 0xf4); store8(&enc + 11, 0xff);

    var a = arena_allocator(4096);
    var s = sandhi_hpack_huffman_decode_a(a, &enc, 0, 12);
    assert_streq(s, "www.example.com", "huffman decode_a into arena");

    reset_via(a);
    var s2 = sandhi_hpack_huffman_decode_a(a, &enc, 0, 12);
    assert_streq(s2, "www.example.com", "decode after arena reset (static tree intact)");

    var failer = fail_after_n_allocs(0);
    assert_eq(sandhi_hpack_huffman_decode_a(failer, &enc, 0, 12), 0, "decode_a OOM → 0");
    return 0;
}

# hpack.cyr — table_new_a + decode_field_a into an arena.
fn test_alloc_batch2_hpack_table_arena() {
    var a = arena_allocator(8192);
    var t = sandhi_hpack_table_new_a(a, 4096);
    assert_eq(t != 0, 1, "hpack table_new_a in arena");
    assert_eq(sandhi_hpack_table_count(t), 0, "table starts empty");
    assert_eq(sandhi_hpack_table_max_size(t), 4096, "max_size honored");

    sandhi_hpack_table_add_a(a, t, "x-custom", "value");
    assert_eq(sandhi_hpack_table_count(t), 1, "add_a inserted entry");

    var failer = fail_after_n_allocs(0);
    assert_eq(sandhi_hpack_table_new_a(failer, 4096), 0, "table_new_a OOM → 0");
    return 0;
}

# ================================================================
# Batch 3 — discovery + rpc
# ================================================================

# rpc/json.cyr — build a nested JSON object into an arena, parse a
# response body via dotted-path extraction also routed through the
# arena, then reset to reclaim everything.
fn test_alloc_batch3_json_arena() {
    var a = arena_allocator(8192);
    var inner = sandhi_json_obj_new_a(a);
    sandhi_json_add_string_a(a, inner, "browser", "firefox");
    sandhi_json_add_int_a(a, inner, "w3c", 1);

    var outer = sandhi_json_obj_new_a(a);
    sandhi_json_add_object_a(a, outer, "capabilities", inner);
    sandhi_json_add_bool_a(a, outer, "strict", 1);

    var wire = sandhi_json_build_a(a, outer);
    assert_eq(wire != 0, 1, "json_build_a into arena");
    # Extract from the rendered wire — proves both build + extract
    # round-trip into `a`.
    var got = sandhi_json_get_string_a(a, wire, "capabilities.browser");
    assert_streq(got, "firefox", "nested object string extraction");
    assert_eq(sandhi_json_get_int_a(a, wire, "capabilities.w3c"), 1, "int extraction");
    assert_eq(sandhi_json_has_path_a(a, wire, "missing"), 0, "absent path → 0");

    var used = arena_used(allocator_state(a));
    assert_eq(used > 0, 1, "arena consumed bytes");
    reset_via(a);
    assert_eq(arena_used(allocator_state(a)), 0, "json arena cleared");

    var failer = fail_after_n_allocs(0);
    assert_eq(sandhi_json_get_string_a(failer, "{\"x\":\"y\"}", "x"), 0, "get_string_a OOM → 0");
    return 0;
}

# rpc/dispatch.cyr — wrap a synthetic HTTP response into an rpc-resp
# struct using `_a`. Uses a faked HTTP response built directly via
# _sandhi_resp_new since we don't want a live transport call here.
fn test_alloc_batch3_dispatch_wrap_arena() {
    var a = arena_allocator(4096);

    # Build a JSON-RPC error envelope body.
    var body = "{\"jsonrpc\":\"2.0\",\"error\":{\"code\":42,\"message\":\"boom\"},\"id\":1}";
    var blen = strlen(body);
    var hr = _sandhi_resp_new(200, body, blen, sandhi_headers_new(), SANDHI_OK);
    var rpc = _sandhi_rpc_wrap_a(a, hr, SANDHI_RPC_DIALECT_JSONRPC);
    assert_eq(rpc != 0, 1, "rpc resp built in arena");
    assert_eq(sandhi_rpc_err_kind(rpc), SANDHI_ERR_REMOTE, "json-rpc error envelope detected");
    assert_streq(sandhi_rpc_err_message(rpc), "boom", "error message extracted");
    assert_eq(sandhi_rpc_http_status(rpc), 200, "http status preserved");

    var failer = fail_after_n_allocs(0);
    var rpc_oom = _sandhi_rpc_resp_new_a(failer, 0, 0, 0, 0, 0);
    assert_eq(rpc_oom, 0, "_sandhi_rpc_resp_new_a OOM → 0");
    return 0;
}

# rpc/webdriver.cyr — URL builders into an arena.
fn test_alloc_batch3_webdriver_url_arena() {
    var a = arena_allocator(4096);
    var u1 = _sandhi_wd_join_a(a, "http://drv:4444", "/status");
    assert_streq(u1, "http://drv:4444/status", "_wd_join_a no-trailing");
    var u2 = _sandhi_wd_join_a(a, "http://drv:4444/", "/status");
    assert_streq(u2, "http://drv:4444/status", "_wd_join_a trailing-slash trimmed");

    var u3 = _sandhi_wd_session_url_a(a, "http://drv:4444", "abc123", "/element");
    assert_streq(u3, "http://drv:4444/session/abc123/element", "_wd_session_url_a built");

    var failer = fail_after_n_allocs(0);
    assert_eq(_sandhi_wd_join_a(failer, "http://drv", "/x"), 0, "_wd_join_a OOM → 0");
    return 0;
}

# ================================================================
# Batch 4 — HTTP response/request foundation
# ================================================================

# response.cyr — central response constructor lands the entire
# response (headers, body, struct) in a single arena. Reset reclaims
# everything in one shot — the headline per-request-arena win.
fn test_alloc_batch4_response_parse_arena() {
    var a = arena_allocator(8192);

    var raw = "HTTP/1.1 200 OK\r\nContent-Length: 5\r\nContent-Type: text/plain\r\n\r\nhello";
    var rlen = strlen(raw);

    var resp = sandhi_http_response_parse_a(a, raw, rlen);
    assert_eq(resp != 0, 1, "response parsed into arena");
    assert_eq(sandhi_http_status(resp), 200, "status decoded");
    assert_eq(sandhi_http_body_len(resp), 5, "body len decoded");
    assert_streq(sandhi_http_body(resp), "hello", "body bytes decoded");
    assert_eq(sandhi_http_err_kind(resp), SANDHI_OK, "no err");
    assert_streq(sandhi_headers_get(sandhi_http_headers(resp), "Content-Type"),
      "text/plain", "header surfaced");

    var used = arena_used(allocator_state(a));
    assert_eq(used > 0, 1, "arena consumed bytes for headers + body + struct");
    reset_via(a);
    assert_eq(arena_used(allocator_state(a)), 0, "arena cleared in one shot");

    # Round 2 — same arena, fresh response.
    var resp2 = sandhi_http_response_parse_a(a, raw, rlen);
    assert_eq(sandhi_http_status(resp2), 200, "second parse into reset arena");
    return 0;
}

# response.cyr — chunked decode through the per-request arena.
fn test_alloc_batch4_chunked_arena() {
    var a = arena_allocator(8192);
    var raw = "HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n5\r\nhello\r\n6\r\n world\r\n0\r\n\r\n";
    var rlen = strlen(raw);

    var resp = sandhi_http_response_parse_a(a, raw, rlen);
    assert_eq(sandhi_http_status(resp), 200, "chunked status");
    assert_eq(sandhi_http_body_len(resp), 11, "chunked body len");
    assert_streq(sandhi_http_body(resp), "hello world", "chunked body content");
    return 0;
}

# response.cyr — error responses also flow through `a` (no global-bump
# leak even on parse failure).
fn test_alloc_batch4_resp_err_arena() {
    var a = arena_allocator(2048);
    var resp = sandhi_http_response_parse_a(a, "not http", 8);
    assert_eq(sandhi_http_err_kind(resp), SANDHI_ERR_PROTOCOL, "malformed → PROTOCOL err");
    assert_eq(sandhi_http_status(resp), 0, "status 0 on err");
    assert_eq(sandhi_http_headers(resp) != 0, 1, "headers block always non-null");
    var used = arena_used(allocator_state(a));
    assert_eq(used > 0, 1, "err response was allocated from arena");
    return 0;
}

# response.cyr — OOM. fail_after(0) means even the first alloc fails;
# _resp_new_a returns 0 cleanly. Then the err shortcut also returns 0
# (since headers_new_a fails → _resp_err_a's headers param is 0, but
# _resp_err_a still tries to alloc the resp struct itself — which
# also fails → returns 0).
fn test_alloc_batch4_resp_oom() {
    var failer = fail_after_n_allocs(0);
    var r = _sandhi_resp_new_a(failer, 200, 0, 0, 0, SANDHI_OK);
    assert_eq(r, 0, "_sandhi_resp_new_a returns 0 on OOM");
    var r2 = _sandhi_resp_err_a(failer, SANDHI_ERR_PROTOCOL);
    assert_eq(r2, 0, "_sandhi_resp_err_a returns 0 on OOM");
    return 0;
}

# ================================================================
# Batch 5 — connection layer
# ================================================================

# conn.cyr — as of 1.6.1 _set_timeout_ms_a composes the stdlib
# sock_set_recv_timeout / sock_set_send_timeout setters (Darwin-correct
# SO_*TIMEO opt + struct timeval) instead of building the timeval itself.
# stdlib owns that alloc, so the helper is now arena-INDEPENDENT — it never
# pulls from the passed `a`. This suite audits arena usage, so we assert the
# arena stays untouched on every path. (`a` is retained only for caller-
# signature stability.)
fn test_alloc_batch5_conn_timeout_arena() {
    var a = arena_allocator(2048);
    # ms <= 0 short-circuits returning 0.
    assert_eq(_sandhi_conn_set_timeout_ms_a(a, 0, 0, _SANDHI_SO_RCVTIMEO), 0,
      "ms<=0 returns 0");
    assert_eq(arena_used(allocator_state(a)), 0, "no-op didn't touch arena");

    # ms>0 with fd=-1 — the underlying setsockopt fails, but the helper no
    # longer allocates the timeval from `a`; the arena must stay untouched.
    _sandhi_conn_set_timeout_ms_a(a, 0 - 1, 1000, _SANDHI_SO_RCVTIMEO);
    assert_eq(arena_used(allocator_state(a)), 0,
      "set_timeout_ms_a is arena-independent (composes stdlib sock_set_*_timeout)");
    return 0;
}

# h2/conn.cyr — h2 conn struct + enc/dec hpack tables all land in `a`.
fn test_alloc_batch5_h2_conn_arena() {
    var a = arena_allocator(8192);
    # Underlying sandhi_conn ptr can be 0 — h2_conn_new just stores
    # the value, doesn't dereference.
    var c = sandhi_h2_conn_new_a(a, 0);
    assert_eq(c != 0, 1, "h2_conn_new_a built struct in arena");
    assert_eq(sandhi_h2_conn_underlying(c), 0, "underlying ptr stored");
    assert_eq(sandhi_h2_conn_enc_table(c) != 0, 1, "enc table allocated");
    assert_eq(sandhi_h2_conn_dec_table(c) != 0, 1, "dec table allocated");
    assert_eq(sandhi_h2_conn_peer_max_frame(c), _SANDHI_H2_DEFAULT_PEER_FRAME,
      "default peer max-frame initialized");
    # next_stream_id starts at 1 and bumps by 2.
    assert_eq(sandhi_h2_conn_next_stream_id(c), 1, "first stream id = 1");
    assert_eq(sandhi_h2_conn_next_stream_id(c), 3, "second stream id = 3");

    var failer = fail_after_n_allocs(0);
    assert_eq(sandhi_h2_conn_new_a(failer, 0), 0, "h2_conn_new_a OOM → 0");
    return 0;
}

# resolve.cyr — _name_eq_a's 8 transient cells round-trip into `a`.
# Build two compressed-name buffers and compare.
fn test_alloc_batch5_resolve_name_eq_arena() {
    var a = arena_allocator(4096);

    # Build a tiny DNS-like buf with two names to compare. Layout:
    # offset 0: "example.com" labels = 07 e x a m p l e 03 c o m 00
    # offset 13: same again
    # offset 26: "EXAMPLE.com" — case-different
    var buf[39];
    var labels = "\x07example\x03com\x00\x07example\x03com\x00\x07EXAMPLE\x03com\x00";
    var i = 0;
    while (i < 39) { store8(&buf + i, load8(labels + i)); i = i + 1; }

    assert_eq(_sandhi_resolve_name_eq_a(a, &buf, 39, 0, 13), 1,
      "identical names compare equal");
    assert_eq(_sandhi_resolve_name_eq_a(a, &buf, 39, 0, 26), 1,
      "case-insensitive equal");

    var used = arena_used(allocator_state(a));
    assert_eq(used > 0, 1, "name_eq scratch landed in arena");

    reset_via(a);
    assert_eq(arena_used(allocator_state(a)), 0, "arena reset reclaimed scratch");

    # Round 2 — same arena.
    assert_eq(_sandhi_resolve_name_eq_a(a, &buf, 39, 0, 13), 1, "round 2 still works");
    return 0;
}

# ================================================================
# Batch 6 — client + streaming + server
# ================================================================

# client.cyr / retry.cyr — options + retry struct in arena.
fn test_alloc_batch6_options_arena() {
    var a = arena_allocator(2048);
    var opts = sandhi_http_options_new_a(a);
    assert_eq(opts != 0, 1, "options_new_a");
    assert_eq(sandhi_http_options_bytes(opts), SANDHI_HTTP_DEFAULT_MAX_BYTES, "default max bytes");
    sandhi_http_options_max_hops(opts, 7);
    assert_eq(sandhi_http_options_hops(opts), 7, "max_hops setter survives");

    var retry = sandhi_retry_new_a(a);
    assert_eq(retry != 0, 1, "retry_new_a");
    assert_eq(_sandhi_retry_attempts(retry), SANDHI_RETRY_DEFAULT_ATTEMPTS, "default attempts");

    var failer = fail_after_n_allocs(0);
    assert_eq(sandhi_http_options_new_a(failer), 0, "options_new_a OOM → 0");
    assert_eq(sandhi_retry_new_a(failer), 0, "retry_new_a OOM → 0");
    return 0;
}

# server/mod.cyr — request parsing helpers all flow through `a`.
fn test_alloc_batch6_server_parse_arena() {
    var a = arena_allocator(4096);
    var req = "GET /api/users?id=42 HTTP/1.1\r\nHost: example.com\r\nUser-Agent: probe\r\n\r\n";
    var rlen = strlen(req);

    var method = sandhi_server_get_method_a(a, req, rlen);
    assert_streq(method, "GET", "method extracted");
    var path = sandhi_server_get_path_a(a, req, rlen);
    assert_streq(path, "/api/users?id=42", "path extracted");
    var ua = sandhi_server_find_header_a(a, req, rlen, "User-Agent");
    assert_streq(ua, "probe", "header extracted");
    var bare = sandhi_server_path_only_a(a, path);
    assert_streq(bare, "/api/users", "path_only stripped query");
    var id = sandhi_server_get_param_a(a, path, "id");
    assert_streq(id, "42", "query param extracted");
    var seg = sandhi_server_path_segment_a(a, path, 1);
    assert_streq(seg, "users", "path segment extracted");

    var used = arena_used(allocator_state(a));
    assert_eq(used > 0, 1, "all helpers landed in arena");
    reset_via(a);
    assert_eq(arena_used(allocator_state(a)), 0, "arena cleared in one shot");

    var failer = fail_after_n_allocs(0);
    assert_eq(sandhi_server_get_method_a(failer, req, rlen), 0, "get_method_a OOM → 0");
    return 0;
}

# sse.cyr — full SSE parse round-trip into arena.
fn test_alloc_batch6_sse_parse_arena() {
    var a = arena_allocator(4096);
    var stream = "event: tick\ndata: hello\ndata: world\nid: 7\n\n";
    var slen = strlen(stream);

    var rem_cell = alloc_via(a, 8);
    var events = sandhi_sse_parse_a(a, stream, slen, rem_cell);
    assert_eq(events != 0, 1, "events vec allocated");
    assert_eq(vec_len(events), 1, "one event parsed");
    var ev = vec_get(events, 0);
    assert_streq(sandhi_sse_event_name(ev), "tick", "event name");
    assert_streq(sandhi_sse_event_data(ev), "hello\nworld", "data lines joined");
    assert_streq(sandhi_sse_event_id(ev), "7", "id captured");

    reset_via(a);
    assert_eq(arena_used(allocator_state(a)), 0, "sse parse arena cleared");

    var failer = fail_after_n_allocs(0);
    assert_eq(_sandhi_sse_dup_a(failer, "x"), 0, "_sse_dup_a OOM → 0");
    return 0;
}

# stream.cyr — _stream_result_a / _sb_new_a / _chunk_state_new_a OOM.
fn test_alloc_batch6_stream_result_oom() {
    var failer = fail_after_n_allocs(0);
    assert_eq(_sandhi_stream_result_a(failer, 0, 0, 0, 0), 0, "stream_result_a OOM → 0");
    assert_eq(_sandhi_sb_new_a(failer, 1024), 0, "sb_new_a OOM → 0");
    assert_eq(_sandhi_chunk_state_new_a(failer), 0, "chunk_state_new_a OOM → 0");
    return 0;
}

# resolve.cyr — OOM on resolv.conf read returns -1 cleanly.
fn test_alloc_batch5_resolve_oom() {
    var failer = fail_after_n_allocs(0);
    assert_eq(_sandhi_resolve_read_resolv_conf_a(failer), 0 - 1,
      "resolv.conf read OOM → -1");
    # name_eq with failing alloc → returns 0 (not equal) without
    # crashing.
    var buf[2];
    store8(&buf, 0); store8(&buf + 1, 0);
    assert_eq(_sandhi_resolve_name_eq_a(failer, &buf, 2, 0, 1), 0,
      "name_eq_a OOM → 0");
    return 0;
}

# resolve.cyr — the DNS TXID fails CLOSED (cyrius's entropy-fallback
# hardening item). When getrandom yields fewer than 2 bytes there is no
# TXID and no query: the old clock-ns fallback made the TXID predictable.
# Both resolvers must refuse
# before reading resolv.conf, allocating or opening a socket — an arena
# that stays at 0 bytes proves nothing past the guard ran.
fn test_alloc_batch5_resolve_txid_fail_closed() {
    var buf[2];
    store8(&buf, 0xAB); store8(&buf + 1, 0xCD);
    assert_eq(_sandhi_resolve_txid_from(2, &buf), 0xABCD,
      "txid_from: 2 random bytes -> their u16");
    assert_eq(_sandhi_resolve_txid_from(0, &buf), 0 - 1,
      "txid_from: getrandom read 0 bytes -> -1, never a clock value");
    assert_eq(_sandhi_resolve_txid_from(1, &buf), 0 - 1,
      "txid_from: a 1-byte short read -> -1");
    assert_eq(_sandhi_resolve_txid_from(0 - 38, &buf), 0 - 1,
      "txid_from: a -errno (ENOSYS) -> -1");
    var a = arena_allocator(4096);
    assert_eq(_sandhi_resolve_ipv4_query_a(a, "example.com", 0 - 1), 0 - 1,
      "ipv4 query with no TXID -> -1");
    assert_eq(arena_used(allocator_state(a)), 0,
      "ipv4: refused before resolv.conf / query alloc");
    assert_eq(_sandhi_resolve_ipv6_query_a(a, "example.com", 0 - 1), 0,
      "ipv6 query with no TXID -> 0");
    assert_eq(arena_used(allocator_state(a)), 0,
      "ipv6: refused before resolv.conf / query alloc");
    var r = _sandhi_resolve_random_u16();
    assert_eq(r >= 0, 1, "random_u16 on a working CSPRNG -> a TXID");
    assert_eq(r <= 0xFFFF, 1, "random_u16 is a u16");
    return 0;
}

# discovery/local.cyr — ctx-bound allocator + qname round-trip.
fn test_alloc_batch3_local_arena() {
    var a = arena_allocator(2048);

    var qn = _sandhi_local_qname_a(a, "printer");
    assert_streq(qn, "printer.local", "qname appends .local");
    var qn2 = _sandhi_local_qname_a(a, "host.local");
    assert_streq(qn2, "host.local", "qname passthrough on .local suffix");

    # Resolver wrapper carries the allocator handle on its ctx.
    var r = sandhi_discovery_local_resolver_a(a);
    assert_eq(r != 0, 1, "local_resolver_a built");
    assert_eq(sandhi_resolver_fn(r) == &_sandhi_local_lookup, 1, "fn ptr wired");
    var ctx = sandhi_resolver_ctx(r);
    assert_eq(ctx != 0, 1, "resolver ctx allocated");
    assert_eq(load64(ctx) == a, 1, "ctx +0 carries allocator handle");

    var failer = fail_after_n_allocs(0);
    assert_eq(_sandhi_local_qname_a(failer, "printer"), 0, "qname_a OOM → 0");
    return 0;
}

# ================================================================
# 1.2.0 — Batch A: orchestrator allocator review
# ================================================================
# Audit-pass tests for the request-orchestrator layer
# (`_sandhi_http_do` / `_do_impl` / `_dispatch` / `_exchange` /
# `_exchange_keepalive` / `_sandhi_client_build_request`). The 1.1.0
# leaf-level migration was clean (no `_a` fn called a bare paired
# version), but the orchestrators above the leaves had no `_a`
# variants — every consumer call to `sandhi_http_get` etc. went
# through `default_alloc()` for the entire request path, bypassing
# any per-request arena even when leaves like `sandhi_url_parse_a`
# would have honored it. Batch A adds `_a` variants for the four
# orchestrators + the request builder. Follow / retry / h2 auto /
# top-level public verbs land in 1.2.1+.

# build_request — arena round-trip. The pre-1.2.0 `_a` variant
# silently dropped `a` and routed every str_builder op through
# default_alloc(); the new `_va` impl threads `a` correctly.
fn test_alloc_120a_build_request_arena() {
    var a = arena_allocator(4096);

    var req = _sandhi_client_build_request_a(a, "GET", "/probe", "example.com", 0, 0);
    assert_eq(req != 0, 1, "build_request_a returned a Str");
    var s = str_data(req);
    # Wire format must include the auto-injected Host: example.com line.
    var has_host = 0;
    var i = 0;
    while (i + 17 < strlen(s)) {
        if (load8(s + i) == 72 && load8(s + i + 1) == 111 && load8(s + i + 2) == 115
          && load8(s + i + 3) == 116 && load8(s + i + 4) == 58 && load8(s + i + 5) == 32) {
            has_host = 1;
        }
        i = i + 1;
    }
    assert_eq(has_host, 1, "auto-injected Host: line present in arena-built request");

    var used_after_first = arena_used(allocator_state(a));
    assert_eq(used_after_first > 0, 1, "arena consumed by build_request_a");

    reset_via(a);
    assert_eq(arena_used(allocator_state(a)), 0, "reset_via clears arena");

    # Second build into the reset arena succeeds; previous req's
    # Str struct + str_builder + cstrings all reclaimed.
    var req2 = _sandhi_client_build_request_a(a, "POST", "/api", "api.example.com", 0, 42);
    assert_eq(req2 != 0, 1, "build #2 into reset arena succeeded");
    return 0;
}

# build_request — full variadic with keep_alive flag.
fn test_alloc_120a_build_request_va_keepalive() {
    var a = arena_allocator(4096);
    var req = _sandhi_client_build_request_va(a, "GET", "/", "example.com", 0, 0, 1);
    assert_eq(req != 0, 1, "build_request_va keep_alive=1 succeeded");
    # keep_alive=1 must NOT emit "Connection: close".
    var s = str_data(req);
    var has_close = 0;
    var i = 0;
    while (i + 17 < strlen(s)) {
        if (load8(s + i) == 67 && load8(s + i + 1) == 111 && load8(s + i + 2) == 110
          && load8(s + i + 3) == 110 && load8(s + i + 4) == 101 && load8(s + i + 5) == 99
          && load8(s + i + 6) == 116 && load8(s + i + 7) == 105 && load8(s + i + 8) == 111
          && load8(s + i + 9) == 110 && load8(s + i + 10) == 58 && load8(s + i + 11) == 32
          && load8(s + i + 12) == 99 && load8(s + i + 13) == 108 && load8(s + i + 14) == 111
          && load8(s + i + 15) == 115 && load8(s + i + 16) == 101) {
            has_close = 1;
        }
        i = i + 1;
    }
    assert_eq(has_close, 0, "keep_alive=1 omits Connection: close");
    return 0;
}

# dispatch_a — error-path response is allocated in the arena.
# Drive `_sandhi_http_dispatch_a` against an unparseable URL: every
# alloc until the err-resp construction lands in the arena, which
# `reset_via` should reclaim cleanly.
fn test_alloc_120a_dispatch_err_resp_arena() {
    var a = arena_allocator(4096);
    var opts = sandhi_http_options_new_a(a);
    var resp = _sandhi_http_dispatch_a(a, "GET", "not-a-valid-url", 0, 0, 0, opts);
    assert_eq(resp != 0, 1, "dispatch_a err-resp constructed");
    assert_eq(sandhi_http_err_kind(resp), SANDHI_ERR_PARSE,
      "URL parse fail → SANDHI_ERR_PARSE");

    var used = arena_used(allocator_state(a));
    assert_eq(used > 0, 1, "arena bytes consumed by err-resp construction");

    reset_via(a);
    assert_eq(arena_used(allocator_state(a)), 0,
      "reset_via reclaims the err-resp arena allocations");
    return 0;
}

# build_request — OOM via fail_after_n_allocs returns gracefully.
# The first alloc is `str_builder_new_a` (the builder header itself).
fn test_alloc_120a_build_request_oom() {
    var a = fail_after_n_allocs(0);
    var req = _sandhi_client_build_request_a(a, "GET", "/", "example.com", 0, 0);
    # str_builder_new_a returns 0 on OOM; subsequent str_builder_add_*
    # ops are no-ops on a 0 builder; str_builder_build_a returns 0
    # when sb is 0.
    assert_eq(req, 0, "OOM at first alloc → build returns 0 cleanly (no abort)");
    return 0;
}

# ================================================================
# 1.2.1 — Batch B+C: redirect / retry / auto-dispatch path
# ================================================================
# Closes the partial-arena leak 1.2.0 left on `follow=1` and the
# auto-dispatch / retry paths. `_a` variants now exist for
# `_sandhi_http_follow`, `_sandhi_http_auto_once`,
# `_sandhi_http_auto_follow`, `sandhi_http_request_auto`,
# `_sandhi_http_retry`, `_sandhi_http_try_h2_promote`, and
# `_sandhi_strip_sensitive_headers`. Bare versions stay as
# back-compat wrappers passing `default_alloc()`.

# strip_sensitive_headers — arena alloc + reset.
fn test_alloc_121bc_strip_sensitive_arena() {
    var a = arena_allocator(2048);
    var src = sandhi_headers_new_a(a);
    sandhi_headers_set_a(a, src, "Authorization", "Bearer xyz");
    sandhi_headers_set_a(a, src, "X-Trace", "ok");
    sandhi_headers_set_a(a, src, "Cookie", "sid=abc");

    var stripped = _sandhi_strip_sensitive_headers_a(a, src);
    assert_eq(stripped != 0, 1, "strip returns a fresh block");
    assert_eq(sandhi_headers_count(stripped), 1, "only X-Trace survives");
    assert_eq(sandhi_headers_get(stripped, "Authorization"), 0, "Authorization stripped");
    assert_eq(sandhi_headers_get(stripped, "Cookie"), 0, "Cookie stripped");
    assert_streq(sandhi_headers_get(stripped, "X-Trace"), "ok", "X-Trace passes");

    var used = arena_used(allocator_state(a));
    assert_eq(used > 0, 1, "arena consumed");
    reset_via(a);
    assert_eq(arena_used(allocator_state(a)), 0, "arena reset");
    return 0;
}

# strip_sensitive_headers — OOM on the new headers block returns 0
# cleanly without crashing on the subsequent add_a calls.
fn test_alloc_121bc_strip_sensitive_oom() {
    var a = arena_allocator(2048);
    var src = sandhi_headers_new_a(a);
    sandhi_headers_set_a(a, src, "X-Trace", "ok");

    var failer = fail_after_n_allocs(0);
    var stripped = _sandhi_strip_sensitive_headers_a(failer, src);
    assert_eq(stripped, 0, "OOM at fresh-block alloc → returns 0");
    return 0;
}

# follow_a — driver-level err-resp goes into the arena. Drive against
# an unparseable URL (no Location header to follow) so we exercise the
# arena-bound `_do_a` call inside follow_a and the err-resp it builds.
# Trailing `0` is the 1.6.9 per-call request context — ctx==0 means "no
# per-call context" (the reqctx helpers fall back to the module globals),
# the same spelling `_sandhi_http_follow` uses.
fn test_alloc_121bc_follow_err_resp_arena() {
    var a = arena_allocator(4096);
    var resp = _sandhi_http_follow_a(a, "GET", "not-a-valid-url", 0, 0, 0,
      5, 0, 0, 0, 0, 0, 0, 0);
    assert_eq(resp != 0, 1, "follow_a constructed err-resp");
    assert_eq(sandhi_http_err_kind(resp), SANDHI_ERR_PARSE, "URL parse fail");
    var used = arena_used(allocator_state(a));
    assert_eq(used > 0, 1, "arena consumed by follow_a path");
    reset_via(a);
    assert_eq(arena_used(allocator_state(a)), 0, "arena reset");
    return 0;
}

# auto_once_a — pool=0 (no pool) path falls through to _do_a; with an
# unparseable URL we exercise the err-resp construction.
fn test_alloc_121bc_auto_once_err_resp_arena() {
    var a = arena_allocator(4096);
    var opts = sandhi_http_options_new_a(a);
    var resp = _sandhi_http_auto_once_a(a, "GET", "not-a-valid-url", 0, 0, 0, opts, 0);
    assert_eq(resp != 0, 1, "auto_once_a constructed err-resp");
    assert_eq(sandhi_http_err_kind(resp), SANDHI_ERR_PARSE, "URL parse fail");
    return 0;
}

# request_auto_a — opts with follow=0 routes through auto_once_a;
# arena threads end-to-end.
fn test_alloc_121bc_request_auto_arena() {
    var a = arena_allocator(4096);
    var opts = sandhi_http_options_new_a(a);
    var resp = sandhi_http_request_auto_a(a, "GET", "garbage://x", 0, 0, 0, opts);
    assert_eq(resp != 0, 1, "request_auto_a built err-resp");
    assert_eq(sandhi_http_err_kind(resp), SANDHI_ERR_PARSE, "URL parse fail");
    var used = arena_used(allocator_state(a));
    assert_eq(used > 0, 1, "arena consumed");
    reset_via(a);
    assert_eq(arena_used(allocator_state(a)), 0, "arena reset reclaims");
    return 0;
}

# retry_a — single attempt against a failing URL (PARSE is non-
# retryable per `_sandhi_retry_should_retry`, so the loop returns
# immediately after the first attempt). Arena threads through.
fn test_alloc_121bc_retry_non_retryable_arena() {
    var a = arena_allocator(4096);
    var opts = sandhi_http_options_new_a(a);
    var policy = sandhi_retry_new_a(a);
    var resp = _sandhi_http_retry_a(a, "GET", "garbage://x", 0, 0, 0, opts, policy);
    assert_eq(resp != 0, 1, "retry_a returned a response");
    assert_eq(sandhi_http_err_kind(resp), SANDHI_ERR_PARSE,
      "PARSE is non-retryable; first attempt returned");
    return 0;
}

# ================================================================
# 1.2.2 — Batch D: top-level public verbs `_a`
# ================================================================
# First slot with consumer-visible end-to-end arena adoption.
# Internal cascade is fully `_a`-threaded post-1.2.1; this batch
# just adds the public-verb wrappers (`sandhi_http_get_a` /
# `_post_a` / `_put_a` / `_patch_a` / `_delete_a` / `_head_a`).
# Bare versions stay as back-compat wrappers passing
# `default_alloc()`.

# get_a — drives an unparseable URL so the err-resp path lands
# entirely in the arena (URL parse → resolve → conn-open path
# never reached, but the err-resp construction does allocate
# from the arena via `_sandhi_resp_err_a`).
fn test_alloc_122d_get_arena() {
    var a = arena_allocator(4096);
    var resp = sandhi_http_get_a(a, "garbage://x", 0);
    assert_eq(resp != 0, 1, "get_a returned a response");
    assert_eq(sandhi_http_err_kind(resp), SANDHI_ERR_PARSE, "PARSE err");
    var used = arena_used(allocator_state(a));
    assert_eq(used > 0, 1, "arena consumed by get_a path");
    reset_via(a);
    assert_eq(arena_used(allocator_state(a)), 0, "reset reclaims");
    return 0;
}

# post_a — body-bearing variant; same shape as get_a but with
# body+body_len threaded through the `_a` chain.
fn test_alloc_122d_post_arena() {
    var a = arena_allocator(4096);
    var body = "hello";
    var resp = sandhi_http_post_a(a, "garbage://x", 0, body, 5);
    assert_eq(resp != 0, 1, "post_a returned a response");
    assert_eq(sandhi_http_err_kind(resp), SANDHI_ERR_PARSE, "PARSE err");
    return 0;
}

# delete_a / head_a — body-less variants share the same path
# shape as get_a (no body args). Both must thread `a` cleanly.
fn test_alloc_122d_delete_head_arena() {
    var a = arena_allocator(4096);
    var r1 = sandhi_http_delete_a(a, "garbage://x", 0);
    assert_eq(sandhi_http_err_kind(r1), SANDHI_ERR_PARSE, "delete_a PARSE err");
    var r2 = sandhi_http_head_a(a, "garbage://x", 0);
    assert_eq(sandhi_http_err_kind(r2), SANDHI_ERR_PARSE, "head_a PARSE err");
    return 0;
}

# put_a / patch_a — body-bearing variants symmetric to post_a.
fn test_alloc_122d_put_patch_arena() {
    var a = arena_allocator(4096);
    var body = "x";
    var r1 = sandhi_http_put_a(a, "garbage://x", 0, body, 1);
    assert_eq(sandhi_http_err_kind(r1), SANDHI_ERR_PARSE, "put_a PARSE err");
    var r2 = sandhi_http_patch_a(a, "garbage://x", 0, body, 1);
    assert_eq(sandhi_http_err_kind(r2), SANDHI_ERR_PARSE, "patch_a PARSE err");
    return 0;
}

# Round-trip across reset — multiple back-to-back calls into the
# same arena, confirming `reset_via` between them gives a fresh
# slate without leaking response memory.
fn test_alloc_122d_get_arena_round_trip() {
    var a = arena_allocator(4096);
    var r1 = sandhi_http_get_a(a, "garbage://1", 0);
    assert_eq(r1 != 0, 1, "first get_a");
    var first_used = arena_used(allocator_state(a));
    reset_via(a);
    var r2 = sandhi_http_get_a(a, "garbage://2", 0);
    assert_eq(r2 != 0, 1, "second get_a after reset");
    assert_eq(first_used > 0, 1, "first call did consume arena");
    return 0;
}

# ================================================================
# 1.2.3 — Batch E: opts / retry / auto user-facing `_a`
# ================================================================
# Paint-on-top wrappers since 1.2.0–1.2.2 already threaded the
# underlying dispatch / retry / auto paths. Each test exercises
# the per-method `_a` against an unparseable URL so the err-resp
# allocates entirely in the arena and reset reclaims cleanly.

# _opts variants — paint on `_sandhi_http_dispatch_a`.
fn test_alloc_123e_opts_arena() {
    var a = arena_allocator(4096);
    var opts = sandhi_http_options_new_a(a);

    var r1 = sandhi_http_get_opts_a(a, "garbage://x", 0, opts);
    assert_eq(sandhi_http_err_kind(r1), SANDHI_ERR_PARSE, "get_opts_a PARSE err");

    var body = "x";
    var r2 = sandhi_http_post_opts_a(a, "garbage://x", 0, body, 1, opts);
    assert_eq(sandhi_http_err_kind(r2), SANDHI_ERR_PARSE, "post_opts_a PARSE err");

    var used = arena_used(allocator_state(a));
    assert_eq(used > 0, 1, "arena consumed");
    reset_via(a);
    assert_eq(arena_used(allocator_state(a)), 0, "reset reclaims");
    return 0;
}

# _retry variants — paint on `_sandhi_http_retry_a`. PARSE is
# non-retryable so each returns after one attempt.
fn test_alloc_123e_retry_arena() {
    var a = arena_allocator(4096);
    var opts = sandhi_http_options_new_a(a);
    var policy = sandhi_retry_new_a(a);

    var r1 = sandhi_http_get_retry_a(a, "garbage://x", 0, opts, policy);
    assert_eq(sandhi_http_err_kind(r1), SANDHI_ERR_PARSE, "get_retry_a PARSE err");
    var r2 = sandhi_http_head_retry_a(a, "garbage://x", 0, opts, policy);
    assert_eq(sandhi_http_err_kind(r2), SANDHI_ERR_PARSE, "head_retry_a PARSE err");
    var body = "x";
    var r3 = sandhi_http_put_retry_a(a, "garbage://x", 0, body, 1, opts, policy);
    assert_eq(sandhi_http_err_kind(r3), SANDHI_ERR_PARSE, "put_retry_a PARSE err");
    var r4 = sandhi_http_delete_retry_a(a, "garbage://x", 0, opts, policy);
    assert_eq(sandhi_http_err_kind(r4), SANDHI_ERR_PARSE, "delete_retry_a PARSE err");
    return 0;
}

# _auto variants — paint on `sandhi_http_request_auto_a`. No
# pool attached so the path falls through to `_sandhi_http_do_a`
# (just like the test for `auto_once_err_resp_arena` at 1.2.1).
fn test_alloc_123e_auto_body_less_arena() {
    var a = arena_allocator(4096);
    var opts = sandhi_http_options_new_a(a);

    var r1 = sandhi_http_get_auto_a(a, "garbage://x", 0, opts);
    assert_eq(sandhi_http_err_kind(r1), SANDHI_ERR_PARSE, "get_auto_a PARSE err");
    var r2 = sandhi_http_head_auto_a(a, "garbage://x", 0, opts);
    assert_eq(sandhi_http_err_kind(r2), SANDHI_ERR_PARSE, "head_auto_a PARSE err");
    var r3 = sandhi_http_delete_auto_a(a, "garbage://x", 0, opts);
    assert_eq(sandhi_http_err_kind(r3), SANDHI_ERR_PARSE, "delete_auto_a PARSE err");
    return 0;
}

fn test_alloc_123e_auto_body_bearing_arena() {
    var a = arena_allocator(4096);
    var opts = sandhi_http_options_new_a(a);
    var body = "x";

    var r1 = sandhi_http_post_auto_a(a, "garbage://x", 0, body, 1, opts);
    assert_eq(sandhi_http_err_kind(r1), SANDHI_ERR_PARSE, "post_auto_a PARSE err");
    var r2 = sandhi_http_put_auto_a(a, "garbage://x", 0, body, 1, opts);
    assert_eq(sandhi_http_err_kind(r2), SANDHI_ERR_PARSE, "put_auto_a PARSE err");
    var r3 = sandhi_http_patch_auto_a(a, "garbage://x", 0, body, 1, opts);
    assert_eq(sandhi_http_err_kind(r3), SANDHI_ERR_PARSE, "patch_auto_a PARSE err");
    return 0;
}

# ================================================================
# 1.2.4 — Batch F: RPC dialect `_a` (closes the optimization arc)
# ================================================================
# Paint-on-top wrappers atop `sandhi_rpc_call_a` (paired since
# 1.1.0). Each `_a` threads `a` through URL build, JSON envelope
# build, and the underlying RPC dispatch. Since the dialect verbs
# don't have a clean "garbage URL → arena err-resp" path the way
# the http verbs do (they call `sandhi_rpc_call` which goes
# through `_sandhi_http_dispatch` with a non-arena-aware error
# path under garbage URLs), the tests here focus on the JSON
# envelope build threading: `_sandhi_mcp_build_request_a` is the
# canonical case — it calls every json_*_a helper.

# mcp build_request — the dialect's body-builder threads `a`
# through every json_*_a primitive. Verifies the helper
# produces a non-empty JSON-RPC envelope and the arena consumes
# the bytes (and reset reclaims).
fn test_alloc_124f_mcp_build_request_arena() {
    var a = arena_allocator(2048);
    var body = _sandhi_mcp_build_request_a(a, "tools/list", 0);
    assert_eq(body != 0, 1, "mcp build_request_a non-zero");
    # Sanity check: result is a JSON-RPC envelope starting with `{`.
    assert_eq(load8(body) == 123, 1, "envelope starts with '{'");

    var used = arena_used(allocator_state(a));
    assert_eq(used > 0, 1, "arena consumed");
    reset_via(a);
    assert_eq(arena_used(allocator_state(a)), 0, "reset reclaims");
    return 0;
}

# mcp build_request with params — same path with the
# json_add_raw_a branch exercised.
fn test_alloc_124f_mcp_build_request_with_params_arena() {
    var a = arena_allocator(2048);
    var body = _sandhi_mcp_build_request_a(a, "tools/call",
      "{\"name\":\"echo\"}");
    assert_eq(body != 0, 1, "mcp build_request_a with params non-zero");
    return 0;
}

# wd helpers — `_sandhi_wd_build_path_a` and
# `_sandhi_wd_build_element_suffix_a` are the path-construction
# leaves used by extract_element_id_a and the element_*_a verbs.
fn test_alloc_124f_wd_build_helpers_arena() {
    var a = arena_allocator(1024);
    var path = _sandhi_wd_build_path_a(a, "value.", "elem-1");
    assert_streq(path, "value.elem-1", "build_path_a concat");
    var suffix = _sandhi_wd_build_element_suffix_a(a, "abc", "/click");
    assert_streq(suffix, "/element/abc/click", "build_element_suffix_a concat");
    var used = arena_used(allocator_state(a));
    assert_eq(used > 0, 1, "arena consumed");
    return 0;
}

# wd join helper round-trip — the URL builder used by every
# webdriver `_a` verb.
fn test_alloc_124f_wd_join_arena() {
    var a = arena_allocator(1024);
    var url = _sandhi_wd_join_a(a, "http://wd.local:4444", "/session");
    assert_streq(url, "http://wd.local:4444/session", "join_a concat");
    var sess_url = _sandhi_wd_session_url_a(a, "http://wd.local:4444",
      "abc-123", "/url");
    assert_streq(sess_url, "http://wd.local:4444/session/abc-123/url",
      "session_url_a concat");
    return 0;
}

# ================================================================
# 1.2.5 — profile instrumentation
# ================================================================
# `src/obs/prof.cyr` adds per-request per-phase timing captures and
# recv-buffer cap/used tracking. Default-off; runtime toggle via
# `sandhi_prof_enable(1)`. Captures fire inside `_sandhi_http_do_impl_a`
# at five phase boundaries: URL_PARSE_END, DNS_END, CONN_OPEN_END,
# REQ_BUILD_END, EXCHANGE_END.

# Disabled-by-default — every capture is a no-op and `sandhi_prof_get`
# returns 0.
fn test_alloc_125_prof_disabled_default() {
    assert_eq(sandhi_prof_enabled(), 0, "default disabled");
    sandhi_prof_capture(SANDHI_PROF_PHASE_URL_PARSE_END);
    assert_eq(sandhi_prof_get(SANDHI_PROF_PHASE_URL_PARSE_END), 0,
      "disabled capture returns 0");
    return 0;
}

# Enable + capture + read back. The captures must be monotonic
# non-negative (each phase happens-after the previous).
fn test_alloc_125_prof_capture_monotonic() {
    sandhi_prof_enable(1);
    sandhi_prof_reset();
    # Drive a sequence of captures with small busy-loops between
    # so each phase has measurable elapsed-ns. (Empty captures back-
    # to-back can collapse to 0 ns on fast systems if clock_now_ns
    # has coarse resolution.)
    var i = 0;
    while (i < 1000) { i = i + 1; }
    sandhi_prof_capture(SANDHI_PROF_PHASE_URL_PARSE_END);
    while (i < 2000) { i = i + 1; }
    sandhi_prof_capture(SANDHI_PROF_PHASE_DNS_END);
    while (i < 3000) { i = i + 1; }
    sandhi_prof_capture(SANDHI_PROF_PHASE_CONN_OPEN_END);
    while (i < 4000) { i = i + 1; }
    sandhi_prof_capture(SANDHI_PROF_PHASE_REQ_BUILD_END);
    while (i < 5000) { i = i + 1; }
    sandhi_prof_capture(SANDHI_PROF_PHASE_EXCHANGE_END);

    var t1 = sandhi_prof_get(SANDHI_PROF_PHASE_URL_PARSE_END);
    var t2 = sandhi_prof_get(SANDHI_PROF_PHASE_DNS_END);
    var t3 = sandhi_prof_get(SANDHI_PROF_PHASE_CONN_OPEN_END);
    var t4 = sandhi_prof_get(SANDHI_PROF_PHASE_REQ_BUILD_END);
    var t5 = sandhi_prof_get(SANDHI_PROF_PHASE_EXCHANGE_END);

    assert_eq(t1 >= 0, 1, "url_parse_end >= 0");
    assert_eq(t2 >= t1, 1, "dns_end >= url_parse_end (monotonic)");
    assert_eq(t3 >= t2, 1, "conn_open_end >= dns_end");
    assert_eq(t4 >= t3, 1, "req_build_end >= conn_open_end");
    assert_eq(t5 >= t4, 1, "exchange_end >= req_build_end");

    sandhi_prof_enable(0);
    return 0;
}

# Reset zeros all captures back to baseline.
fn test_alloc_125_prof_reset_clears() {
    sandhi_prof_enable(1);
    sandhi_prof_reset();
    var j = 0;
    while (j < 1000) { j = j + 1; }
    sandhi_prof_capture(SANDHI_PROF_PHASE_EXCHANGE_END);
    var t = sandhi_prof_get(SANDHI_PROF_PHASE_EXCHANGE_END);
    assert_eq(t >= 0, 1, "after capture, get returns elapsed");

    # Reset; immediately reading a phase that wasn't re-captured
    # returns 0 elapsed (capture timestamp == start timestamp).
    sandhi_prof_reset();
    assert_eq(sandhi_prof_get(SANDHI_PROF_PHASE_EXCHANGE_END), 0,
      "post-reset, uncaptured phase reads 0");

    sandhi_prof_enable(0);
    return 0;
}

# Recv-buffer record: cap and used round-trip while enabled.
fn test_alloc_125_prof_recv_buf() {
    sandhi_prof_enable(1);
    sandhi_prof_reset();
    sandhi_prof_record_recv(262144, 532);
    assert_eq(sandhi_prof_recv_cap(), 262144, "cap recorded");
    assert_eq(sandhi_prof_recv_used(), 532, "used recorded");

    # Disabled: record is a no-op (existing values stay).
    sandhi_prof_enable(0);
    sandhi_prof_record_recv(99999, 99999);
    assert_eq(sandhi_prof_recv_cap(), 262144, "disabled record is no-op");
    return 0;
}

# End-to-end: enable, drive a request through the public verb, read
# back captures. Use a garbage URL so the path returns at PARSE
# without doing real I/O — only the URL_PARSE phase actually fires
# in this case (subsequent phases get the same baseline timestamp).
fn test_alloc_125_prof_real_request_arena() {
    sandhi_prof_enable(1);
    var a = arena_allocator(4096);
    var resp = sandhi_http_get_a(a, "garbage://x", 0);
    assert_eq(sandhi_http_err_kind(resp), SANDHI_ERR_PARSE, "PARSE err");

    # URL_PARSE captured before the early-return for a parse failure.
    var url_ns = sandhi_prof_get(SANDHI_PROF_PHASE_URL_PARSE_END);
    assert_eq(url_ns >= 0, 1, "url_parse phase captured");
    sandhi_prof_enable(0);
    return 0;
}

# ================================================================
# 1.2.6 — OOM-guard audit on 1.2.0–1.2.4 `_a` additions
# ================================================================
# During 1.2.0 dev, the OOM regression test for
# `_sandhi_client_build_request_va` caught a SIGSEGV — when
# `str_builder_new_a` returned 0, the next `str_builder_add_cstr_a`
# dereferenced null. The fix was a single guard. This audit walked
# every `_a` variant added 1.2.0–1.2.4 looking for the same pattern
# and found two systemic gaps:
#   Pattern A — `alloc_via` for recv buffer in
#     `_sandhi_http_exchange_a` and `_keepalive_a`. Without the
#     guard, `sandhi_conn_recv_all_deadline(conn, rbuf=0, ...)`
#     writes to address 0 → SIGSEGV.
#   Pattern B — `sandhi_json_obj_new_a(a)` chain in dialect verbs.
#     `vec_push_a` (which `sandhi_json_add_*_a` calls) does NOT
#     null-check `v`; it does `load64(v + 8)` directly → SIGSEGV.
# Tests below drive each fixed path under `fail_after_n_allocs(0)`
# and assert the expected graceful return.

# Pattern A: exchange recv-buffer alloc OOM. Drive via the public
# `sandhi_http_get_a` against an unparseable URL — we early-return
# at PARSE before reaching exchange, so this test exercises the
# err-resp path threading. The actual exchange-OOM SIGSEGV path
# can't be reached without a working network conn; the guard is
# defensive but its presence is verified by reading the source.
fn test_alloc_126_exchange_path_arena() {
    var a = arena_allocator(4096);
    var resp = sandhi_http_get_a(a, "garbage://x", 0);
    assert_eq(sandhi_http_err_kind(resp), SANDHI_ERR_PARSE,
      "exchange path err-resp threads through arena");
    return 0;
}

# Pattern B: webdriver `navigate_to_a` JSON envelope OOM. Drive
# the body_obj=0 path via fail_after_n_allocs(0). Without the
# guard, the next sandhi_json_add_string_a would SIGSEGV on
# vec_push_a(v=0).
fn test_alloc_126_wd_navigate_to_oom() {
    var failer = fail_after_n_allocs(0);
    var resp = sandhi_wd_navigate_to_a(failer, "http://wd.local",
      "abc-123", "https://example.com");
    # Either the resp itself is 0 (double-OOM during _sandhi_rpc_resp_new_a)
    # or its err_kind is INTERNAL. Either way: no SIGSEGV.
    if (resp == 0) {
        assert_eq(1, 1, "double-OOM returned 0 cleanly");
        return 0;
    }
    assert_eq(sandhi_rpc_err_kind(resp), SANDHI_ERR_INTERNAL,
      "single-OOM returned INTERNAL err-resp");
    return 0;
}

# Pattern B: webdriver `find_element_a` — same shape with two adds.
fn test_alloc_126_wd_find_element_oom() {
    var failer = fail_after_n_allocs(0);
    var resp = sandhi_wd_find_element_a(failer, "http://wd.local",
      "abc-123", "css selector", "#x");
    if (resp == 0) { assert_eq(1, 1, "double-OOM 0"); return 0; }
    assert_eq(sandhi_rpc_err_kind(resp), SANDHI_ERR_INTERNAL,
      "find_element_a OOM → INTERNAL");
    return 0;
}

# Pattern B: webdriver `element_attribute_a` — uses str_builder for
# URL construction (different shape from json_obj_new chains). The
# guard is on `str_builder_new_a`.
fn test_alloc_126_wd_element_attribute_oom() {
    var failer = fail_after_n_allocs(0);
    var resp = sandhi_wd_element_attribute_a(failer, "http://wd.local",
      "abc-123", "elem-1", "href");
    if (resp == 0) { assert_eq(1, 1, "double-OOM 0"); return 0; }
    assert_eq(sandhi_rpc_err_kind(resp), SANDHI_ERR_INTERNAL,
      "element_attribute_a OOM → INTERNAL");
    return 0;
}

# Pattern B: webdriver helper `_sandhi_wd_build_path_a` returns 0
# on OOM at str_builder_new_a (was SIGSEGVing on the next add_cstr
# before the 1.2.6 guard).
fn test_alloc_126_wd_build_helper_oom() {
    var failer = fail_after_n_allocs(0);
    assert_eq(_sandhi_wd_build_path_a(failer, "value.", "key"), 0,
      "build_path_a OOM → 0");
    assert_eq(_sandhi_wd_build_element_suffix_a(failer, "abc", "/click"), 0,
      "build_element_suffix_a OOM → 0");
    return 0;
}

# Pattern B: appium `set_context_a` — paint-on-top of the same
# json_obj_new_a chain as webdriver verbs.
fn test_alloc_126_ap_set_context_oom() {
    var failer = fail_after_n_allocs(0);
    var resp = sandhi_ap_set_context_a(failer, "http://wd.local",
      "abc-123", "NATIVE_APP");
    if (resp == 0) { assert_eq(1, 1, "double-OOM 0"); return 0; }
    assert_eq(sandhi_rpc_err_kind(resp), SANDHI_ERR_INTERNAL,
      "set_context_a OOM → INTERNAL");
    return 0;
}

# Pattern B: appium `new_session_a` — three nested json_obj_new_a
# calls (always / caps / root); each was a SIGSEGV waiting for OOM
# at the corresponding alloc index before the 1.2.6 fix.
fn test_alloc_126_ap_new_session_oom() {
    var failer = fail_after_n_allocs(0);
    var resp = sandhi_ap_new_session_a(failer, "http://wd.local",
      "Android", "UiAutomator2", 0);
    if (resp == 0) { assert_eq(1, 1, "double-OOM 0"); return 0; }
    assert_eq(sandhi_rpc_err_kind(resp), SANDHI_ERR_INTERNAL,
      "new_session_a OOM → INTERNAL");
    return 0;
}

# Pattern B: mcp `_sandhi_mcp_build_request_a` returns 0 on the
# json_obj_new_a OOM. Verifies the helper itself; the higher-level
# `sandhi_rpc_mcp_call_a` propagates the 0 body to
# `sandhi_rpc_call_a` which already null-checks and sends bodyless.
fn test_alloc_126_mcp_build_request_oom() {
    var failer = fail_after_n_allocs(0);
    assert_eq(_sandhi_mcp_build_request_a(failer, "tools/list", 0), 0,
      "mcp_build_request_a OOM → 0");
    return 0;
}

# Pattern B: mcp `sandhi_rpc_mcp_stream_a` — the build_request_a
# OOM and the headers_new_a OOM are both guarded; either path
# returns a stream-result struct with err=INTERNAL.
fn test_alloc_126_mcp_stream_oom() {
    var failer = fail_after_n_allocs(0);
    var sr = sandhi_rpc_mcp_stream_a(failer, "http://daimon.local/mcp",
      "tools/list", 0, 0, 0);
    if (sr == 0) { assert_eq(1, 1, "double-OOM 0"); return 0; }
    assert_eq(sandhi_stream_err(sr), SANDHI_ERR_INTERNAL,
      "stream_a OOM → INTERNAL");
    return 0;
}

# ================================================================
# 1.2.7 — Batch G: server `_a` + OOM guards
# ================================================================
# `sandhi_server_send_status_a` / `_send_response_a` / `_send_204_a`
# / `_send_chunked_start_a` paint on `str_builder_*_a`. Same OOM
# guard pattern as 1.2.6 — `str_builder_new_a` returns 0 on OOM,
# next `str_builder_add_cstr_a` would deref null.
#
# Return shape: `_a` returns 0 on success, -1 on OOM, and since 1.10.6
# the negative write result (-errno) when the write fails. The OOM path
# returns -1 before any write, so we can drive these tests with cfd=-1
# (invalid fd, but the OOM return preempts the write).

fn test_alloc_127g_send_status_oom() {
    var failer = fail_after_n_allocs(0);
    # cfd is irrelevant on OOM since we return -1 before sock_send.
    var rc = sandhi_server_send_status_a(failer, 0 - 1, 200, "OK");
    assert_eq(rc, 0 - 1, "send_status_a OOM → -1");
    return 0;
}

fn test_alloc_127g_send_response_oom() {
    var failer = fail_after_n_allocs(0);
    var rc = sandhi_server_send_response_a(failer, 0 - 1, 200, "OK",
      "application/json", "{}", 2, 0);
    assert_eq(rc, 0 - 1, "send_response_a OOM → -1");
    return 0;
}

fn test_alloc_127g_send_204_oom() {
    var failer = fail_after_n_allocs(0);
    var rc = sandhi_server_send_204_a(failer, 0 - 1, 0);
    assert_eq(rc, 0 - 1, "send_204_a OOM → -1");
    return 0;
}

fn test_alloc_127g_send_chunked_start_oom() {
    var failer = fail_after_n_allocs(0);
    var rc = sandhi_server_send_chunked_start_a(failer, 0 - 1, 200,
      "text/event-stream", 0);
    assert_eq(rc, 0 - 1, "send_chunked_start_a OOM → -1");
    return 0;
}

# Arena round-trip: build into the arena, reset, build again. Driven
# against cfd=-1, so the build succeeds and the write fails. Through
# 1.10.5 the write result was discarded and this returned 0; since
# 1.10.6 the failed write is reported as its -errno (EBADF), which is
# distinct from the -1 an OOM build returns.
fn test_alloc_127g_send_status_arena_roundtrip() {
    var a = arena_allocator(2048);
    var rc = sandhi_server_send_status_a(a, 0 - 1, 404, "Not Found");
    assert_lt(rc, 0, "send_status_a on a bad fd reports the failed write");
    assert_neq(rc, 0 - 1, "send_status_a: and it is the write's errno, not the OOM -1");
    var used = arena_used(allocator_state(a));
    assert_eq(used > 0, 1, "arena consumed");
    reset_via(a);
    assert_eq(arena_used(allocator_state(a)), 0, "reset reclaims");
    return 0;
}

# ================================================================
# 1.2.8 — 1.1.0-era OOM-guard audit
# ================================================================
# 1.2.6 / 1.2.7 closed OOM-SIGSEGV gaps in the 1.2.0–1.2.4 and
# server-side `_a` additions. This audit extends the same pattern
# to the 1.1.0 era. Most leaf-level `_a` variants from 1.1.0
# already null-check (their tests under `alloc/batch1/`–
# `alloc/batch6/` cover the OOM contract). Two real gaps surfaced:
#
#   1. `src/http/h2/response.cyr:239` — `headers = sandhi_headers_new_a(a)`
#      then unguarded passed to `_h2_decode_response_headers_a`,
#      which calls `sandhi_headers_add_a(a, h=null, ...)` →
#      `vec_push_a(a, h=null, ...)` → SIGSEGV.
#   2. `src/http/sse.cyr:300` — `events = vec_new_a(a)` not guarded;
#      subsequent `vec_push_a(a, events=null, ev)` at line 320 →
#      SIGSEGV.
#
# Plus one partial-arena leak (not a SIGSEGV bug, but a 1.1.0
# arena-correctness violation):
#
#   3. `src/http/client.cyr:689` — `_sandhi_resolve_location_a` was
#      using `str_builder_new()` (default_alloc) instead of
#      `_a`-threading. The output was correctly dup'd into `a`, but
#      the intermediate scratch leaked into the global allocator.
#      Fixed in passing.

# h2 response — exercises `_sandhi_h2_response_recv_a` shape via
# `sandhi_h2_response_recv_a` with a fail_after_n_allocs allocator.
# Without the guard, the headers null would propagate into
# `_h2_decode_response_headers_a` → `sandhi_headers_add_a(h=null,...)`
# → `vec_push_a(v=null,...)` → SIGSEGV. We can't easily run the
# full recv path without an h2 conn; the unit-test asserts the
# guard's downstream contract via a smaller probe.
#
# Targeted check: `_h2_decode_response_headers_a(a, h2c, hblock,
# hblock_len, headers_out=0)` should not SIGSEGV. The fn doesn't
# itself null-check `headers_out`, but with a hblock_len of 0 it
# never reaches the `sandhi_headers_add_a` call (the while loop
# never enters). Driving with hblock_len > 0 would still crash;
# the fix lives at the caller (`response.cyr:239`).
fn test_alloc_128_h2_response_headers_alloc_oom() {
    var a = arena_allocator(2048);
    var h = sandhi_headers_new_a(a);
    assert_eq(h != 0, 1, "headers block alloc OK");

    # Drive _h2_decode with a 0-length hblock — the loop never
    # enters, so we don't reach the unguarded headers_add path.
    # This is a smoke check that the decode fn stays defensive
    # under benign null inputs after the response.cyr:239 fix.
    var fake_buf[1];
    store8(&fake_buf, 0);
    # Skip the actual decode call (needs an h2c); just verify the
    # caller-side guard's path: sandhi_headers_new_a(failer) → 0
    # is the precondition the guard catches.
    var failer = fail_after_n_allocs(0);
    assert_eq(sandhi_headers_new_a(failer), 0,
      "headers_new_a OOM → 0 (caller's guard precondition)");
    return 0;
}

# sse — `sandhi_sse_parse_a(a, buf, blen, remaining_out)` returns
# 0 (not a vec) when the events vec_new_a OOMs. Without the
# 1.2.8 guard, subsequent vec_push_a on null would SIGSEGV.
fn test_alloc_128_sse_parse_oom() {
    var failer = fail_after_n_allocs(0);
    var rem[8];
    store64(&rem, 0);
    # SSE input that would normally produce events. Under OOM,
    # the events vec can't be allocated → return 0 (no events).
    var raw = "data: hi\n\n";
    var events = sandhi_sse_parse_a(failer, raw, strlen(raw), &rem);
    assert_eq(events, 0, "sse_parse_a OOM → 0 (no SIGSEGV)");
    return 0;
}

# resolve_location — partial-arena leak fixed. Verify the fn now
# allocates entirely in the arena (the old impl used default_alloc
# for the str_builder scratch, leaking).
fn test_alloc_128_resolve_location_arena() {
    var a = arena_allocator(2048);
    var resolved = _sandhi_resolve_location_a(a,
      "http://example.com/api/v1", "/api/v2/foo");
    assert_streq(resolved, "http://example.com/api/v2/foo",
      "absolute-from-base resolution");

    var used = arena_used(allocator_state(a));
    assert_eq(used > 0, 1, "arena consumed by resolve");
    reset_via(a);
    assert_eq(arena_used(allocator_state(a)), 0,
      "reset reclaims everything (no default_alloc leak)");
    return 0;
}

# resolve_location OOM — str_builder_new_a returning 0 should
# bail cleanly via the new guard, not SIGSEGV.
fn test_alloc_128_resolve_location_oom() {
    var failer = fail_after_n_allocs(0);
    var resolved = _sandhi_resolve_location_a(failer,
      "http://example.com/api/v1", "/api/v2/foo");
    assert_eq(resolved, 0, "resolve_location_a OOM → 0");
    return 0;
}

# ================================================================
# 1.3.1 — TLS session-resumption cache
# ================================================================
# Process-wide singleton cache for SSL_SESSION* keyed by
# (sni_host, hook_fp). Default-OFF; opt-in via
# `sandhi_session_cache_enable(1)`. Lookup/store wired into
# `_sandhi_conn_finalize_a`'s staged-connect path.
#
# These tests exercise the cache surface directly. End-to-end
# session-resumption verification (back-to-back TLS connects
# with handshake-time savings) lives in the live-network gate
# program, not the unit suite.

fn test_alloc_131_session_cache_default_off() {
    var was_enabled = sandhi_session_cache_enabled();
    sandhi_session_cache_enable(0);
    assert_eq(sandhi_session_cache_enabled(), 0, "default disabled");
    # 1.3.3: lookup signature gained `cred_digest` 3rd arg. Pass 0
    # for the no-cred-bearing-headers case (matches the cache-key
    # shape used by service-to-service requests by default).
    var sess = sandhi_session_cache_lookup("example.com", 0, 0);
    assert_eq(sess, 0, "disabled lookup returns 0");
    sandhi_session_cache_enable(was_enabled);
    return 0;
}

fn test_alloc_131_session_cache_enable_capability_gated() {
    # 1.4.0: enable() no longer gates on TLS capability — it just
    # toggles the sandhi-side flag. Capability is queried separately
    # via `sandhi_session_cache_supported()`. This test now verifies
    # the new contract: enable(1) always succeeds (modulo OOM), and
    # `_supported()` independently reports TLS capability.
    var was_enabled = sandhi_session_cache_enabled();
    var rc = sandhi_session_cache_enable(1);
    assert_eq(rc, 1, "enable(1) succeeds regardless of TLS capability");
    assert_eq(sandhi_session_cache_enabled(), 1, "enabled flag flipped");

    # _supported() reflects the underlying TLS layer's symbols. It
    # may return 0 in this test env (sandhi binaries don't always
    # have full libssl resolution); the assertion just covers the
    # accessor's return-shape contract.
    var sup = sandhi_session_cache_supported();
    if (sup == 1 || sup == 0) {
        assert_eq(1, 1, "supported() returns 1 or 0");
    } else {
        assert_eq(sup, 0, "supported() must return 0 or 1");
    }

    sandhi_session_cache_enable(was_enabled);
    return 0;
}

fn test_alloc_131_session_cache_store_lookup_roundtrip() {
    var was_enabled = sandhi_session_cache_enabled();
    var rc = sandhi_session_cache_enable(1);
    # 1.4.0: enable() no longer gates on TLS capability — the cache
    # itself is just a hashmap and works regardless. Round-trip uses
    # fake session pointers so it doesn't depend on libssl.
    assert_eq(rc, 1, "enable(1) succeeds (1.4.0 contract: no cap gate)");

    var sz_before = sandhi_session_cache_size();
    sandhi_session_cache_reset_stats();

    # Non-zero fake session pointer (never dereferenced). Real
    # SSL_SESSION* comes from tls_get_session; here we just verify
    # the hashmap round-trip.
    # 1.3.3: signatures gained `cred_digest` slot — passing 0 keeps
    # the test focused on the 1.3.1 host/hook_fp dimensions.
    var fake_sess = 0xDEADBEEF;
    sandhi_session_cache_store("test1.example.com", 0, 0, fake_sess);

    var got = sandhi_session_cache_lookup("test1.example.com", 0, 0);
    assert_eq(got, fake_sess, "lookup returns stored session");
    assert_eq(sandhi_session_cache_hit_count(), 1, "1 hit recorded");

    var miss = sandhi_session_cache_lookup("missing.example.com", 0, 0);
    assert_eq(miss, 0, "miss returns 0");
    assert_eq(sandhi_session_cache_miss_count(), 1, "1 miss recorded");

    assert_eq(sandhi_session_cache_size(), sz_before + 1, "size grew by 1");

    # Different hook_fp → different slot.
    var fake_sess2 = 0xCAFEBABE;
    sandhi_session_cache_store("test1.example.com", 0xABCDEF, 0, fake_sess2);
    assert_eq(sandhi_session_cache_lookup("test1.example.com", 0xABCDEF, 0),
      fake_sess2, "hook_fp distinguishes slots");
    assert_eq(sandhi_session_cache_lookup("test1.example.com", 0, 0),
      fake_sess, "original slot unaffected");

    sandhi_session_cache_enable(was_enabled);
    return 0;
}

# ----------------------------------------------------------------
# 1.3.2 — TLS 1.3 0-RTT (early data), opt-in. Builds on 1.3.1
# session resumption; eligibility is gated to session-resumed TLS
# + replay-safe methods (GET/HEAD/OPTIONS) + libssl capability.
# ----------------------------------------------------------------

# Options surface — default off, setter/getter round-trip.
fn test_alloc_132_options_allow_0rtt_roundtrip() {
    var opts = sandhi_http_options_new();
    assert_neq(opts, 0, "options allocated");
    assert_eq(sandhi_http_options_get_allow_0rtt(opts), 0,
      "0-RTT defaults off");
    sandhi_http_options_allow_0rtt(opts, 1);
    assert_eq(sandhi_http_options_get_allow_0rtt(opts), 1,
      "set 1 round-trips");
    sandhi_http_options_allow_0rtt(opts, 0);
    assert_eq(sandhi_http_options_get_allow_0rtt(opts), 0,
      "reset to 0 round-trips");
    # opts == 0 guard: getter must return 0 for the null-opts path
    # because dispatch chains it through `_sandhi_http_dispatch_a`.
    assert_eq(sandhi_http_options_get_allow_0rtt(0), 0,
      "null opts → 0");
    return 0;
}

# Replay-safety classifier — exactly the RFC-7231-safe subset
# sandhi exposes (GET/HEAD/OPTIONS). Anything else MUST refuse
# 0-RTT even when the user opts in, since RFC 8446 §8 makes the
# replay risk explicit.
fn test_alloc_132_method_is_replay_safe() {
    assert_eq(_sandhi_method_is_replay_safe("GET"), 1, "GET safe");
    assert_eq(_sandhi_method_is_replay_safe("HEAD"), 1, "HEAD safe");
    assert_eq(_sandhi_method_is_replay_safe("OPTIONS"), 1, "OPTIONS safe");
    assert_eq(_sandhi_method_is_replay_safe("POST"), 0, "POST unsafe");
    assert_eq(_sandhi_method_is_replay_safe("PUT"), 0, "PUT unsafe");
    assert_eq(_sandhi_method_is_replay_safe("PATCH"), 0, "PATCH unsafe");
    assert_eq(_sandhi_method_is_replay_safe("DELETE"), 0, "DELETE unsafe");
    # Case-sensitive — HTTP methods are case-sensitive per RFC 7230 §3.1.1.
    assert_eq(_sandhi_method_is_replay_safe("get"), 0,
      "lowercase get unsafe (method names are case-sensitive)");
    return 0;
}

# The module-level `_sandhi_allow_0rtt` flag is the ctx == 0 fallback for
# the 0-RTT opt-in (1.6.9). Since 1.13.1 no dispatch path sets it — the
# buffered and `_auto` dispatches carry the opt-in in their request
# context — so it stays at its default of 0.
fn test_alloc_132_allow_0rtt_flag_default() {
    assert_eq(_sandhi_allow_0rtt, 0,
      "module-level 0-RTT flag defaults to 0");
    return 0;
}

var _t_auto_seen_0rtt = 0;
var _t_auto_seen_cred = 0;

fn _t_resolver_spy_globals(ctx, host, family): i64 {
    _t_auto_seen_0rtt = _sandhi_allow_0rtt;
    _t_auto_seen_cred = _sandhi_cred_digest;
    return 0;
}

# 1.13.1 — an `_auto` dispatch keeps its 0-RTT opt-in and credential digest in
# its own context. Through 1.13.0 it set them into module globals for the
# length of the call, where a dispatch on another thread read them. The
# resolver hook runs mid-dispatch, so it sees what that other thread would
# have. Mutation: restoring the save/restore fails both rows.
fn test_auto_dispatch_leaves_globals() {
    var a = default_alloc();
    var o = sandhi_http_options_new();
    sandhi_http_options_allow_0rtt(o, 1);
    var h = sandhi_headers_new();
    sandhi_headers_set(h, "Authorization", "Bearer t");
    _t_auto_seen_0rtt = 0 - 1;
    _t_auto_seen_cred = 0 - 1;
    sandhi_client_set_resolver(&_t_resolver_spy_globals, 0);
    var r = sandhi_http_request_auto_a(a, "GET", "http://example.invalid/x", h, 0, 0, o);
    sandhi_client_clear_resolver();
    assert_eq(sandhi_http_err_kind(r), SANDHI_ERR_DISCOVERY, "auto globals: the hook refused the dispatch");
    assert_eq(_t_auto_seen_0rtt, 0, "auto globals: the 0-RTT global stayed 0 during the dispatch");
    assert_eq(_t_auto_seen_cred, 0, "auto globals: and so did the credential digest");
    return 0;
}

# ----------------------------------------------------------------
# 1.3.3 — cred-strip-aware session-cache keying. Cache key extends
# from `(sni_host, hook_fp_hex)` to `(sni_host, hook_fp_hex,
# cred_digest)` so requests with different auth contexts to the
# same authority don't share a cached session.
# ----------------------------------------------------------------

# Empty / null headers → digest 0 (preserves pre-1.3.3 cache-key
# shape for the common service-to-service path).
fn test_alloc_133_cred_digest_empty() {
    assert_eq(_sandhi_compute_cred_digest(0), 0, "null headers → 0");
    var h = sandhi_headers_new();
    assert_neq(h, 0, "headers allocated");
    assert_eq(_sandhi_compute_cred_digest(h), 0, "empty headers → 0");
    return 0;
}

# Headers with only non-cred-bearing names → still 0. Auth headers
# are the only ones that should perturb the digest.
fn test_alloc_133_cred_digest_non_cred_headers() {
    var h = sandhi_headers_new();
    sandhi_headers_add(h, "Accept", "*/*");
    sandhi_headers_add(h, "User-Agent", "sandhi-test/1.3.3");
    sandhi_headers_add(h, "X-Custom", "anything");
    assert_eq(_sandhi_compute_cred_digest(h), 0,
      "non-cred-bearing headers don't change digest");
    return 0;
}

# Authorization → non-zero digest, value-sensitive.
fn test_alloc_133_cred_digest_authorization() {
    var h1 = sandhi_headers_new();
    sandhi_headers_add(h1, "Authorization", "Bearer alpha");
    var d1 = _sandhi_compute_cred_digest(h1);
    assert_neq(d1, 0, "Authorization yields non-zero digest");

    var h2 = sandhi_headers_new();
    sandhi_headers_add(h2, "Authorization", "Bearer beta");
    var d2 = _sandhi_compute_cred_digest(h2);
    assert_neq(d2, 0, "different value also non-zero");
    assert_neq(d1, d2, "different Authorization values → different digests");

    var h3 = sandhi_headers_new();
    sandhi_headers_add(h3, "Authorization", "Bearer alpha");
    var d3 = _sandhi_compute_cred_digest(h3);
    assert_eq(d1, d3, "same Authorization value → same digest");
    return 0;
}

# Cookie + Proxy-Authorization also count as cred-bearing.
fn test_alloc_133_cred_digest_cookie_and_proxy() {
    var h_cookie = sandhi_headers_new();
    sandhi_headers_add(h_cookie, "Cookie", "session=abc");
    var d_cookie = _sandhi_compute_cred_digest(h_cookie);
    assert_neq(d_cookie, 0, "Cookie yields non-zero digest");

    var h_proxy = sandhi_headers_new();
    sandhi_headers_add(h_proxy, "Proxy-Authorization", "Basic xyz");
    var d_proxy = _sandhi_compute_cred_digest(h_proxy);
    assert_neq(d_proxy, 0, "Proxy-Authorization yields non-zero digest");

    # Per-header marker prefix prevents value-collision across
    # header names: same body shouldn't hash identically across
    # Cookie vs. Proxy-Authorization.
    var h_collision_a = sandhi_headers_new();
    sandhi_headers_add(h_collision_a, "Cookie", "shared");
    var h_collision_b = sandhi_headers_new();
    sandhi_headers_add(h_collision_b, "Proxy-Authorization", "shared");
    assert_neq(_sandhi_compute_cred_digest(h_collision_a),
      _sandhi_compute_cred_digest(h_collision_b),
      "same value across different cred headers → different digests");
    return 0;
}

# Case-insensitive header lookup — `sandhi_headers_get` does
# case-insensitive matching, so the digest must too.
fn test_alloc_133_cred_digest_case_insensitive_header_name() {
    var h_canon = sandhi_headers_new();
    sandhi_headers_add(h_canon, "Authorization", "Bearer x");
    var h_lower = sandhi_headers_new();
    sandhi_headers_add(h_lower, "authorization", "Bearer x");
    var h_mixed = sandhi_headers_new();
    sandhi_headers_add(h_mixed, "AUTHORIZATION", "Bearer x");
    var d = _sandhi_compute_cred_digest(h_canon);
    assert_eq(_sandhi_compute_cred_digest(h_lower), d,
      "lowercase header name → same digest");
    assert_eq(_sandhi_compute_cred_digest(h_mixed), d,
      "uppercase header name → same digest");
    return 0;
}

# Cache-key isolation — the same (host, hook_fp) under different
# cred_digest values must produce distinct cache slots. 1.4.0:
# enable() no longer gates on TLS capability, so this now runs
# unconditionally with fake session pointers.
fn test_alloc_133_cache_isolates_by_cred_digest() {
    var was_enabled = sandhi_session_cache_enabled();
    var rc = sandhi_session_cache_enable(1);
    assert_eq(rc, 1, "enable(1) succeeds (1.4.0 contract)");
    var sz_before = sandhi_session_cache_size();

    var fake_a = 0x11AA11AA;
    var fake_b = 0x22BB22BB;
    # Same host, same hook_fp, different cred_digest →
    # 2 distinct slots, one session per slot.
    sandhi_session_cache_store("iso.example.com", 0, 0xC0FFEE01, fake_a);
    sandhi_session_cache_store("iso.example.com", 0, 0xC0FFEE02, fake_b);

    assert_eq(sandhi_session_cache_lookup("iso.example.com", 0, 0xC0FFEE01),
      fake_a, "cred_digest A → session A");
    assert_eq(sandhi_session_cache_lookup("iso.example.com", 0, 0xC0FFEE02),
      fake_b, "cred_digest B → session B");
    # Default digest 0 is yet a 3rd slot — must miss.
    assert_eq(sandhi_session_cache_lookup("iso.example.com", 0, 0),
      0, "cred_digest 0 → miss (3rd distinct slot)");
    assert_eq(sandhi_session_cache_size(), sz_before + 2,
      "exactly 2 new slots from 2 different cred_digest values");

    sandhi_session_cache_enable(was_enabled);
    return 0;
}

# `_sandhi_cred_digest` module-level flag defaults to 0 and is
# the storage that dispatch save+restores from
# `_sandhi_compute_cred_digest(headers)` for the duration of the
# request.
fn test_alloc_133_cred_digest_flag_default() {
    assert_eq(_sandhi_cred_digest, 0,
      "module-level cred_digest flag defaults to 0");
    return 0;
}

# Conn-struct accessor — the new 0-RTT status slot is at
# `SANDHI_CONN_OFF_0RTT_STATUS`. Verify the accessor reads from
# the right offset and that NOT_SENT is the default the finalize
# path stamps in for plaintext / non-resumed TLS exchanges.
# Stand up a fake conn (raw alloc + zero-init) so the assertion
# doesn't depend on a real socket / TLS handshake.
fn test_alloc_132_conn_0rtt_status_accessor() {
    var fake = alloc_via(default_alloc(), SANDHI_CONN_STRUCT_SIZE);
    assert_neq(fake, 0, "fake conn allocated");
    # Zero-init the slot — `alloc_via` does not guarantee zeroing.
    store64(fake + SANDHI_CONN_OFF_0RTT_STATUS, TLS_EARLY_DATA_NOT_SENT);
    assert_eq(sandhi_conn_0rtt_status(fake), TLS_EARLY_DATA_NOT_SENT,
      "accessor reads NOT_SENT");
    store64(fake + SANDHI_CONN_OFF_0RTT_STATUS, TLS_EARLY_DATA_REJECTED);
    assert_eq(sandhi_conn_0rtt_status(fake), TLS_EARLY_DATA_REJECTED,
      "accessor reads REJECTED");
    store64(fake + SANDHI_CONN_OFF_0RTT_STATUS, TLS_EARLY_DATA_ACCEPTED);
    assert_eq(sandhi_conn_0rtt_status(fake), TLS_EARLY_DATA_ACCEPTED,
      "accessor reads ACCEPTED");
    return 0;
}

# Disabled-path: store + lookup are no-ops. Critical because
# `_sandhi_conn_finalize_a` calls these on every TLS connect.
fn test_alloc_131_session_cache_disabled_noops() {
    var was_enabled = sandhi_session_cache_enabled();
    sandhi_session_cache_enable(0);
    var sz_before = sandhi_session_cache_size();
    sandhi_session_cache_reset_stats();

    sandhi_session_cache_store("noop.example.com", 0, 0, 0xFEEDFACE);
    assert_eq(sandhi_session_cache_size(), sz_before,
      "store no-op when disabled");
    var sess = sandhi_session_cache_lookup("noop.example.com", 0, 0);
    assert_eq(sess, 0, "lookup no-op when disabled");
    assert_eq(sandhi_session_cache_hit_count(), 0, "no hit-count delta");
    assert_eq(sandhi_session_cache_miss_count(), 0, "no miss-count delta");

    sandhi_session_cache_enable(was_enabled);
    return 0;
}

# ================================================================
# 1.4.0 — session-cache TTL + max-size eviction. Closes the
# "cache grows unbounded" gap left after 1.3.1. Also fixes the
# silent `hashmap_*` → `map_*` naming bug carried since 1.3.1
# that NOPed the underlying hashmap calls — these tests are the
# first to actually exercise a real round-trip end-to-end.
# ================================================================

# Defaults — 256 entries, 24h (86_400_000 ms). No skip needed;
# the config vars exist regardless of TLS capability.
fn test_alloc_134_defaults() {
    assert_eq(sandhi_session_cache_max_size(), 256,
      "default max_size is 256");
    assert_eq(sandhi_session_cache_max_age_ms(), 86400000,
      "default max_age_ms is 24h");
    return 0;
}

# Setter round-trip + clamp behavior — both setters clamp to 1
# on `n < 1` so we can't disable the bound by accident.
fn test_alloc_134_set_max_size_roundtrip() {
    var was = sandhi_session_cache_max_size();
    sandhi_session_cache_set_max_size(100);
    assert_eq(sandhi_session_cache_max_size(), 100, "set to 100");
    sandhi_session_cache_set_max_size(0);
    assert_eq(sandhi_session_cache_max_size(), 1, "clamped to 1 on n<1");
    sandhi_session_cache_set_max_size(0 - 5);
    assert_eq(sandhi_session_cache_max_size(), 1, "clamped to 1 on n<1 (neg)");
    sandhi_session_cache_set_max_size(was);
    return 0;
}

fn test_alloc_134_set_max_age_ms_roundtrip() {
    var was = sandhi_session_cache_max_age_ms();
    sandhi_session_cache_set_max_age_ms(1000);
    assert_eq(sandhi_session_cache_max_age_ms(), 1000, "set to 1000");
    sandhi_session_cache_set_max_age_ms(0);
    assert_eq(sandhi_session_cache_max_age_ms(), 1, "clamped to 1 on ms<1");
    sandhi_session_cache_set_max_age_ms(was);
    return 0;
}

# Eviction counters default to 0 and reset_stats clears them.
fn test_alloc_134_evict_counters_default_zero() {
    sandhi_session_cache_reset_stats();
    assert_eq(sandhi_session_cache_evict_count(), 0, "evict_count starts 0");
    assert_eq(sandhi_session_cache_age_evict_count(), 0,
      "age_evict_count starts 0");
    return 0;
}

# LRU eviction-on-insert: when the cache is at max_size and a NEW
# key arrives, the entry with the oldest last_used_ms is evicted.
# Three SNI hosts; max=2; insert three; verify the first is gone
# and evict_count == 1.
fn test_alloc_134_evict_oldest_at_max() {
    var was_enabled = sandhi_session_cache_enabled();
    var rc = sandhi_session_cache_enable(1);
    assert_eq(rc, 1, "enable(1) succeeds (1.4.0 contract)");
    sandhi_session_cache_clear();
    var was_max = sandhi_session_cache_max_size();
    sandhi_session_cache_set_max_size(2);
    sandhi_session_cache_reset_stats();

    var sz_before = sandhi_session_cache_size();

    # A tick between each store so each last_used_ms is strictly greater than the
    # last — the same idiom test_alloc_134_lookup_touch_promotes_lru uses below.
    #
    # 1.9.16: without these the three stores land in the SAME millisecond, all
    # three last_used_ms tie, and `_sandhi_session_cache_evict_oldest` (strict `<`
    # over map_keys order) evicts whichever key the map happens to enumerate
    # first. That was stable only because the stdlib hash was an unseeded
    # constant; cyrius v6.5.39 gave every process a random hash seed
    # (lib/hashseed.cyr, hash-flooding fix), so map_keys order now varies run to
    # run and this test failed intermittently the moment the pin crossed 6.5.39.
    # LRU-by-timestamp is only a meaningful contract when the timestamps differ,
    # so making them differ is what turns this back into a real assertion.
    sandhi_session_cache_store("evict1.example.com", 0, 0, 0x11111111);
    var te1 = clock_now_ms();
    while (clock_now_ms() <= te1) { }
    sandhi_session_cache_store("evict2.example.com", 0, 0, 0x22222222);
    var te2 = clock_now_ms();
    while (clock_now_ms() <= te2) { }
    sandhi_session_cache_store("evict3.example.com", 0, 0, 0x33333333);

    # evict1 was inserted first → smallest last_used_ms → evicted.
    assert_eq(sandhi_session_cache_lookup("evict1.example.com", 0, 0), 0,
      "evict1 was evicted (oldest)");
    assert_eq(sandhi_session_cache_lookup("evict2.example.com", 0, 0),
      0x22222222, "evict2 still present");
    assert_eq(sandhi_session_cache_lookup("evict3.example.com", 0, 0),
      0x33333333, "evict3 still present");
    assert_eq(sandhi_session_cache_evict_count(), 1,
      "exactly one LRU eviction recorded");

    # Cleanup — drop bound back, clear residual entries via store
    # under a fresh max so they don't bleed into later tests.
    sandhi_session_cache_set_max_size(was_max);
    sandhi_session_cache_enable(was_enabled);
    return 0;
}

# Lookup touches last_used_ms — promoting an entry above the
# would-be-evicted slot. max=2; store A; store B; lookup A
# (A becomes newest); store C; expect B (now oldest) evicted,
# not A.
fn test_alloc_134_lookup_touch_promotes_lru() {
    var was_enabled = sandhi_session_cache_enabled();
    var rc = sandhi_session_cache_enable(1);
    assert_eq(rc, 1, "enable(1) succeeds (1.4.0 contract)");
    sandhi_session_cache_clear();
    var was_max = sandhi_session_cache_max_size();
    sandhi_session_cache_set_max_size(2);
    sandhi_session_cache_reset_stats();

    sandhi_session_cache_store("touch_a.example.com", 0, 0, 0xAAAA0001);
    # Tiny clock advance so B's last_used_ms is strictly > A's.
    # clock_now_ms is monotonic; the busy-wait guarantees a tick.
    var t0 = clock_now_ms();
    while (clock_now_ms() <= t0) { }
    sandhi_session_cache_store("touch_b.example.com", 0, 0, 0xBBBB0002);

    # Touch A — last_used_ms becomes now (> B's).
    var t1 = clock_now_ms();
    while (clock_now_ms() <= t1) { }
    assert_eq(sandhi_session_cache_lookup("touch_a.example.com", 0, 0),
      0xAAAA0001, "A lookup hit");

    # Now store C → B should be evicted (oldest), not A.
    var t2 = clock_now_ms();
    while (clock_now_ms() <= t2) { }
    sandhi_session_cache_store("touch_c.example.com", 0, 0, 0xCCCC0003);

    assert_eq(sandhi_session_cache_lookup("touch_a.example.com", 0, 0),
      0xAAAA0001, "A preserved (touched, became newest)");
    assert_eq(sandhi_session_cache_lookup("touch_b.example.com", 0, 0), 0,
      "B evicted (oldest after A was touched)");
    assert_eq(sandhi_session_cache_lookup("touch_c.example.com", 0, 0),
      0xCCCC0003, "C present (newly stored)");

    sandhi_session_cache_set_max_size(was_max);
    sandhi_session_cache_enable(was_enabled);
    return 0;
}

# Replace-in-place doesn't count as an LRU eviction. max=1;
# store A; store A again with a different session pointer.
# Size stays 1; evict_count stays 0.
fn test_alloc_134_replace_in_place_no_evict() {
    var was_enabled = sandhi_session_cache_enabled();
    var rc = sandhi_session_cache_enable(1);
    assert_eq(rc, 1, "enable(1) succeeds (1.4.0 contract)");
    sandhi_session_cache_clear();
    var was_max = sandhi_session_cache_max_size();
    sandhi_session_cache_set_max_size(1);
    sandhi_session_cache_reset_stats();

    var sz_before = sandhi_session_cache_size();
    sandhi_session_cache_store("repl.example.com", 0, 0, 0xDDDD0001);
    sandhi_session_cache_store("repl.example.com", 0, 0, 0xDDDD0002);

    assert_eq(sandhi_session_cache_lookup("repl.example.com", 0, 0),
      0xDDDD0002, "second store overwrote first");
    assert_eq(sandhi_session_cache_evict_count(), 0,
      "replace-in-place doesn't count as LRU eviction");

    sandhi_session_cache_set_max_size(was_max);
    sandhi_session_cache_enable(was_enabled);
    return 0;
}

# Age-based eviction on lookup: set max_age very small; store an
# entry; wait past the age window; lookup → miss + age_evict_count++.
fn test_alloc_134_age_evict_on_lookup() {
    var was_enabled = sandhi_session_cache_enabled();
    var rc = sandhi_session_cache_enable(1);
    assert_eq(rc, 1, "enable(1) succeeds (1.4.0 contract)");
    sandhi_session_cache_clear();
    var was_age = sandhi_session_cache_max_age_ms();
    sandhi_session_cache_set_max_age_ms(1);
    sandhi_session_cache_reset_stats();

    sandhi_session_cache_store("age.example.com", 0, 0, 0xEEEE0001);

    # Busy-wait long enough that clock_now_ms advances past the
    # 1ms window. 5ms is conservative.
    var deadline = clock_now_ms() + 5;
    while (clock_now_ms() < deadline) { }

    var sess = sandhi_session_cache_lookup("age.example.com", 0, 0);
    assert_eq(sess, 0, "stale entry returns miss");
    assert_eq(sandhi_session_cache_age_evict_count(), 1,
      "age-eviction recorded");
    assert_eq(sandhi_session_cache_miss_count(), 1,
      "stale-evict also counts as miss for stats");

    sandhi_session_cache_set_max_age_ms(was_age);
    sandhi_session_cache_enable(was_enabled);
    return 0;
}

# ----------------------------------------------------------------
# 1.4.6 — high-level TLS-policy threading. The options struct gains
# a tls_policy slot (offset 72); the dispatch path threads it through
# the module-level `_sandhi_tls_policy_pending` flag (mirrors the
# 0-RTT / cred-digest flags). Live enforcement is covered by
# programs/_https_policy_threading_gate.cyr; these are the
# deterministic accessor + default-state checks.
# ----------------------------------------------------------------

fn test_alloc_146_tls_policy_roundtrip() {
    var opts = sandhi_http_options_new();
    assert_neq(opts, 0, "options allocated");
    assert_eq(sandhi_http_options_get_tls_policy(opts), 0,
      "tls_policy defaults to 0 (no enforcement)");
    # A policy handle is just an opaque pointer to the options slot;
    # use a non-zero sentinel to prove the slot round-trips.
    sandhi_http_options_tls_policy(opts, 4242);
    assert_eq(sandhi_http_options_get_tls_policy(opts), 4242,
      "set policy round-trips");
    sandhi_http_options_tls_policy(opts, 0);
    assert_eq(sandhi_http_options_get_tls_policy(opts), 0,
      "clear policy round-trips");
    # opts == 0 guard — getter returns 0 so the dispatch path treats a
    # null-opts request as policy-free.
    assert_eq(sandhi_http_options_get_tls_policy(0), 0, "null opts → 0");
    return 0;
}

fn test_alloc_146_tls_policy_flag_default() {
    # Module-level pending-policy flag (src/http/conn.cyr), set
    # transiently around dispatch and restored after — same shape as
    # `_sandhi_allow_0rtt` / `_sandhi_cred_digest`. Defaults to 0.
    assert_eq(_sandhi_tls_policy_pending, 0,
      "module-level pending-policy flag defaults to 0");
    return 0;
}

# The 1.4.6 tls_policy slot must not have disturbed the other option
# slots — every prior accessor still reads its own default after the
# struct grew 72 → 80 bytes.
fn test_alloc_146_options_layout_intact() {
    var opts = sandhi_http_options_new();
    assert_neq(opts, 0, "options allocated");
    assert_eq(sandhi_http_options_follow(opts), 0, "follow default 0");
    assert_eq(sandhi_http_options_get_connect_ms(opts), 0, "connect_ms default 0");
    assert_eq(sandhi_http_options_get_total_ms(opts), 0, "total_ms default 0");
    assert_eq(sandhi_http_options_get_pool(opts), 0, "pool default 0");
    assert_eq(sandhi_http_options_get_allow_0rtt(opts), 0, "allow_0rtt default 0");
    assert_eq(sandhi_http_options_get_tls_policy(opts), 0, "tls_policy default 0");
    return 0;
}

# 1.13.3 — one h2 connection shared by threads. The pool hands every caller for a
# route the same h2 conn, and nothing serialised two threads' exchanges on it: the
# stream-id counter, both HPACK tables, the frame writes and the response reads are
# all the connection's. A loopback pair, and a peer thread that decodes each
# request's header block with its own HPACK table and answers on that stream with
# `:status 200` and the request's `:path` as the body; each client thread checks it
# got its own path back. Mutation: dropping the lock in `sandhi_h2_request_a`
# fails the row.
var _t_h2s_cfd = 0;
var _t_h2s_sfd = 0;
var _t_h2s_h2c = 0;
var _t_h2s_ok = 0;
var _t_h2s_bad = 0;
var _t_h2s_served = 0;
var _t_h2s_order_bad = 0;
var _t_h2s_want = 0;

fn _t_h2s_threads(): i64 { return 4; }
fn _t_h2s_iters(): i64 { return 40; }

# A plain client conn over `fd`, as the conn-open path builds one.
fn _t_h2s_conn(fd): i64 {
    var c = alloc(SANDHI_CONN_STRUCT_SIZE);
    store64(c + SANDHI_CONN_OFF_KIND, SANDHI_CONN_PLAIN);
    store64(c + SANDHI_CONN_OFF_FD, fd);
    store64(c + SANDHI_CONN_OFF_TLS_CTX, 0);
    store64(c + SANDHI_CONN_OFF_ALPN_DATA, 0);
    store64(c + SANDHI_CONN_OFF_0RTT_STATUS, 0);
    return c;
}

# A loopback pair into `_t_h2s_cfd` / `_t_h2s_sfd`, each end with a 2 s read
# timeout so a lost frame fails a row instead of hanging it, and TCP_NODELAY
# (through 1.13.5 an h2 frame went out as two writes, and without it each
# exchange waited ~80 ms on Nagle and delayed ACK). 0, or -1 to skip.
fn _t_h2s_pair(port): i64 {
    return _t_h2s_pair_nd(port, 1);
}

# The same, with TCP_NODELAY only when `nodelay` is 1.
fn _t_h2s_pair_nd(port, nodelay): i64 {
    var lr_tag, lfd = tcp_socket();
    if (is_err_result(lr_tag) == 1) { return 0 - 1; }
    sock_reuse(lfd);
    if (is_err_result(sock_bind(lfd, INADDR_LOOPBACK(), port)) == 1) { sock_close(lfd); return 0 - 1; }
    if (is_err_result(sock_listen(lfd, 4)) == 1) { sock_close(lfd); return 0 - 1; }
    var cr_tag, cfd = tcp_socket();
    if (is_err_result(cr_tag) == 1) { sock_close(lfd); return 0 - 1; }
    if (is_err_result(sock_connect(cfd, INADDR_LOOPBACK(), port)) == 1) {
        sock_close(cfd); sock_close(lfd); return 0 - 1;
    }
    var ar_tag, sfd = sock_accept(lfd);
    sock_close(lfd);
    if (is_err_result(ar_tag) == 1) { sock_close(cfd); return 0 - 1; }
    _sandhi_conn_set_timeout_ms(cfd, 2000, _SANDHI_SO_RCVTIMEO);
    _sandhi_conn_set_timeout_ms(sfd, 2000, _SANDHI_SO_RCVTIMEO);
    if (nodelay == 1) {
        sock_set_nodelay(cfd, 1);
        sock_set_nodelay(sfd, 1);
    }
    _t_h2s_cfd = cfd;
    _t_h2s_sfd = sfd;
    return 0;
}

fn _t_h2s_put_int(buf, off, n): i64 {
    var d = alloc(24);
    var k = 0;
    var v = n;
    if (v == 0) { store8(d, 48); k = 1; }
    while (v > 0) { store8(d + k, 48 + v % 10); v = v / 10; k = k + 1; }
    var o = off;
    while (k > 0) { k = k - 1; store8(buf + o, load8(d + k)); o = o + 1; }
    store8(buf + o, 0);
    return o;
}

# The peer: answer `_t_h2s_want` requests, then close its end.
fn _t_h2s_peer(arg) {
    var p = sandhi_h2_conn_new(_t_h2s_conn(_t_h2s_sfd));
    var res = alloc(16);
    var off = alloc(8);
    var no = alloc(8);
    var vo = alloc(8);
    var st = alloc(8);
    store8(st, 0x88);                    # :status 200 (static index 8)
    var last_sid = 0;
    while (_t_h2s_served < _t_h2s_want) {
        if (sandhi_h2_conn_recv_frame(p, res) < 0) { break; }
        var hdr = load64(res);
        if (sandhi_h2_hdr_type(hdr) == SANDHI_H2_FRAME_HEADERS) {
            var sid = sandhi_h2_hdr_stream_id(hdr);
            if (sid <= last_sid) { _t_h2s_order_bad = _t_h2s_order_bad + 1; }
            last_sid = sid;
            var blk = load64(res + 8);
            var blen = sandhi_h2_hdr_length(hdr);
            var path = "?";
            store64(off, 0);
            while (load64(off) < blen) {
                var r = sandhi_hpack_decode_field_a(default_alloc(), sandhi_h2_conn_dec_table(p),
                  blk, blen, off, no, vo);
                if (r < 0) { break; }
                if (r != _SANDHI_HPACK_TBL_UPDATE) {
                    if (streq(load64(no), ":path") == 1) { path = load64(vo); }
                }
            }
            sandhi_h2_conn_send_frame(p, SANDHI_H2_FRAME_HEADERS, SANDHI_H2_FLAG_END_HEADERS, sid, st, 1);
            sandhi_h2_conn_send_frame(p, SANDHI_H2_FRAME_DATA, SANDHI_H2_FLAG_END_STREAM, sid, path, strlen(path));
            _t_h2s_served = _t_h2s_served + 1;
        }
    }
    sock_close(_t_h2s_sfd);
    return 0;
}

# One client thread: `_t_h2s_iters()` GETs of "/t<t>/<j>" on the shared conn,
# stopping at the first wrong answer.
fn _t_h2s_client(arg) {
    var t = arg;
    var a = arena_allocator(1200000);    # one response's 1 MiB body buffer + scratch
    var path = alloc(64);
    var url = alloc(96);
    var ok = 0;
    var bad = 0;
    var j = 0;
    while (j < _t_h2s_iters()) {
        store8(path, 47); store8(path + 1, 116);   # "/t"
        var o = _t_h2s_put_int(path, 2, t);
        store8(path + o, 47);
        _t_h2s_put_int(path, o + 1, j);
        memcpy(url, "http://h2.test", 14);
        memcpy(url + 14, path, strlen(path) + 1);
        var r = sandhi_h2_request_a(a, _t_h2s_h2c, "GET", url, 0, 0, 0);
        if (sandhi_http_status(r) == 200 && streq(sandhi_http_body(r), path) == 1) {
            ok = ok + 1;
        } else {
            bad = bad + 1;
            j = _t_h2s_iters();
        }
        reset_via(a);
        j = j + 1;
    }
    store64(_t_h2s_ok + t * 8, ok);
    store64(_t_h2s_bad + t * 8, bad);
    return 0;
}

fn test_h2_conn_shared_by_threads() {
    if (THREADS_CONCURRENT != 1) { assert_eq(1, 1, "h2 shared: no concurrent threads — skipped"); return 0; }
    if (_t_h2s_pair(39851) != 0) { assert_eq(1, 1, "h2 shared: loopback unavailable — skipped"); return 0; }
    var nt = _t_h2s_threads();
    _t_h2s_want = 1 + nt * _t_h2s_iters();
    _t_h2s_served = 0;
    _t_h2s_order_bad = 0;
    _t_h2s_h2c = sandhi_h2_conn_new(_t_h2s_conn(_t_h2s_cfd));
    _t_h2s_ok = alloc(nt * 8);
    _t_h2s_bad = alloc(nt * 8);
    var peer = thread_create(&_t_h2s_peer, 0);
    if (peer == 0) {
        sock_close(_t_h2s_cfd); sock_close(_t_h2s_sfd);
        assert_eq(1, 1, "h2 shared: no thread — skipped");
        return 0;
    }
    # One exchange alone first: proves the fixture. (Through 1.13.3 it also kept
    # the threads off the HPACK tables' first-use race, fixed at 1.13.4.)
    var wa = arena_allocator(1200000);
    var w = sandhi_h2_request_a(wa, _t_h2s_h2c, "GET", "http://h2.test/warm", 0, 0, 0);
    assert_eq(sandhi_http_status(w), 200, "h2 shared: a lone exchange answers 200");
    assert_eq(streq(sandhi_http_body(w), "/warm"), 1, "h2 shared: with its own path as the body");

    var th = alloc(nt * 8);
    var t = 0;
    while (t < nt) {
        store64(_t_h2s_ok + t * 8, 0);
        store64(_t_h2s_bad + t * 8, 0);
        store64(th + t * 8, thread_create(&_t_h2s_client, t));
        t = t + 1;
    }
    t = 0;
    while (t < nt) {
        if (load64(th + t * 8) != 0) { thread_join(load64(th + t * 8)); }
        t = t + 1;
    }
    thread_join(peer);
    sock_close(_t_h2s_cfd);
    var ok = 0;
    var bad = 0;
    t = 0;
    while (t < nt) {
        ok = ok + load64(_t_h2s_ok + t * 8);
        bad = bad + load64(_t_h2s_bad + t * 8);
        t = t + 1;
    }
    assert_eq(bad, 0, "h2 shared: no thread got another's answer, or none");
    assert_eq(ok, nt * _t_h2s_iters(), "h2 shared: 4 threads x 40 exchanges on one conn all answered");
    assert_eq(_t_h2s_served, _t_h2s_want, "h2 shared: the peer saw every request");
    assert_eq(_t_h2s_order_bad, 0, "h2 shared: stream ids reached the wire strictly increasing");
    return 0;
}

# The h2 conn carries its lock. `SANDHI_H2_CONN_STRUCT_SIZE` 80 → 88 (and 88 →
# 144 at 1.13.6, for the flow-control and retirement slots).
fn test_h2_conn_has_mutex() {
    var a = arena_allocator(8192);
    var c = sandhi_h2_conn_new_a(a, 0);
    assert_neq(c, 0, "h2 conn: built");
    assert_eq(SANDHI_H2_CONN_STRUCT_SIZE, 144, "h2 conn: struct 144 bytes");
    assert_neq(load64(c + SANDHI_H2_CONN_OFF_MUTEX), 0, "h2 conn: owns a mutex");
    return 0;
}

# The constructors fail closed at every allocation: a conn (or an HPACK table) is
# either 0 or complete, never a live handle holding a null table or vec. Through
# 1.13.2 the two tables, and each table's two vecs, were stored unchecked.
fn _t_h2s_table_complete(t): i64 {
    if (t == 0) { return 0; }
    if (load64(t + SANDHI_HPACK_TBL_OFF_NAMES) == 0) { return 0; }
    if (load64(t + SANDHI_HPACK_TBL_OFF_VALUES) == 0) { return 0; }
    return 1;
}

fn test_h2_conn_new_fails_closed() {
    var partial_t = 0;
    var whole_t = 0;
    var partial_c = 0;
    var whole_c = 0;
    var k = 0;
    while (k < 24) {
        var t = sandhi_hpack_table_new_a(fail_after_n_allocs(k), 0);
        if (t != 0) {
            if (_t_h2s_table_complete(t) == 1) { whole_t = whole_t + 1; } else { partial_t = partial_t + 1; }
        }
        var c = sandhi_h2_conn_new_a(fail_after_n_allocs(k), 0);
        if (c != 0) {
            if (_t_h2s_table_complete(sandhi_h2_conn_enc_table(c)) == 1
              && _t_h2s_table_complete(sandhi_h2_conn_dec_table(c)) == 1) {
                whole_c = whole_c + 1;
            } else {
                partial_c = partial_c + 1;
            }
        }
        k = k + 1;
    }
    assert_eq(partial_t, 0, "hpack table: no allocation failure leaves a partial table");
    assert_eq(partial_c, 0, "h2 conn: no allocation failure leaves a partial conn");
    assert(whole_t > 0, "hpack table: built once allocations stop failing");
    assert(whole_c > 0, "h2 conn: built once allocations stop failing");
    return 0;
}

# A close cannot land mid-exchange, and a stale pointer cannot write into whatever
# socket reuses the fd. `sandhi_http_pool_close_h2_conns` closes each conn under
# its lock and clears its conn slot; a request on the stale h2 conn then fails
# without writing. The row reopens a pair so the closed fd's number is reused, and
# checks the new connection received nothing (POSIX hands out the lowest free fd;
# where the number is not reused the write-check skips).
fn test_h2_pool_close_clears_conn() {
    if (_t_h2s_pair(39852) != 0) { assert_eq(1, 1, "h2 close: loopback unavailable — skipped"); return 0; }
    var old_cfd = _t_h2s_cfd;
    var old_sfd = _t_h2s_sfd;
    var h2c = sandhi_h2_conn_new(_t_h2s_conn(old_cfd));
    var pool = sandhi_http_pool_new(0, 0);
    sandhi_http_pool_put_h2(pool, "h2.test", 80, 0, h2c);
    sandhi_http_pool_close_h2_conns(pool);
    sock_close(old_sfd);
    assert_eq(sandhi_h2_conn_underlying(h2c), 0, "h2 close: the conn slot is cleared");
    if (_t_h2s_pair(39853) != 0) { assert_eq(1, 1, "h2 close: second pair unavailable — skipped"); return 0; }
    var a = arena_allocator(1200000);
    var r = sandhi_h2_request_a(a, h2c, "GET", "http://h2.test/stale", 0, 0, 0);
    assert_eq(sandhi_http_status(r), 0, "h2 close: a request on the stale conn gets no status");
    assert_eq(sandhi_http_err_kind(r), SANDHI_ERR_PROTOCOL, "h2 close: and fails as PROTOCOL");
    if (_t_h2s_cfd == old_cfd) {
        # Through the conn's transport, not sys_read: a Winsock handle is not a file
        # handle, and a file read on it ignores SO_RCVTIMEO and blocks.
        _sandhi_conn_set_timeout_ms(_t_h2s_sfd, 200, _SANDHI_SO_RCVTIMEO);
        var buf = alloc(65);
        var n = sandhi_conn_recv(_t_h2s_conn(_t_h2s_sfd), buf, 64);
        assert(n <= 0, "h2 close: nothing reached the connection that reused the fd");
    } else {
        assert_eq(1, 1, "h2 close: fd not reused here — write check skipped");
    }
    sock_close(_t_h2s_cfd);
    sock_close(_t_h2s_sfd);
    return 0;
}

# 1.13.4 — the process-wide HPACK static and Huffman tables are built on first
# use. Through 1.13.3 the builds wrote straight into the globals and set a
# "built" flag last, so threads making their first h2 request together built
# into each other's tables. Each round clears both tables and releases four
# threads together: two build (`_t_hpt_worker`), and two watch the table
# pointers so they check each table the moment it is published. Every thread
# checks all 61 static entries and a Huffman round trip of every byte value.
# Mutation: publishing either table before it is filled fails the row.
var _t_hpt_ready = 0;
var _t_hpt_go = 0;
var _t_hpt_step = 0;
var _t_hpt_bad = 0;
var _t_hpt_ref_names = 0;
var _t_hpt_ref_values = 0;
var _t_hpt_bytes = 0;

fn _t_hpt_threads(): i64 { return 4; }
fn _t_hpt_rounds(): i64 { return 150; }
# The decoder sizes its output at 8 bytes per input byte.
fn _t_hpt_arena(): i64 { return 16384; }

# Forget both tables, so the next use builds them.
fn _t_hpt_reset(): i64 {
    _hpack_static_tbl = 0;
    _hpack_huffman_tbl = 0;
    return 0;
}

# Every static entry, by the public verbs. 0, or the number that differ.
fn _t_hpt_static_bad(): i64 {
    var bad = 0;
    if (sandhi_hpack_static_size() != 61) { bad = bad + 1; }
    var i = 1;
    while (i <= 61) {
        var n = sandhi_hpack_static_name(i);
        var v = sandhi_hpack_static_value(i);
        if (n == 0 || v == 0) { bad = bad + 1; }
        elif (streq(n, load64(_t_hpt_ref_names + i * 8)) != 1
          || streq(v, load64(_t_hpt_ref_values + i * 8)) != 1) {
            bad = bad + 1;
        }
        i = i + 1;
    }
    return bad;
}

# Bytes 1..255 through the encoder and back through the decoder. 0, or 1.
fn _t_hpt_huffman_bad(a): i64 {
    var n = sandhi_hpack_huffman_encoded_len(_t_hpt_bytes);
    if (n <= 0) { return 1; }
    var out = alloc_via(a, n + 8);
    if (out == 0) { return 1; }
    if (sandhi_hpack_huffman_encode(out, 0, _t_hpt_bytes) != n) { return 1; }
    var back = sandhi_hpack_huffman_decode_a(a, out, 0, n);
    if (back == 0) { return 1; }
    if (streq(back, _t_hpt_bytes) != 1) { return 1; }
    if (sandhi_hpack_huffman_encoded_len("www.example.com") != 12) { return 1; }
    return 0;
}

# Spin until the table at `slot` is published; bounded, so a build that never
# publishes cannot hang the row.
fn _t_hpt_watch(slot): i64 {
    var n = 0;
    while (atomic_load(slot) == 0 && n < 100000000) { n = n + 1; }
    return 0;
}

# Threads 0 and 1 build, 1 after a delay that varies by round, so some rounds
# build both at once and others not. Thread 2 watches the static table, 3 the
# Huffman tables. Even threads check the static table first.
fn _t_hpt_worker(arg) {
    var a = arena_allocator(_t_hpt_arena());
    var spin = 0;
    if (arg == 1) { spin = _t_hpt_step; }
    atomic_fetch_add(&_t_hpt_ready, 1);
    while (atomic_load(&_t_hpt_go) == 0) { }
    if (arg == 2) { _t_hpt_watch(&_hpack_static_tbl); }
    if (arg == 3) { _t_hpt_watch(&_hpack_huffman_tbl); }
    while (spin > 0) { spin = spin - 1; }
    var bad = 0;
    if ((arg & 1) == 0) {
        bad = _t_hpt_static_bad();
        bad = bad + _t_hpt_huffman_bad(a);
    } else {
        bad = _t_hpt_huffman_bad(a);
        bad = bad + _t_hpt_static_bad();
    }
    if (bad != 0) { atomic_fetch_add(&_t_hpt_bad, 1); }
    return 0;
}

fn test_hpack_tables_first_use_threads() {
    if (THREADS_CONCURRENT != 1) { assert_eq(1, 1, "hpack tables: no concurrent threads — skipped"); return 0; }
    # The reference: both tables as one thread builds them.
    _t_hpt_reset();
    _t_hpt_ref_names = alloc(62 * 8);
    _t_hpt_ref_values = alloc(62 * 8);
    var i = 1;
    while (i <= 61) {
        store64(_t_hpt_ref_names + i * 8, sandhi_hpack_static_name(i));
        store64(_t_hpt_ref_values + i * 8, sandhi_hpack_static_value(i));
        i = i + 1;
    }
    _t_hpt_bytes = alloc(256);
    i = 0;
    while (i < 255) { store8(_t_hpt_bytes + i, i + 1); i = i + 1; }
    store8(_t_hpt_bytes + 255, 0);
    assert_eq(_t_hpt_static_bad(), 0, "hpack tables: one thread builds the static table whole");
    assert_eq(_t_hpt_huffman_bad(arena_allocator(_t_hpt_arena())), 0, "hpack tables: and the Huffman tables");

    var nt = _t_hpt_threads();
    var th = alloc(nt * 8);
    var spawned = 1;
    _t_hpt_bad = 0;
    var r = 0;
    while (r < _t_hpt_rounds()) {
        _t_hpt_reset();
        _t_hpt_step = (r % 10) * 400;
        atomic_store(&_t_hpt_ready, 0);
        atomic_store(&_t_hpt_go, 0);
        var t = 0;
        while (t < nt) {
            store64(th + t * 8, thread_create(&_t_hpt_worker, t));
            if (load64(th + t * 8) == 0) { spawned = 0; }
            t = t + 1;
        }
        if (spawned == 1) {
            while (atomic_load(&_t_hpt_ready) < nt) { }
        }
        atomic_store(&_t_hpt_go, 1);
        t = 0;
        while (t < nt) {
            if (load64(th + t * 8) != 0) { thread_join(load64(th + t * 8)); }
            t = t + 1;
        }
        if (spawned == 0) { r = _t_hpt_rounds(); }
        r = r + 1;
    }
    if (spawned == 0) { assert_eq(1, 1, "hpack tables: no thread — skipped"); return 0; }
    assert_eq(_t_hpt_bad, 0, "hpack tables: 4 threads x 150 rounds of first use all saw both tables whole");
    assert_eq(_t_hpt_static_bad(), 0, "hpack tables: the static table left published is whole");
    assert_eq(_t_hpt_huffman_bad(arena_allocator(_t_hpt_arena())), 0, "hpack tables: and the Huffman tables");
    return 0;
}

# A Huffman block is whole when every symbol's code and length match the
# reference's and its tree walks each code to that symbol's leaf.
fn _t_hpt_huffman_whole(t, ref): i64 {
    var root = load64(t);
    if (root == 0) { return 0; }
    var sym = 0;
    while (sym < 257) {
        var code = load64(t + 8 + sym * 16);
        var bits = load64(t + 8 + sym * 16 + 8);
        if (code != load64(ref + 8 + sym * 16) || bits != load64(ref + 8 + sym * 16 + 8)) { return 0; }
        var node = root;
        var b = bits - 1;
        while (b >= 0) {
            if (((code >> b) & 1) == 0) { node = load64(node + 0); } else { node = load64(node + 8); }
            if (node == 0) { return 0; }
            b = b - 1;
        }
        if (load64(node + 16) != sym) { return 0; }
        sym = sym + 1;
    }
    return 1;
}

# Both builders fail closed: under every allocation-failure point each answers
# 0 or a whole table, never a partial one. Through 1.13.3 a failed allocation
# in either build was stored unchecked and the next store through it faulted.
fn test_hpack_tables_build_fails_closed() {
    var ref = _hpack_huffman_build_a(default_alloc());
    assert_neq(ref, 0, "huffman build: builds from the global heap");
    var partial_s = 0;
    var whole_s = 0;
    var partial_h = 0;
    var whole_h = 0;
    var k = 0;
    while (k < 520) {
        if (k < 4) {
            var s = _hpack_static_build_a(fail_after_n_allocs(k));
            if (s != 0) {
                if (load64(s) == 61 && streq(load64(s + 8), ":authority") == 1
                  && streq(load64(s + 8 + 60 * 16), "www-authenticate") == 1) {
                    whole_s = whole_s + 1;
                } else {
                    partial_s = partial_s + 1;
                }
            }
        }
        var h = _hpack_huffman_build_a(fail_after_n_allocs(k));
        if (h != 0) {
            if (_t_hpt_huffman_whole(h, ref) == 1) { whole_h = whole_h + 1; } else { partial_h = partial_h + 1; }
        }
        k = k + 1;
    }
    assert_eq(partial_s, 0, "static build: no allocation failure leaves a partial table");
    assert(whole_s > 0, "static build: built once allocations stop failing");
    assert_eq(partial_h, 0, "huffman build: no allocation failure leaves a partial table");
    assert(whole_h > 0, "huffman build: built once allocations stop failing");
    return 0;
}

# 1.13.5 — the TLS session cache under concurrent opens. Once enabled, every TLS
# open looks up, stores and evicts in one process-wide map. Four threads are
# released together onto it, with fake session pointers (freeing one is a no-op
# while libssl is not loaded, as in the rows above). Phase 1: each thread stores
# and reads back its own keys, so every lookup must answer that thread's last
# store; the cache's mutex is forgotten first, so the threads also race to make
# it. Phase 2: a cap of 32 and only new keys, so the cache evicts as it goes.
var _t_sc_ready = 0;
var _t_sc_go = 0;
var _t_sc_phase = 0;
var _t_sc_hosts = 0;
var _t_sc_bad = 0;
var _t_sc_lookups = 0;

fn _t_sc_threads(): i64 { return 4; }
fn _t_sc_keys(): i64 { return 64; }
fn _t_sc_rounds(): i64 { return 40; }

fn _t_sc_host(t, i): i64 { return load64(_t_sc_hosts + (t * _t_sc_keys() + i) * 8); }

fn _t_sc_fake(t, i, j): i64 { return (t + 1) * 1000000 + j * 1000 + i + 1; }

fn _t_sc_worker(arg) {
    var t = arg;
    var bad = 0;
    var looks = 0;
    atomic_fetch_add(&_t_sc_ready, 1);
    while (atomic_load(&_t_sc_go) == 0) { }
    var j = 0;
    while (j < _t_sc_rounds()) {
        var i = 0;
        while (i < _t_sc_keys()) {
            if (_t_sc_phase == 1) {
                sandhi_session_cache_store(_t_sc_host(t, i), 0, 0, _t_sc_fake(t, i, j));
                if (sandhi_session_cache_lookup(_t_sc_host(t, i), 0, 0) != _t_sc_fake(t, i, j)) {
                    bad = bad + 1;
                }
            } else {
                # A new key every time: the round rides in the hook fingerprint.
                sandhi_session_cache_store(_t_sc_host(t, i), j + 1, 0, _t_sc_fake(t, i, j));
                sandhi_session_cache_lookup(_t_sc_host(t, i), j + 1, 0);
            }
            looks = looks + 1;
            i = i + 1;
        }
        j = j + 1;
    }
    atomic_fetch_add(&_t_sc_bad, bad);
    atomic_fetch_add(&_t_sc_lookups, looks);
    return 0;
}

# Run one phase on `_t_sc_threads()` threads. 1, or 0 when a thread could not start.
fn _t_sc_run(phase): i64 {
    var nt = _t_sc_threads();
    var th = alloc(nt * 8);
    var spawned = 1;
    _t_sc_phase = phase;
    atomic_store(&_t_sc_bad, 0);
    atomic_store(&_t_sc_lookups, 0);
    atomic_store(&_t_sc_ready, 0);
    atomic_store(&_t_sc_go, 0);
    var t = 0;
    while (t < nt) {
        store64(th + t * 8, thread_create(&_t_sc_worker, t));
        if (load64(th + t * 8) == 0) { spawned = 0; }
        t = t + 1;
    }
    if (spawned == 1) {
        while (atomic_load(&_t_sc_ready) < nt) { }
    }
    atomic_store(&_t_sc_go, 1);
    t = 0;
    while (t < nt) {
        if (load64(th + t * 8) != 0) { thread_join(load64(th + t * 8)); }
        t = t + 1;
    }
    return spawned;
}

fn test_session_cache_threads() {
    if (THREADS_CONCURRENT != 1) { assert_eq(1, 1, "session cache: no concurrent threads — skipped"); return 0; }
    var nt = _t_sc_threads();
    var nk = _t_sc_keys();
    _t_sc_hosts = alloc(nt * nk * 8);
    var t = 0;
    while (t < nt) {
        var i = 0;
        while (i < nk) {
            var h = alloc(32);
            store8(h, 115);                       # "s"
            var o = _t_h2s_put_int(h, 1, t);
            store8(h + o, 45);                    # "-"
            o = _t_h2s_put_int(h, o + 1, i);
            memcpy(h + o, ".test", 6);
            store64(_t_sc_hosts + (t * nk + i) * 8, h);
            i = i + 1;
        }
        t = t + 1;
    }
    var was_enabled = sandhi_session_cache_enabled();
    sandhi_session_cache_enable(1);
    sandhi_session_cache_clear();
    sandhi_session_cache_reset_stats();
    sandhi_session_cache_set_max_size(100000);

    # Phase 1 — own keys, read back.
    _sandhi_session_cache_mtx = 0;
    if (_t_sc_run(1) == 0) {
        sandhi_session_cache_set_max_size(256);
        sandhi_session_cache_enable(was_enabled);
        assert_eq(1, 1, "session cache: no thread — skipped");
        return 0;
    }
    var total = nt * nk * _t_sc_rounds();
    assert_eq(_t_sc_bad, 0, "session cache: every lookup answered its thread's last store");
    assert_eq(sandhi_session_cache_hit_count(), total, "session cache: every lookup counted as a hit");
    assert_eq(sandhi_session_cache_miss_count(), 0, "session cache: and none as a miss");
    assert_eq(sandhi_session_cache_size(), nt * nk, "session cache: one entry per key");
    var last_bad = 0;
    t = 0;
    while (t < nt) {
        var k = 0;
        while (k < nk) {
            if (sandhi_session_cache_lookup(_t_sc_host(t, k), 0, 0) != _t_sc_fake(t, k, _t_sc_rounds() - 1)) {
                last_bad = last_bad + 1;
            }
            k = k + 1;
        }
        t = t + 1;
    }
    assert_eq(last_bad, 0, "session cache: each key holds its thread's last store");

    # Phase 2 — a cap of 32 and a new key every store.
    sandhi_session_cache_clear();
    sandhi_session_cache_reset_stats();
    sandhi_session_cache_set_max_size(32);
    _t_sc_run(2);
    var size = sandhi_session_cache_size();
    var over = size - 32;
    if (over < 0) { over = 0; }
    assert_eq(over, 0, "session cache: evicting threads keep the cache within its cap (entries over)");
    assert_eq(sandhi_session_cache_evict_count(), total - size,
      "session cache: every key stored is either held or evicted once");
    assert_eq(sandhi_session_cache_hit_count() + sandhi_session_cache_miss_count(), _t_sc_lookups,
      "session cache: every lookup counted once");

    sandhi_session_cache_clear();
    sandhi_session_cache_reset_stats();
    sandhi_session_cache_set_max_size(256);
    sandhi_session_cache_enable(was_enabled);
    return 0;
}

# The cache's lock excludes from the first use. Each round forgets the mutex and
# releases the threads into `_sandhi_session_cache_lock` together, so they race
# to make it; each counts itself inside, and finding another thread there is an
# overlap. Mutation: publishing the mutex by a plain store instead of the CAS
# lets two threads lock rival mutexes.
var _t_scl_inside = 0;
var _t_scl_overlap = 0;

fn _t_scl_worker(arg) {
    atomic_fetch_add(&_t_sc_ready, 1);
    while (atomic_load(&_t_sc_go) == 0) { }
    var mx = _sandhi_session_cache_lock();
    if (mx == 0) { atomic_fetch_add(&_t_scl_overlap, 1); return 0; }
    if (atomic_fetch_add(&_t_scl_inside, 1) != 0) { atomic_fetch_add(&_t_scl_overlap, 1); }
    var spin = 2000;
    while (spin > 0) { spin = spin - 1; }
    atomic_fetch_add(&_t_scl_inside, 0 - 1);
    _sandhi_session_cache_unlock(mx);
    return 0;
}

fn test_session_cache_lock_first_use() {
    if (THREADS_CONCURRENT != 1) { assert_eq(1, 1, "session lock: no concurrent threads — skipped"); return 0; }
    var nt = _t_sc_threads();
    var th = alloc(nt * 8);
    var saved = _sandhi_session_cache_mtx;
    _t_scl_overlap = 0;
    var spawned = 1;
    var r = 0;
    while (r < 200) {
        _sandhi_session_cache_mtx = 0;
        atomic_store(&_t_sc_ready, 0);
        atomic_store(&_t_sc_go, 0);
        var t = 0;
        while (t < nt) {
            store64(th + t * 8, thread_create(&_t_scl_worker, t));
            if (load64(th + t * 8) == 0) { spawned = 0; }
            t = t + 1;
        }
        if (spawned == 1) {
            while (atomic_load(&_t_sc_ready) < nt) { }
        }
        atomic_store(&_t_sc_go, 1);
        t = 0;
        while (t < nt) {
            if (load64(th + t * 8) != 0) { thread_join(load64(th + t * 8)); }
            t = t + 1;
        }
        if (spawned == 0) { r = 200; }
        r = r + 1;
    }
    _sandhi_session_cache_mtx = saved;
    if (spawned == 0) { assert_eq(1, 1, "session lock: no thread — skipped"); return 0; }
    assert_eq(_t_scl_overlap, 0, "session lock: 4 threads x 200 first uses never held it together");
    return 0;
}

# The TLS open installs a cached session under the cache's lock and gets it back
# only when the ctx took it. A ctx that cannot (0 here; every native ctx) gets 0,
# and the entry stays cached.
fn test_session_cache_install_needs_ctx() {
    var was_enabled = sandhi_session_cache_enabled();
    sandhi_session_cache_enable(1);
    sandhi_session_cache_clear();
    sandhi_session_cache_reset_stats();
    sandhi_session_cache_store("install.test", 0, 0, 0xDEADBEEF);
    assert_eq(_sandhi_session_cache_install(0, "install.test", 0, 0), 0,
      "session install: a ctx that cannot take the session gets none back");
    assert_eq(sandhi_session_cache_hit_count(), 1, "session install: the lookup counts as a hit");
    assert_eq(sandhi_session_cache_lookup("install.test", 0, 0), 0xDEADBEEF,
      "session install: the entry stays cached");
    sandhi_session_cache_clear();
    sandhi_session_cache_reset_stats();
    sandhi_session_cache_enable(was_enabled);
    return 0;
}

# 1.13.6 — the session cache builds each key in the caller's frame. Through 1.13.5
# every lookup, install and store built it on the global heap, 160 B a call for the
# life of the process; only a store of a new key needs a copy there now.
fn test_session_cache_key_no_global_heap() {
    var was_enabled = sandhi_session_cache_enabled();
    sandhi_session_cache_enable(1);
    sandhi_session_cache_clear();
    sandhi_session_cache_store("key.example.com", 0, 0, 0xDEADBEEF);
    sandhi_session_cache_lookup("key.example.com", 0, 0);
    var b = alloc_used();
    var i = 0;
    while (i < 100) { sandhi_session_cache_lookup("key.example.com", 0, 0); i = i + 1; }
    assert_eq(alloc_used() - b, 0, "session key: 100 hits keep nothing on the global heap");
    b = alloc_used();
    i = 0;
    while (i < 100) { sandhi_session_cache_lookup("miss.example.com", 7, 9); i = i + 1; }
    assert_eq(alloc_used() - b, 0, "session key: nor 100 misses");
    b = alloc_used();
    i = 0;
    while (i < 100) { _sandhi_session_cache_install(0, "key.example.com", 0, 0); i = i + 1; }
    assert_eq(alloc_used() - b, 0, "session key: nor 100 installs");
    b = alloc_used();
    i = 0;
    while (i < 100) { sandhi_session_cache_store("key.example.com", 0, 0, 0xDEADBEEF); i = i + 1; }
    assert_eq(alloc_used() - b, 0, "session key: nor 100 stores over one key");
    # A new key is copied, so it outlives the caller's buffer.
    sandhi_session_cache_store("new.example.com", 0x1234, 0x5678, 0xCAFEBABE);
    assert_eq(sandhi_session_cache_lookup("new.example.com", 0x1234, 0x5678), 0xCAFEBABE,
      "session key: a new key's entry is found again");
    assert_eq(sandhi_session_cache_lookup("new.example.com", 0x1234, 0x5679), 0,
      "session key: the credential digest still separates keys");
    # A host no DNS name could be is never cached.
    var long_host = alloc(300);
    memset(long_host, 97, 256);
    store8(long_host + 256, 0);
    var n = sandhi_session_cache_size();
    sandhi_session_cache_store(long_host, 0, 0, 0xDEADBEEF);
    assert_eq(sandhi_session_cache_size(), n, "session key: a 256-byte host is not stored");
    assert_eq(sandhi_session_cache_lookup(long_host, 0, 0), 0, "session key: nor found");
    store8(long_host + 255, 0);
    sandhi_session_cache_store(long_host, 0, 0, 0xDEADBEEF);
    assert_eq(sandhi_session_cache_lookup(long_host, 0, 0), 0xDEADBEEF, "session key: a 255-byte host is");
    sandhi_session_cache_clear();
    sandhi_session_cache_reset_stats();
    sandhi_session_cache_enable(was_enabled);
    return 0;
}

# 1.13.6 — each redirect hop's credential digest is computed from the headers that
# hop sends. Through 1.13.5 it was computed once per dispatch, so after a hop to
# another authority (which strips the credentials) the new host's TLS session was
# keyed under the first host's credentials.
fn test_redirect_hop_headers() {
    var a = arena_allocator(65536);
    var ctx = _sandhi_reqctx_new_a(a);
    var h = sandhi_headers_new_a(a);
    sandhi_headers_set_a(a, h, "Authorization", "Bearer t");
    sandhi_headers_set_a(a, h, "Accept", "*/*");
    var d = _sandhi_compute_cred_digest(h);
    store64(ctx + SANDHI_REQCTX_OFF_CRED_DIGEST, d);
    var same = _sandhi_http_hop_headers_a(a, ctx, "https://a.test/x", "https://a.test/y", h);
    assert_eq(same, h, "hop headers: the same authority keeps the headers");
    assert_eq(_sandhi_reqctx_cred(ctx), d, "hop headers: and their digest");
    var other = _sandhi_http_hop_headers_a(a, ctx, "https://a.test/x", "https://b.test/y", h);
    assert_eq(sandhi_headers_get(other, "Authorization"), 0, "hop headers: another authority strips the credentials");
    assert_neq(sandhi_headers_get(other, "Accept"), 0, "hop headers: and keeps the rest");
    assert_eq(_sandhi_reqctx_cred(ctx), 0, "hop headers: and the hop's digest is that of no credentials");
    var bare = _sandhi_http_hop_headers_a(a, 0, "https://a.test/x", "https://b.test/y", h);
    assert_eq(sandhi_headers_get(bare, "Authorization"), 0, "hop headers: with no context, still stripped");
    return 0;
}

# One canned HTTP/1.1 answer: `arg` holds a listening socket and a response; accept
# one connection, read its request head, write the response, close.
var _t_rd_served = 0;

fn _t_rd_serve(arg) {
    var ar_tag, fd = sock_accept(load64(arg));
    if (is_err_result(ar_tag) == 1) { return 0; }
    _sandhi_conn_set_timeout_ms(fd, 2000, _SANDHI_SO_RCVTIMEO);
    var c = _t_h2s_conn(fd);
    var buf = alloc(4097);
    var n = 0;
    while (n < 4096) {
        var got = sandhi_conn_recv(c, buf + n, 4096 - n);
        if (got <= 0) { break; }
        n = n + got;
        store8(buf + n, 0);
        if (strstr(buf, "\r\n\r\n") != 0) { break; }
    }
    var resp = load64(arg + 8);
    sandhi_conn_send_all(c, resp, strlen(resp));
    sock_close(fd);
    atomic_fetch_add(&_t_rd_served, 1);
    return 0;
}

# Append cstr `s` at `off` in `dst` (NUL included); the new end.
fn _t_rd_cat(dst, off, s): i64 {
    var n = strlen(s);
    memcpy(dst + off, s, n + 1);
    return off + n;
}

# A loopback listener on `port`, or -1.
fn _t_rd_listen(port): i64 {
    var lr_tag, lfd = tcp_socket();
    if (is_err_result(lr_tag) == 1) { return 0 - 1; }
    sock_reuse(lfd);
    if (is_err_result(sock_bind(lfd, INADDR_LOOPBACK(), port)) == 1) { sock_close(lfd); return 0 - 1; }
    if (is_err_result(sock_listen(lfd, 4)) == 1) { sock_close(lfd); return 0 - 1; }
    return lfd;
}

# Serve A (302 to B, another port, so another authority) and B (200) on loopback,
# then run `fp(url_a, ctx)`, a redirect driver, with credentials. 1 when the chain
# reached B and left the context holding the digest of no credentials, 0 when it
# did not, -1 when the fixture is unavailable.
var _t_rd_status = 0;

fn _t_rd_chain(port_a, port_b, which): i64 {
    if (THREADS_CONCURRENT != 1) { return 0 - 1; }
    var la = _t_rd_listen(port_a);
    var lb = _t_rd_listen(port_b);
    if (la < 0 || lb < 0) { return 0 - 1; }
    var ra = alloc(256);
    var o = _t_rd_cat(ra, 0, "HTTP/1.1 302 Found\r\nLocation: http://127.0.0.1:");
    o = _t_h2s_put_int(ra, o, port_b);
    _t_rd_cat(ra, o, "/next\r\nContent-Length: 0\r\nConnection: close\r\n\r\n");
    var aa = alloc(16);
    store64(aa, la);
    store64(aa + 8, ra);
    var ab = alloc(16);
    store64(ab, lb);
    store64(ab + 8, "HTTP/1.1 200 OK\r\nContent-Length: 2\r\nConnection: close\r\n\r\nok");
    _t_rd_served = 0;
    var ta = thread_create(&_t_rd_serve, aa);
    var tb = thread_create(&_t_rd_serve, ab);
    if (ta == 0 || tb == 0) { return 0 - 1; }
    var url = alloc(64);
    o = _t_rd_cat(url, 0, "http://127.0.0.1:");
    o = _t_h2s_put_int(url, o, port_a);
    _t_rd_cat(url, o, "/start");
    var a = arena_allocator(1200000);
    var h = sandhi_headers_new_a(a);
    sandhi_headers_set_a(a, h, "Authorization", "Bearer t");
    var ctx = _sandhi_reqctx_new_a(a);
    store64(ctx + SANDHI_REQCTX_OFF_CRED_DIGEST, _sandhi_compute_cred_digest(h));
    var r = 0;
    if (which == 1) {
        r = _sandhi_http_follow_a(a, "GET", url, h, 0, 0, 5, sandhi_http_options_bytes(0),
          2000, 2000, 2000, 0, 0, ctx);
    } else {
        r = _sandhi_http_auto_follow_a(a, "GET", url, h, 0, 0, sandhi_http_options_new(), 5, ctx);
    }
    _t_rd_status = sandhi_http_status(r);
    # Release a listener nobody reached, so its thread can be joined.
    if (atomic_load(&_t_rd_served) < 2) {
        var cr_tag, cfd = tcp_socket();
        if (is_err_result(cr_tag) == 0) { sock_connect(cfd, INADDR_LOOPBACK(), port_b); sock_close(cfd); }
    }
    thread_join(ta);
    thread_join(tb);
    sock_close(la);
    sock_close(lb);
    if (_t_rd_status != 200) { return 0; }
    if (_sandhi_reqctx_cred(ctx) != 0) { return 0; }
    return 1;
}

fn test_redirect_chain_cred_digest() {
    var r1 = _t_rd_chain(39861, 39862, 1);
    if (r1 < 0) {
        assert_eq(1, 1, "redirect digest: loopback or threads unavailable — skipped");
    } else {
        assert_eq(_t_rd_status, 200, "redirect digest: the 1.1 driver followed A's 302 to B");
        assert_eq(r1, 1, "redirect digest: and B's hop was keyed under no credentials");
    }
    var r2 = _t_rd_chain(39863, 39864, 2);
    if (r2 < 0) {
        assert_eq(1, 1, "redirect digest: loopback or threads unavailable — skipped");
    } else {
        assert_eq(_t_rd_status, 200, "redirect digest: the _auto driver followed A's 302 to B");
        assert_eq(r2, 1, "redirect digest: and B's hop was keyed under no credentials");
    }
    return 0;
}

# ----------------------------------------------------------------
# 1.13.6 — HTTP/2 completeness. A scriptable peer on a loopback pair: its own h2
# conn (as a frame codec) and HPACK decode table. It honours the client's
# flow-control windows the way a server does, and grants its own only once they
# are spent, so a client that ignores either stalls or overruns.
# ----------------------------------------------------------------
var _t_hp_peer = 0;
var _t_hp_dec = 0;
var _t_hp_swin_c = 0;      # the client's connection window, as the peer tracks it
var _t_hp_rwin_c = 0;      # the peer's connection window, as granted to the client
var _t_hp_viol = 0;        # DATA the client sent past a window
var _t_hp_maxdata = 0;     # the longest DATA frame the client sent
var _t_hp_cont = 0;        # CONTINUATION frames in the last request
var _t_hp_big = 0;         # the length of the last request's x-big value
var _t_hp_body_len = 0;    # the last request's body length
var _t_hp_body_sum = 0;    # and its byte sum
var _t_hp_requests = 0;    # whole requests read
var _t_hp_eof = 0;         # 1 once the peer saw the client close
var _t_hp_sizes = 0;       # response body sizes, by request
var _t_hp_pa = 0;          # the peer's arena, reset per request, so it keeps off the global heap
var _t_hp_asym = 0;        # 1: stream grants are twice the connection's; 2: the reverse
var _t_hp_pd = 0;          # the peer's decode arena, never reset: through 1.13.5 a decode table kept
# pointers into the arena it decoded with, so the peer's must outlive it

# A loopback pair (`_t_h2s_pair_nd`, no TCP_NODELAY from the test) with a peer on
# the server end. 0, or -1 to skip.
fn _t_hp_setup(port): i64 {
    if (THREADS_CONCURRENT != 1) { return 0 - 1; }
    if (_t_h2s_pair_nd(port, 0) != 0) { return 0 - 1; }
    _t_hp_peer = sandhi_h2_conn_new(_t_h2s_conn(_t_h2s_sfd));
    _t_hp_dec = sandhi_hpack_table_new(0);
    if (_t_hp_pa == 0) { _t_hp_pa = arena_allocator(1200000); }
    if (_t_hp_pd == 0) { _t_hp_pd = arena_allocator(16000000); }
    reset_via(_t_hp_pa);
    _t_hp_swin_c = 65535;
    _t_hp_rwin_c = 65535;
    _t_hp_viol = 0;
    _t_hp_maxdata = 0;
    _t_hp_requests = 0;
    _t_hp_eof = 0;
    _t_hp_asym = 0;
    return 0;
}

fn _t_hp_done(): i64 {
    sock_close(_t_h2s_cfd);
    sock_close(_t_h2s_sfd);
    return 0;
}

fn _t_hp_grant(sid, inc): i64 {
    var p = alloc_via(_t_hp_pa, 4);
    sandhi_h2_window_update_encode(p, 0, inc);
    return sandhi_h2_conn_send_frame_a(_t_hp_pa, _t_hp_peer, SANDHI_H2_FRAME_WINDOW_UPDATE, 0, sid, p, 4);
}

# Read one whole request: its header block (decoded with the peer's table) and
# body. A spent window is granted back only once the client has stopped at it
# (150 ms with nothing arriving); DATA that arrives first lands past the window
# and counts as a violation. Resets the peer's arena first: what the previous
# answer used is done with.
fn _t_hp_read_request(): i64 {
    reset_via(_t_hp_pa);
    var res = alloc_via(_t_hp_pa, 16);
    var blk = alloc_via(_t_hp_pa, 65552);
    var blen = 0;
    var sid = 0;
    var ended = 0;
    var hdone = 0;
    var es = 0;
    var swin = 65535;
    _t_hp_cont = 0;
    _t_hp_big = 0;
    _t_hp_body_len = 0;
    _t_hp_body_sum = 0;
    var waiting = 0;
    while (ended == 0) {
        if (waiting == 1) { _sandhi_conn_set_timeout_ms(_t_h2s_sfd, 150, _SANDHI_SO_RCVTIMEO); }
        var got = sandhi_h2_conn_recv_frame_a(_t_hp_pa, _t_hp_peer, res);
        if (waiting == 1) { _sandhi_conn_set_timeout_ms(_t_h2s_sfd, 2000, _SANDHI_SO_RCVTIMEO); }
        if (got < 0) {
            if (waiting == 0) { return 0 - 1; }
            # The client stopped at the spent window(s): grant them.
            if (_t_hp_rwin_c <= 0) {
                var cg = 65535;
                if (_t_hp_asym == 2) { cg = 131070; }
                _t_hp_grant(0, cg - _t_hp_rwin_c);
                _t_hp_rwin_c = cg;
            }
            if (swin <= 0) {
                var sg = 65535;
                if (_t_hp_asym == 1) { sg = 131070; }
                _t_hp_grant(sid, sg - swin);
                swin = sg;
            }
            waiting = 0;
            continue;
        }
        var hdr = load64(res);
        var pl = load64(res + 8);
        var ty = sandhi_h2_hdr_type(hdr);
        var fl = sandhi_h2_hdr_flags(hdr);
        var n = sandhi_h2_hdr_length(hdr);
        if (ty == SANDHI_H2_FRAME_HEADERS || ty == SANDHI_H2_FRAME_CONTINUATION) {
            if (ty == SANDHI_H2_FRAME_CONTINUATION) { _t_hp_cont = _t_hp_cont + 1; }
            sid = sandhi_h2_hdr_stream_id(hdr);
            if (blen + n <= 65536) { memcpy(blk + blen, pl, n); blen = blen + n; }
            # END_STREAM on HEADERS takes effect once the block is complete.
            if ((fl & SANDHI_H2_FLAG_END_STREAM) != 0) { es = 1; }
            if ((fl & SANDHI_H2_FLAG_END_HEADERS) != 0) { hdone = 1; }
            if (es == 1 && hdone == 1) { ended = 1; }
        } elif (ty == SANDHI_H2_FRAME_DATA) {
            if (n > _t_hp_maxdata) { _t_hp_maxdata = n; }
            var i = 0;
            while (i < n) { _t_hp_body_sum = _t_hp_body_sum + load8(pl + i); i = i + 1; }
            _t_hp_body_len = _t_hp_body_len + n;
            _t_hp_rwin_c = _t_hp_rwin_c - n;
            swin = swin - n;
            if (_t_hp_rwin_c < 0 || swin < 0) { _t_hp_viol = _t_hp_viol + 1; }
            if ((fl & SANDHI_H2_FLAG_END_STREAM) != 0) { ended = 1; }
            if (ended == 0 && (_t_hp_rwin_c <= 0 || swin <= 0)) { waiting = 1; }
            if (ended == 1 && _t_hp_rwin_c <= 0) { _t_hp_grant(0, 65535 - _t_hp_rwin_c); _t_hp_rwin_c = 65535; }
        } elif (ty == SANDHI_H2_FRAME_WINDOW_UPDATE) {
            if (sandhi_h2_hdr_stream_id(hdr) == 0) {
                _t_hp_swin_c = _t_hp_swin_c + sandhi_h2_window_update_decode(pl, 4, 0);
            }
        } elif (ty == SANDHI_H2_FRAME_RST_STREAM) {
            return 0 - 1;
        }
    }
    _t_hp_requests = _t_hp_requests + 1;
    var off = alloc_via(_t_hp_pa, 8);
    var no = alloc_via(_t_hp_pa, 8);
    var vo = alloc_via(_t_hp_pa, 8);
    store64(off, 0);
    while (load64(off) < blen) {
        var r = sandhi_hpack_decode_field_a(_t_hp_pd, _t_hp_dec, blk, blen, off, no, vo);
        if (r < 0) { return 0 - 1; }
        if (r != _SANDHI_HPACK_TBL_UPDATE) {
            if (streq(load64(no), "x-big") == 1) { _t_hp_big = strlen(load64(vo)); }
        }
    }
    return sid;
}

# Answer `sid` with header block `hb` and `body`: DATA in frames of at most
# 16,384 within the client's windows, waiting for its WINDOW_UPDATEs. 0, or -1
# when the client never opened a window (the read timed out).
fn _t_hp_respond(sid, hb, hlen, body, blen): i64 {
    var f = SANDHI_H2_FLAG_END_HEADERS;
    if (blen == 0) { f = f | SANDHI_H2_FLAG_END_STREAM; }
    if (sandhi_h2_conn_send_frame_a(_t_hp_pa, _t_hp_peer, SANDHI_H2_FRAME_HEADERS, f, sid, hb, hlen) < 0) { return 0 - 1; }
    var sw = 65535;
    var off = 0;
    var res = alloc_via(_t_hp_pa, 16);
    while (off < blen) {
        var n = blen - off;
        if (n > 16384) { n = 16384; }
        if (n > _t_hp_swin_c) { n = _t_hp_swin_c; }
        if (n > sw) { n = sw; }
        if (n <= 0) {
            if (sandhi_h2_conn_recv_frame_a(_t_hp_pa, _t_hp_peer, res) < 0) { return 0 - 1; }
            var hdr = load64(res);
            if (sandhi_h2_hdr_type(hdr) == SANDHI_H2_FRAME_WINDOW_UPDATE) {
                var inc = sandhi_h2_window_update_decode(load64(res + 8), 4, 0);
                if (sandhi_h2_hdr_stream_id(hdr) == 0) { _t_hp_swin_c = _t_hp_swin_c + inc; }
                elif (sandhi_h2_hdr_stream_id(hdr) == sid) { sw = sw + inc; }
            }
        } else {
            var fl = 0;
            if (off + n == blen) { fl = SANDHI_H2_FLAG_END_STREAM; }
            if (sandhi_h2_conn_send_frame_a(_t_hp_pa, _t_hp_peer, SANDHI_H2_FRAME_DATA, fl, sid, body + off, n) < 0) {
                return 0 - 1;
            }
            _t_hp_swin_c = _t_hp_swin_c - n;
            sw = sw - n;
            off = off + n;
        }
    }
    return 0;
}

# `n` bytes of a pattern keyed by `k`, from `a`.
fn _t_hp_pattern_a(a, n, k): i64 {
    var b = alloc_via(a, n + 1);
    var i = 0;
    while (i < n) { store8(b + i, (i * 31 + k * 7 + 1) & 255); i = i + 1; }
    store8(b + n, 0);
    return b;
}

fn _t_hp_same(r, n, k): bool {
    if (sandhi_http_body_len(r) != n) { return false; }
    var b = sandhi_http_body(r);
    var i = 0;
    while (i < n) {
        if (load8(b + i) != ((i * 31 + k * 7 + 1) & 255)) { return false; }
        i = i + 1;
    }
    return true;
}

# A response header, or 0 for a failed response (which carries no headers).
fn _t_hp_hdr(r, name): i64 {
    var h = sandhi_http_headers(r);
    if (h == 0) { return 0; }
    return sandhi_headers_get(h, name);
}

# 1 when the response body is the cstr `want` (0 for a failed response).
fn _t_hp_body_is(r, want): bool {
    var b = sandhi_http_body(r);
    if (b == 0) { return false; }
    return streq(b, want) == 1;
}

# 1 when cstr `got` (possibly 0) is `want`.
fn _t_hp_is(got, want): bool {
    if (got == 0) { return false; }
    return streq(got, want) == 1;
}

fn _t_hp_status_block(): i64 {
    var hb = alloc_via(_t_hp_pa, 1);
    store8(hb, 0x88);                    # :status 200 (static index 8)
    return hb;
}

# Wait for the client to close its end: 1 on EOF, 0 on a 1.5 s timeout.
fn _t_hp_await_eof(): i64 {
    _sandhi_conn_set_timeout_ms(_t_h2s_sfd, 1500, _SANDHI_SO_RCVTIMEO);
    var c = _t_h2s_conn(_t_h2s_sfd);
    var buf = alloc_via(_t_hp_pa, 4097);
    loop {
        var n = sandhi_conn_recv(c, buf, 4096);
        if (n == 0) { return 1; }
        if (n < 0) { return 0; }
    }
    return 0;
}

# Answer `arg` requests with a pattern body of `_t_hp_sizes[k]` bytes.
fn _t_hp_peer_bodies(arg) {
    var k = 0;
    while (k < arg) {
        var sid = _t_hp_read_request();
        if (sid < 0) { break; }
        var n = load64(_t_hp_sizes + k * 8);
        if (_t_hp_respond(sid, _t_hp_status_block(), 1, _t_hp_pattern_a(_t_hp_pa, n, k), n) < 0) { break; }
        k = k + 1;
    }
    return 0;
}

# Answer `arg` requests with "<body_len>:<body_sum>:<x-big length>:<CONTINUATION frames>".
fn _t_hp_peer_report(arg) {
    var k = 0;
    while (k < arg) {
        var sid = _t_hp_read_request();
        if (sid < 0) { break; }
        if (k == 0 && _t_hp_sizes != 0) {
            # A SETTINGS frame ahead of the first answer (`_t_hp_sizes` holds it).
            sandhi_h2_conn_send_frame_a(_t_hp_pa, _t_hp_peer, SANDHI_H2_FRAME_SETTINGS, 0, 0, _t_hp_sizes, 6);
        }
        var out = alloc_via(_t_hp_pa, 96);
        var o = _t_h2s_put_int(out, 0, _t_hp_body_len);
        store8(out + o, 58);
        o = _t_h2s_put_int(out, o + 1, _t_hp_body_sum);
        store8(out + o, 58);
        o = _t_h2s_put_int(out, o + 1, _t_hp_big);
        store8(out + o, 58);
        _t_h2s_put_int(out, o + 1, _t_hp_cont);
        if (_t_hp_respond(sid, _t_hp_status_block(), 1, out, strlen(out)) < 0) { break; }
        k = k + 1;
    }
    return 0;
}

# The response rows. Through 1.13.5 sandhi never sent WINDOW_UPDATE: a conn
# stalled once its responses added up to the peer's 65,535-octet connection
# window (measured live at 1.13.1), and one response over the stream window
# stalled alone.
fn test_h2_flow_control_recv() {
    if (_t_hp_setup(39870) != 0) { assert_eq(1, 1, "h2 flow: loopback or threads unavailable — skipped"); return 0; }
    var h2c = sandhi_h2_conn_new(_t_h2s_conn(_t_h2s_cfd));
    _t_hp_sizes = alloc(24);
    store64(_t_hp_sizes, 56000);
    store64(_t_hp_sizes + 8, 56000);
    store64(_t_hp_sizes + 16, 200000);
    var peer = thread_create(&_t_hp_peer_bodies, 3);
    var a = arena_allocator(2400000);
    var ok = 0;
    var k = 0;
    while (k < 3) {
        var r = sandhi_h2_request_a(a, h2c, "GET", "http://h2.test/b", 0, 0, 0);
        if (sandhi_http_status(r) == 200 && _t_hp_same(r, load64(_t_hp_sizes + k * 8), k) == 1) { ok = ok + 1; }
        reset_via(a);
        k = k + 1;
    }
    thread_join(peer);
    _t_hp_done();
    _t_hp_sizes = 0;
    assert_eq(ok, 3, "h2 flow: 56,000 + 56,000 + 200,000 B answers all arrive on one conn");
    return 0;
}

# The request rows. Through 1.13.5 a body over one frame (16,384) was refused,
# the peer's windows were never consulted, and a header block over 8 KB was
# refused.
fn test_h2_request_body_and_headers() {
    if (_t_hp_setup(39871) != 0) { assert_eq(1, 1, "h2 send: loopback or threads unavailable — skipped"); return 0; }
    var h2c = sandhi_h2_conn_new(_t_h2s_conn(_t_h2s_cfd));
    _t_hp_sizes = 0;
    var peer = thread_create(&_t_hp_peer_report, 3);
    var a = arena_allocator(2400000);
    var body = _t_hp_pattern_a(default_alloc(), 150000, 3);
    var sum = 0;
    var i = 0;
    while (i < 150000) { sum = sum + load8(body + i); i = i + 1; }
    var want = alloc(64);
    var o = _t_rd_cat(want, 0, "150000:");
    o = _t_h2s_put_int(want, o, sum);
    _t_rd_cat(want, o, ":0:0");
    # Two bodies: the first while the peer grants its stream window twice what it
    # grants the connection, the second the reverse, so neither window can stand
    # in for the other.
    var ok = 0;
    var asym = 1;
    while (asym <= 2) {
        _t_hp_asym = asym;
        var r0 = sandhi_h2_request_a(a, h2c, "POST", "http://h2.test/up", 0, body, 150000);
        if (sandhi_http_status(r0) == 200 && _t_hp_body_is(r0, want) == 1) { ok = ok + 1; }
        reset_via(a);
        asym = asym + 1;
    }
    assert_eq(ok, 2, "h2 send: two 150,000 B bodies are accepted, and arrive whole");
    assert(_t_hp_maxdata <= 16384, "h2 send: in DATA frames of at most the peer's MAX_FRAME_SIZE");
    assert_eq(_t_hp_viol, 0, "h2 send: never past the peer's connection or stream window");
    _t_hp_asym = 0;
    var r = 0;
    var h = sandhi_headers_new_a(a);
    var big = alloc(40001);
    memset(big, 113, 40000);
    store8(big + 40000, 0);
    sandhi_headers_set_a(a, h, "X-Big", big);
    r = sandhi_h2_request_a(a, h2c, "GET", "http://h2.test/big", h, 0, 0);
    assert_eq(sandhi_http_status(r), 200, "h2 send: a 40,000 B header is sent");
    assert_eq(_t_hp_body_is(r, "0:0:40000:2"), 1,
      "h2 send: whole, as HEADERS + 2 CONTINUATION frames");
    thread_join(peer);
    _t_hp_done();
    return 0;
}

# The peer's SETTINGS_MAX_HEADER_LIST_SIZE is enforced before sending: a larger
# list is refused locally, and the conn carries on.
fn test_h2_max_header_list() {
    if (_t_hp_setup(39872) != 0) { assert_eq(1, 1, "h2 hdr list: loopback or threads unavailable — skipped"); return 0; }
    var h2c = sandhi_h2_conn_new(_t_h2s_conn(_t_h2s_cfd));
    _t_hp_sizes = alloc(8);
    sandhi_h2_settings_pair_encode(_t_hp_sizes, 0, SANDHI_H2_SETTINGS_MAX_HEADER_LIST_SIZE, 600);
    var peer = thread_create(&_t_hp_peer_report, 2);
    var a = arena_allocator(2400000);
    var r1 = sandhi_h2_request_a(a, h2c, "GET", "http://h2.test/1", 0, 0, 0);
    assert_eq(sandhi_http_status(r1), 200, "h2 hdr list: the first request answers");
    var h = sandhi_headers_new_a(a);
    var big = alloc(1001);
    memset(big, 113, 1000);
    store8(big + 1000, 0);
    sandhi_headers_set_a(a, h, "X-Big", big);
    var r2 = sandhi_h2_request_a(a, h2c, "GET", "http://h2.test/2", h, 0, 0);
    assert_eq(sandhi_http_err_kind(r2), SANDHI_ERR_PROTOCOL, "h2 hdr list: a list over the peer's 600 is refused");
    assert_neq(sandhi_http_err_message(r2), 0, "h2 hdr list: and says why");
    var r3 = sandhi_h2_request_a(a, h2c, "GET", "http://h2.test/3", 0, 0, 0);
    assert_eq(sandhi_http_status(r3), 200, "h2 hdr list: the conn carries on");
    thread_join(peer);
    assert_eq(_t_hp_requests, 2, "h2 hdr list: the refused request never reached the peer");
    _t_hp_done();
    _t_hp_sizes = 0;
    return 0;
}

# Answer two requests: the first adds `x-tag: alpha` to the client's decode table
# (literal with incremental indexing), the second names it by index 62. With
# `arg` 1 the peer first advertises SETTINGS_HEADER_TABLE_SIZE 0.
fn _t_hp_peer_tag(arg) {
    var sid = _t_hp_read_request();
    if (sid < 0) { return 0; }
    if (arg == 1) {
        var sp = alloc_via(_t_hp_pa, 8);
        sandhi_h2_settings_pair_encode(sp, 0, SANDHI_H2_SETTINGS_HEADER_TABLE_SIZE, 0);
        sandhi_h2_conn_send_frame_a(_t_hp_pa, _t_hp_peer, SANDHI_H2_FRAME_SETTINGS, 0, 0, sp, 6);
    }
    var hb = alloc_via(_t_hp_pa, 16);
    store8(hb, 0x88);
    store8(hb + 1, 0x40);
    store8(hb + 2, 5);
    memcpy(hb + 3, "x-tag", 5);
    store8(hb + 8, 5);
    memcpy(hb + 9, "alpha", 5);
    if (_t_hp_respond(sid, hb, 14, 0, 0) < 0) { return 0; }
    sid = _t_hp_read_request();
    if (sid < 0) { return 0; }
    var hb2 = alloc_via(_t_hp_pa, 2);
    store8(hb2, 0x88);
    store8(hb2 + 1, 0xBE);               # index 62: the newest dynamic entry
    _t_hp_respond(sid, hb2, 2, 0, 0);
    return 0;
}

# The client's decode table outlives the request that filled it. Through 1.13.5
# the table held the decoded strings in the request's arena, and rebuilt its vecs
# there, so after the arena was reset the next response read reused memory.
fn test_h2_decode_table_survives_arena_reset() {
    if (_t_hp_setup(39873) != 0) { assert_eq(1, 1, "h2 dec table: loopback or threads unavailable — skipped"); return 0; }
    var h2c = sandhi_h2_conn_new(_t_h2s_conn(_t_h2s_cfd));
    var peer = thread_create(&_t_hp_peer_tag, 0);
    var a = arena_allocator(2400000);
    var r1 = sandhi_h2_request_a(a, h2c, "GET", "http://h2.test/1", 0, 0, 0);
    assert_eq(_t_hp_is(_t_hp_hdr(r1, "x-tag"), "alpha"), 1, "h2 dec table: the first answer carries x-tag");
    reset_via(a);
    var junk = alloc_via(a, 2300000);
    memset(junk, 90, 2300000);
    reset_via(a);
    var r2 = sandhi_h2_request_a(a, h2c, "GET", "http://h2.test/2", 0, 0, 0);
    assert_eq(sandhi_http_status(r2), 200, "h2 dec table: after the arena is reset and overwritten, the next answer decodes");
    assert_eq(_t_hp_is(_t_hp_hdr(r2, "x-tag"), "alpha"), 1, "h2 dec table: and index 62 still names x-tag: alpha");
    thread_join(peer);
    _t_hp_done();
    return 0;
}

# The peer's SETTINGS_HEADER_TABLE_SIZE bounds sandhi's encoder, not its
# decoder. Through 1.13.5 a peer advertising 0 emptied sandhi's decode table, and
# the entries the peer's encoder then referenced were gone.
fn test_h2_peer_header_table_size() {
    if (_t_hp_setup(39874) != 0) { assert_eq(1, 1, "h2 table size: loopback or threads unavailable — skipped"); return 0; }
    var h2c = sandhi_h2_conn_new(_t_h2s_conn(_t_h2s_cfd));
    var peer = thread_create(&_t_hp_peer_tag, 1);
    var a = arena_allocator(2400000);
    sandhi_h2_request_a(a, h2c, "GET", "http://h2.test/1", 0, 0, 0);
    var r2 = sandhi_h2_request_a(a, h2c, "GET", "http://h2.test/2", 0, 0, 0);
    assert_eq(_t_hp_is(_t_hp_hdr(r2, "x-tag"), "alpha"), 1,
      "h2 table size: a peer advertising HEADER_TABLE_SIZE 0 is still decoded");
    assert_eq(sandhi_hpack_table_max_size(sandhi_h2_conn_enc_table(h2c)), 0,
      "h2 table size: the setting caps sandhi's encoder table");
    thread_join(peer);
    _t_hp_done();
    return 0;
}

# Read one request, then stall (`arg` 0: HEADERS, no END_STREAM, then silence) or
# send GOAWAY (`arg` 1), and wait for the client to close the conn.
fn _t_hp_peer_fail(arg) {
    var sid = _t_hp_read_request();
    if (sid < 0) { return 0; }
    if (arg == 0) {
        sandhi_h2_conn_send_frame_a(_t_hp_pa, _t_hp_peer, SANDHI_H2_FRAME_HEADERS, SANDHI_H2_FLAG_END_HEADERS, sid,
          _t_hp_status_block(), 1);
    } else {
        var g = alloc_via(_t_hp_pa, 8);
        sandhi_h2_goaway_encode(g, 0, 0, 0, 0, 0);
        sandhi_h2_conn_send_frame_a(_t_hp_pa, _t_hp_peer, SANDHI_H2_FRAME_GOAWAY, 0, 0, g, 8);
    }
    _t_hp_eof = _t_hp_await_eof();
    return 0;
}

# A failed exchange retires its conn, and a retired conn is closed. Through 1.13.5
# a conn whose exchange timed out stayed pooled mid-stream (its next exchange
# would skip the stream's late frames, HEADERS among them, and its HPACK decoder
# would drift), and a conn dropped for GOAWAY was never closed. The `_auto` path
# also applies the request's own read_ms (300 here) where it used the opener's
# (2,000).
fn test_h2_failed_exchange_retired() {
    var which = 0;
    while (which < 2) {
        if (_t_hp_setup(39875 + which) != 0) { assert_eq(1, 1, "h2 retire: loopback or threads unavailable — skipped"); return 0; }
        var h2c = sandhi_h2_conn_new(_t_h2s_conn(_t_h2s_cfd));
        var pool = sandhi_http_pool_new(8, 90000);
        sandhi_http_pool_put_h2(pool, "h2.test", 80, 0, h2c);
        var opts = sandhi_http_options_new();
        sandhi_http_options_pool(opts, pool);
        sandhi_http_options_read_ms(opts, 300);
        var peer = thread_create(&_t_hp_peer_fail, which);
        var a = arena_allocator(2400000);
        var t0 = clock_now_ms();
        var r = sandhi_http_request_auto_a(a, "GET", "http://h2.test/x", 0, 0, 0, opts);
        var el = clock_now_ms() - t0;
        if (which == 0) {
            assert_eq(sandhi_http_err_kind(r), SANDHI_ERR_TIMEOUT, "h2 retire: a stalled answer times out");
            assert(el < 1500, "h2 retire: on the request's own read_ms, not the opener's");
        } else {
            assert_eq(sandhi_http_err_kind(r), SANDHI_ERR_REMOTE, "h2 retire: a GOAWAY fails the exchange");
        }
        # The exchange itself closes the conn: the peer sees EOF before any take.
        thread_join(peer);
        assert_eq(_t_hp_eof, 1, "h2 retire: the failed exchange closes the conn's socket");
        assert_eq(sandhi_http_pool_take_h2(pool, "h2.test", 80, 0), 0, "h2 retire: and the conn leaves the pool");
        sock_close(_t_h2s_sfd);
        which = which + 1;
    }
    # A pooled conn flagged for GOAWAY outside an exchange is closed by the take
    # that drops it.
    if (_t_hp_setup(39883) != 0) { return 0; }
    var gc = sandhi_h2_conn_new(_t_h2s_conn(_t_h2s_cfd));
    var gp = sandhi_http_pool_new(8, 90000);
    sandhi_http_pool_put_h2(gp, "h2.test", 80, 0, gc);
    store64(gc + SANDHI_H2_CONN_OFF_GOAWAY, 1);
    assert_eq(sandhi_http_pool_take_h2(gp, "h2.test", 80, 0), 0, "h2 retire: a GOAWAY'd conn leaves the pool");
    assert_eq(_t_hp_await_eof(), 1, "h2 retire: and the take closes it");
    sock_close(_t_h2s_sfd);
    return 0;
}

# 1.13.7 (CYRIUS-2026-0044) — a server's HPACK cannot amplify a response. The
# peer fills the client's 4096 decode table with one 4,033-octet entry, answers
# with 15 references to it (60 KB decoded: under the bound), then with a 16 KiB
# block of 16,383 one-byte references. Through 1.13.6 that block decoded into
# 16,383 headers, 135 MB on the default allocator; past 65,536 octets of header
# list it now fails the exchange. `arg` 1 answers instead with a size update to
# 2^28 ahead of :status, which through 1.13.6 was applied.
fn _t_hp_peer_amplify(arg) {
    var sid = _t_hp_read_request();
    if (sid < 0) { return 0; }
    var hb = alloc_via(_t_hp_pa, 16400);
    if (arg == 1) {
        var n = sandhi_hpack_encode_table_size_update(hb, 0, 0x10000000);
        store8(hb + n, 0x88);
        _t_hp_respond(sid, hb, n + 1, 0, 0);
        return 0;
    }
    store8(hb, 0x88);                    # :status 200
    store8(hb + 1, 0x40);                # literal with incremental indexing, new name
    store8(hb + 2, 1);                   # name: 1 octet, raw
    store8(hb + 3, 120);                 # "x"
    store8(hb + 4, 0x7f);                # value: 127 + 3,873 = 4,000 octets, raw
    store8(hb + 5, (3873 & 0x7f) | 0x80);
    store8(hb + 6, 3873 >> 7);
    memset(hb + 7, 97, 4000);
    _t_hp_respond(sid, hb, 4007, 0, 0);
    sid = _t_hp_read_request();
    if (sid < 0) { return 0; }
    hb = alloc_via(_t_hp_pa, 16400);
    store8(hb, 0x88);
    memset(hb + 1, 0xBE, 15);            # index 62: the entry
    _t_hp_respond(sid, hb, 16, 0, 0);
    sid = _t_hp_read_request();
    if (sid < 0) { return 0; }
    hb = alloc_via(_t_hp_pa, 16400);
    store8(hb, 0x88);
    memset(hb + 1, 0xBE, 16383);
    _t_hp_respond(sid, hb, 16384, 0, 0);
    return 0;
}

fn test_h2_response_hpack_bounded() {
    if (_t_hp_setup(39884) != 0) { assert_eq(1, 1, "h2 hpack bound: loopback or threads unavailable — skipped"); return 0; }
    var h2c = sandhi_h2_conn_new(_t_h2s_conn(_t_h2s_cfd));
    var peer = thread_create(&_t_hp_peer_amplify, 0);
    var a = arena_allocator(4000000);
    var r1 = sandhi_h2_request_a(a, h2c, "GET", "http://h2.test/1", 0, 0, 0);
    assert_eq(sandhi_http_status(r1), 200, "h2 hpack bound: the entry's response decodes");
    var r2 = sandhi_h2_request_a(a, h2c, "GET", "http://h2.test/2", 0, 0, 0);
    assert_eq(sandhi_http_status(r2), 200, "h2 hpack bound: 15 references (60 KB) decode");
    var h2 = sandhi_http_headers(r2);
    var n2 = 0;
    if (h2 != 0) { n2 = sandhi_headers_count(h2); }
    assert_eq(n2, 15, "h2 hpack bound: into 15 headers");
    var r3 = sandhi_h2_request_a(a, h2c, "GET", "http://h2.test/3", 0, 0, 0);
    assert_eq(sandhi_http_err_kind(r3), SANDHI_ERR_PROTOCOL, "h2 hpack bound: 16,383 references fail the exchange");
    assert_eq(_t_hp_is(sandhi_http_err_message(r3), "h2: the response header list exceeds 65536 octets"), true,
      "h2 hpack bound: and say why");
    thread_join(peer);
    _t_hp_done();

    if (_t_hp_setup(39885) != 0) { return 0; }
    var h2b = sandhi_h2_conn_new(_t_h2s_conn(_t_h2s_cfd));
    var peer2 = thread_create(&_t_hp_peer_amplify, 1);
    var a2 = arena_allocator(2400000);
    var r4 = sandhi_h2_request_a(a2, h2b, "GET", "http://h2.test/4", 0, 0, 0);
    assert_eq(sandhi_http_err_kind(r4), SANDHI_ERR_PROTOCOL, "h2 hpack bound: a size update to 2^28 fails the exchange");
    assert_eq(sandhi_hpack_table_max_size(sandhi_h2_conn_dec_table(h2b)), 4096,
      "h2 hpack bound: and leaves the decode table at 4096");
    thread_join(peer2);
    _t_hp_done();
    return 0;
}

# A HEADERS frame's padding and priority fields are not part of its header block
# (RFC 7540 §6.2). Through 1.13.5 the whole payload was decoded as the block.
fn _t_hp_peer_padded(arg) {
    var sid = _t_hp_read_request();
    if (sid < 0) { return 0; }
    var pl = alloc_via(_t_hp_pa, 10);
    memset(pl, 0, 10);
    store8(pl, 3);                       # pad length
    store8(pl + 5, 16);                  # priority weight (the dependency is 0)
    store8(pl + 6, 0x88);                # the block: :status 200
    sandhi_h2_conn_send_frame_a(_t_hp_pa, _t_hp_peer, SANDHI_H2_FRAME_HEADERS,
      SANDHI_H2_FLAG_END_HEADERS | SANDHI_H2_FLAG_END_STREAM | SANDHI_H2_FLAG_PADDED | SANDHI_H2_FLAG_PRIORITY,
      sid, pl, 10);
    sid = _t_hp_read_request();
    if (sid < 0) { return 0; }
    # A PUSH_PROMISE, which sandhi's SETTINGS turn off, then an answer.
    var pp = alloc_via(_t_hp_pa, 5);
    memset(pp, 0, 5);
    store8(pp + 3, 2);                   # promised stream 2
    store8(pp + 4, 0x82);                # its block: :method GET
    sandhi_h2_conn_send_frame_a(_t_hp_pa, _t_hp_peer, SANDHI_H2_FRAME_PUSH_PROMISE, SANDHI_H2_FLAG_END_HEADERS, sid, pp, 5);
    _t_hp_respond(sid, _t_hp_status_block(), 1, 0, 0);
    return 0;
}

fn test_h2_headers_padding_and_push() {
    if (_t_hp_setup(39877) != 0) { assert_eq(1, 1, "h2 padded: loopback or threads unavailable — skipped"); return 0; }
    var h2c = sandhi_h2_conn_new(_t_h2s_conn(_t_h2s_cfd));
    var peer = thread_create(&_t_hp_peer_padded, 0);
    var a = arena_allocator(2400000);
    var r1 = sandhi_h2_request_a(a, h2c, "GET", "http://h2.test/1", 0, 0, 0);
    assert_eq(sandhi_http_status(r1), 200, "h2 padded: a padded HEADERS with a priority block decodes");
    var r2 = sandhi_h2_request_a(a, h2c, "GET", "http://h2.test/2", 0, 0, 0);
    assert_eq(sandhi_http_err_kind(r2), SANDHI_ERR_PROTOCOL, "h2 push: a PUSH_PROMISE fails the exchange");
    thread_join(peer);
    _t_hp_done();
    return 0;
}

# The client's preface SETTINGS turn push off (ENABLE_PUSH 0); through 1.13.5
# they were empty, which leaves push on.
fn test_h2_preface_disables_push() {
    if (_t_hp_setup(39878) != 0) { assert_eq(1, 1, "h2 preface: loopback or threads unavailable — skipped"); return 0; }
    var h2c = sandhi_h2_conn_new(_t_h2s_conn(_t_h2s_cfd));
    sandhi_h2_conn_send_preface_and_settings(h2c);
    var buf = alloc(64);
    sandhi_conn_recv_all(_t_h2s_conn(_t_h2s_sfd), buf, 24);
    var res = alloc(16);
    sandhi_h2_conn_recv_frame(_t_hp_peer, res);
    var hdr = load64(res);
    assert_eq(sandhi_h2_hdr_type(hdr), SANDHI_H2_FRAME_SETTINGS, "h2 preface: SETTINGS follow the preface");
    assert_eq(sandhi_h2_hdr_length(hdr), 6, "h2 preface: with one setting");
    var idc = alloc(8);
    var vc = alloc(8);
    store64(idc, 0 - 1);
    store64(vc, 0 - 1);
    if (sandhi_h2_hdr_length(hdr) == 6) { sandhi_h2_settings_pair_decode(load64(res + 8), 6, 0, idc, vc); }
    assert_eq(load64(idc), SANDHI_H2_SETTINGS_ENABLE_PUSH, "h2 preface: ENABLE_PUSH");
    assert_eq(load64(vc), 0, "h2 preface: set to 0");
    _t_hp_done();
    return 0;
}

# SETTINGS the spec makes a connection error are refused, and leave the conn as
# it was. Through 1.13.5 a MAX_FRAME_SIZE of 100 (or 0) was applied, and every
# later frame with a larger payload was refused.
fn test_h2_settings_validated() {
    var c = sandhi_h2_conn_new(0);
    var pl = alloc(16);
    sandhi_h2_settings_pair_encode(pl, 0, SANDHI_H2_SETTINGS_MAX_FRAME_SIZE, 100);
    assert(sandhi_h2_conn_apply_settings_payload(c, pl, 6) < 0, "h2 settings: MAX_FRAME_SIZE 100 is refused");
    assert_eq(sandhi_h2_conn_peer_max_frame(c), 16384, "h2 settings: and the frame size stays 16,384");
    sandhi_h2_settings_pair_encode(pl, 0, SANDHI_H2_SETTINGS_INITIAL_WINDOW_SIZE, 0x80000000);
    assert(sandhi_h2_conn_apply_settings_payload(c, pl, 6) < 0, "h2 settings: a window over 2^31-1 is refused");
    sandhi_h2_settings_pair_encode(pl, 0, SANDHI_H2_SETTINGS_HEADER_TABLE_SIZE, 0);
    sandhi_h2_conn_apply_settings_payload(c, pl, 6);
    assert_eq(sandhi_hpack_table_max_size(sandhi_h2_conn_dec_table(c)), 4096,
      "h2 settings: HEADER_TABLE_SIZE leaves the decode table at sandhi's own 4,096");
    return 0;
}

# A decoded field is the caller's copy: evicting its table entry (whose block is
# freed, and here reused) leaves it intact. Since 1.13.6 the table frees an
# evicted entry's block, so an indexed field can no longer be handed out as the
# table's own pointer, as it was through 1.13.5 (when nothing was ever freed).
fn test_hpack_decode_outputs_owned() {
    var t = sandhi_hpack_table_new(200);
    sandhi_hpack_table_add(t, "x-tag", "alpha");
    var blk = alloc(2);
    store8(blk, 0xBE);                   # index 62: x-tag: alpha
    var off = alloc(8);
    var no = alloc(8);
    var vo = alloc(8);
    store64(off, 0);
    var a = arena_allocator(4096);
    assert_eq(sandhi_hpack_decode_field_a(a, t, blk, 1, off, no, vo), 0, "hpack own: index 62 decodes");
    var big = alloc(200);
    memset(big, 122, 150);
    store8(big + 150, 0);
    sandhi_hpack_table_add(t, "x-big", big);   # evicts x-tag (200 is the cap)
    var i = 0;
    while (i < 8) { memset(fl_alloc(10), 90, 10); i = i + 1; }
    assert_eq(_t_hp_is(load64(no), "x-tag"), 1, "hpack own: the decoded name outlives its evicted entry");
    assert_eq(_t_hp_is(load64(vo), "alpha"), 1, "hpack own: and so does the value");
    return 0;
}

# A canary allocator: each block is followed by 8 bytes of 0xC5, so a write past
# a block's end shows. `_t_cy_big` is the largest block asked for.
var _t_cy_list = 0;
var _t_cy_big = 0;

fn _t_cy_alloc(state, size): i64 {
    var p = alloc(size + 8);
    if (p == 0) { return 0; }
    memset(p + size, 197, 8);
    vec_push(_t_cy_list, p);
    vec_push(_t_cy_list, size);
    if (size > _t_cy_big) { _t_cy_big = size; }
    return p;
}

fn _t_cy_realloc(state, old, osz, nsz): i64 { return _t_cy_alloc(state, nsz); }
fn _t_cy_free(state, p): i64 { return 0; }
fn _t_cy_reset(state): i64 { return 0; }

fn _t_cy_overruns(): i64 {
    var bad = 0;
    var i = 0;
    while (i < vec_len(_t_cy_list)) {
        var p = vec_get(_t_cy_list, i);
        var n = vec_get(_t_cy_list, i + 1);
        var j = 0;
        while (j < 8) {
            if (load8(p + n + j) != 197) { bad = bad + 1; j = 8; }
            j = j + 1;
        }
        i = i + 2;
    }
    return bad;
}

# Frame reads stay inside their buffers, and refuse a frame longer than sandhi
# advertises. Through 1.13.5 the 9-byte header buffer and an exactly-sized payload
# buffer each took a NUL one past their end, and a 20,000-octet frame (sandhi
# never raises MAX_FRAME_SIZE from 16,384) was read whole.
fn test_h2_recv_frame_bounds() {
    if (_t_hp_setup(39879) != 0) { assert_eq(1, 1, "h2 frame read: loopback unavailable — skipped"); return 0; }
    var h2c = sandhi_h2_conn_new(_t_h2s_conn(_t_h2s_cfd));
    _t_cy_list = vec_new();
    _t_cy_big = 0;
    var cy = allocator_new(&_t_cy_alloc, &_t_cy_realloc, &_t_cy_free, &_t_cy_reset, 0);
    var sc = _t_h2s_conn(_t_h2s_sfd);
    var fr = alloc(20016);
    memset(fr, 0, 20016);
    sandhi_h2_hdr_encode(fr, 0, 8, SANDHI_H2_FRAME_PING, 0, 0);
    sandhi_conn_send_all(sc, fr, 17);
    sandhi_h2_hdr_encode(fr, 0, 16, SANDHI_H2_FRAME_DATA, 0, 1);
    sandhi_conn_send_all(sc, fr, 25);
    var res = alloc(16);
    assert_eq(sandhi_h2_conn_recv_frame_a(cy, h2c, res), 17, "h2 frame read: an 8-octet frame");
    assert_eq(sandhi_h2_conn_recv_frame_a(cy, h2c, res), 25, "h2 frame read: a 16-octet frame");
    assert_eq(_t_cy_overruns(), 0, "h2 frame read: no byte written past a buffer");
    sandhi_h2_hdr_encode(fr, 0, 20000, SANDHI_H2_FRAME_DATA, 0, 1);
    sandhi_conn_send_all(sc, fr, 20009);
    assert(sandhi_h2_conn_recv_frame_a(cy, h2c, res) < 0, "h2 frame read: a 20,000-octet frame is refused");
    assert(_t_cy_big < 20000, "h2 frame read: before its payload is allocated");
    _t_hp_done();
    return 0;
}

# Each frame is one write (one packet on a SOCK_SEQPACKET pair, which keeps write
# boundaries). Through 1.13.5 the header and payload were two writes, and with
# Nagle on a request's second write waited for the delayed ACK of its first.
fn test_h2_frame_one_write() {
    var fds[16];
    if (sys_socketpair(1, 5, 0, &fds) != 0) { assert_eq(1, 1, "h2 one write: SOCK_SEQPACKET unavailable — skipped"); return 0; }
    var cfd = load32(&fds);
    var sfd = load32(&fds + 4);
    var h2c = sandhi_h2_conn_new(_t_h2s_conn(cfd));
    var a = arena_allocator(65536);
    sandhi_h2_conn_send_frame_a(a, h2c, SANDHI_H2_FRAME_PING, 0, 0, "12345678", 8);
    var body = _t_hp_pattern_a(default_alloc(), 3000, 1);
    sandhi_h2_conn_send_frame_a(a, h2c, SANDHI_H2_FRAME_DATA, 0, 1, body, 3000);
    _sandhi_conn_set_timeout_ms(sfd, 1000, _SANDHI_SO_RCVTIMEO);
    var sc = _t_h2s_conn(sfd);
    var buf = alloc(65536);
    assert_eq(sandhi_conn_recv(sc, buf, 65536), 17, "h2 one write: a PING is one 17-octet write");
    assert_eq(sandhi_conn_recv(sc, buf, 65536), 3009, "h2 one write: a 3,000-octet DATA frame is one write");
    sock_close(cfd);
    sock_close(sfd);
    return 0;
}

# Twenty exchanges on a pair with no TCP_NODELAY from the test: the h2 conn sets
# its own. Through 1.13.5 each took about 80 ms over loopback (measured at 1.13.3).
fn test_h2_exchange_latency() {
    if (_t_hp_setup(39880) != 0) { assert_eq(1, 1, "h2 latency: loopback or threads unavailable — skipped"); return 0; }
    var h2c = sandhi_h2_conn_new(_t_h2s_conn(_t_h2s_cfd));
    _t_hp_sizes = alloc(20 * 8);
    var k = 0;
    while (k < 20) { store64(_t_hp_sizes + k * 8, 2); k = k + 1; }
    var peer = thread_create(&_t_hp_peer_bodies, 20);
    var a = arena_allocator(2400000);
    var ok = 0;
    var t0 = clock_now_ms();
    k = 0;
    while (k < 20) {
        var r = sandhi_h2_request_a(a, h2c, "GET", "http://h2.test/n", 0, 0, 0);
        if (sandhi_http_status(r) == 200) { ok = ok + 1; }
        reset_via(a);
        k = k + 1;
    }
    var el = clock_now_ms() - t0;
    thread_join(peer);
    _t_hp_done();
    _t_hp_sizes = 0;
    assert_eq(ok, 20, "h2 latency: twenty exchanges answer");
    assert(el < 600, "h2 latency: in under 600 ms (about 1,600 through 1.13.5)");
    return 0;
}

# Exchanges on a reset arena keep nothing on the global heap. Measured at 1.13.3:
# ten GETs grew it by 42,992 B (frame I/O on the global heap, and every request
# field inserted into the encoder table). Then 120 answers that each add a fresh
# 230-octet header to the decode table, so it evicts as it goes: past the first 40
# (the table's vecs reach their size), neither the global heap nor the freelist
# arena the table's entries live in may grow.
var _t_hp_churn = 0;

# Decimal `n` at `buf + off` without allocating (unlike `_t_h2s_put_int`); the end.
fn _t_hp_put_int(buf, off, n): i64 {
    var digits = 1;
    var v = n;
    while (v >= 10) { v = v / 10; digits = digits + 1; }
    var i = digits - 1;
    v = n;
    while (i >= 0) { store8(buf + off + i, 48 + v % 10); v = v / 10; i = i - 1; }
    return off + digits;
}

fn _t_hp_peer_churn(arg) {
    var k = 0;
    while (k < arg) {
        var sid = _t_hp_read_request();
        if (sid < 0) { break; }
        var hlen = 1;
        var hb = alloc_via(_t_hp_pa, 256);
        store8(hb, 0x88);
        if (_t_hp_churn == 1) {
            store8(hb + 1, 0x40);
            store8(hb + 2, 3);
            memcpy(hb + 3, "x-n", 3);
            store8(hb + 6, 127);         # value length 227 = 127 + 100 (7-bit prefix)
            store8(hb + 7, 100);
            memset(hb + 8, 118, 227);
            _t_hp_put_int(hb, 8, k);     # a fresh value each time
            hlen = 8 + 227;
        }
        if (_t_hp_respond(sid, hb, hlen, 0, 0) < 0) { break; }
        k = k + 1;
    }
    return 0;
}

fn test_h2_exchange_heap_flat() {
    if (_t_hp_setup(39881) != 0) { assert_eq(1, 1, "h2 heap: loopback or threads unavailable — skipped"); return 0; }
    var h2c = sandhi_h2_conn_new(_t_h2s_conn(_t_h2s_cfd));
    _t_hp_churn = 0;
    var peer = thread_create(&_t_hp_peer_churn, 11);
    var a = arena_allocator(2400000);
    sandhi_h2_request_a(a, h2c, "GET", "http://h2.test/w", 0, 0, 0);
    reset_via(a);
    var b = alloc_used();
    var k = 0;
    while (k < 10) {
        sandhi_h2_request_a(a, h2c, "GET", "http://h2.test/x", 0, 0, 0);
        reset_via(a);
        k = k + 1;
    }
    assert_eq(alloc_used() - b, 0, "h2 heap: ten exchanges on a reset arena keep nothing on the global heap");
    thread_join(peer);
    _t_hp_done();

    if (_t_hp_setup(39882) != 0) { return 0; }
    h2c = sandhi_h2_conn_new(_t_h2s_conn(_t_h2s_cfd));
    _t_hp_churn = 1;
    peer = thread_create(&_t_hp_peer_churn, 160);
    var ok = 0;
    k = 0;
    while (k < 40) {
        if (sandhi_http_status(sandhi_h2_request_a(a, h2c, "GET", "http://h2.test/c", 0, 0, 0)) == 200) { ok = ok + 1; }
        reset_via(a);
        k = k + 1;
    }
    b = alloc_used();
    var fl0 = _fl_arena_pos;
    while (k < 160) {
        if (sandhi_http_status(sandhi_h2_request_a(a, h2c, "GET", "http://h2.test/c", 0, 0, 0)) == 200) { ok = ok + 1; }
        reset_via(a);
        k = k + 1;
    }
    assert_eq(ok, 160, "h2 heap: 160 answers adding a fresh header each all decode");
    assert_eq(alloc_used() - b, 0, "h2 heap: the last 120 keep nothing on the global heap");
    assert_eq(_fl_arena_pos - fl0, 0, "h2 heap: and the decode table reuses its evicted entries' blocks");
    assert(sandhi_hpack_table_size(sandhi_h2_conn_dec_table(h2c)) <= 4096, "h2 heap: within the table's 4,096");
    thread_join(peer);
    _t_hp_done();
    return 0;
}

