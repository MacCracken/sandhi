/build/
*.core
.claude/
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
.env
.env.*
*.pem
# The loopback TLS gates' self-signed 127.0.0.1 test fixtures are tracked.
!programs/_tls_fixtures/*.pem
*.key

# `lib/` is populated by `cyrius deps` from cyrius.cyml [deps] — a
# build artifact, not source. Never commit; never replace with a
# symlink to a cyrius checkout (see CLAUDE.md "Dependency wiring").
/lib/

# tests/sandhi.tcyr writes (and removes) this in the working directory; a
# killed run can leave it behind.
/_t_sandhi_dl_sink.tmp
