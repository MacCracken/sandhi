# Fuzz: the server's request-header readers (untrusted request bytes).
# Differential: since 1.13.2 `sandhi_server_content_length`,
# `_request_has_cl_te_conflict` and `_request_has_unsupported_te` read header
# values in place instead of copying them, so each must answer exactly what the
# 1.13.1 copy-based form (kept below as `_ref_*`) answered, and
# `sandhi_server_find_header_a` must copy the same value. Inputs mix framing
# header names and values (digits, SP, HTAB, CR, NUL, commas, "chunked"
# letters, random bytes), lines with and without CRLF, and every request is
# also read truncated at a random `blen`.
# Stdlib auto-included via cyrius.cyml; sandhi modules below (single-pass order).

include "src/tls_policy/session_cache.cyr"
include "src/http/conn.cyr"
include "src/server/mod.cyr"

fn _ref_find_header_a(a, buf, blen, name) {
    var nlen = strlen(name);
    var headers_end = _hsv_find(buf, blen, "\r\n\r\n", 4);
    if (headers_end < 0) { headers_end = blen; }
    var line_start = _hsv_next_nl(buf, 0, headers_end);
    if (line_start >= headers_end) { return 0; }
    line_start = line_start + 1;
    while (line_start < headers_end) {
        var line_end = _hsv_next_nl(buf, line_start, headers_end);
        if (line_start + nlen + 1 <= line_end
          && _hsv_iceq(buf + line_start, name, nlen) == 1
          && load8(buf + line_start + nlen) == 58) {
            var vs = line_start + nlen + 1;
            while (vs < line_end && load8(buf + vs) == 32) { vs = vs + 1; }
            var ve = line_end;
            if (ve > vs && load8(buf + ve - 1) == 13) { ve = ve - 1; }
            var vlen = ve - vs;
            var out = alloc_via(a, vlen + 1);
            if (out == 0) { return 0; }
            memcpy(out, buf + vs, vlen);
            store8(out + vlen, 0);
            return out;
        }
        line_start = line_end + 1;
    }
    return 0;
}

fn _ref_content_length(a, buf, blen) {
    var v = _ref_find_header_a(a, buf, blen, "Content-Length");
    if (v == 0) { return 0; }
    var i = 0;
    while (load8(v + i) == 32 || load8(v + i) == 9) { i = i + 1; }
    if (load8(v + i) == 0) { return 0; }
    var n = 0;
    var seen_digit = 0;
    while (load8(v + i) >= 48 && load8(v + i) <= 57) {
        n = n * 10 + (load8(v + i) - 48);
        if (n > _HSV_CL_MAX) { return 0 - 1; }
        seen_digit = 1;
        i = i + 1;
    }
    if (seen_digit == 0) { return 0; }
    while (load8(v + i) == 32 || load8(v + i) == 9) { i = i + 1; }
    if (load8(v + i) != 0) { return 0; }
    return n;
}

fn _ref_cl_te_conflict(a, buf, blen) {
    if (_ref_find_header_a(a, buf, blen, "Content-Length") == 0) { return 0; }
    var te = _ref_find_header_a(a, buf, blen, "Transfer-Encoding");
    if (te == 0) { return 0; }
    var i = 0;
    while (load8(te + i) != 0) {
        var c0 = load8(te + i);
        if (c0 >= 65 && c0 <= 90) { c0 = c0 + 32; }
        if (c0 == 99) {
            var j = 1;
            var matched = 1;
            var want = "hunked";
            while (j < 7) {
                var ch = load8(te + i + j);
                if (ch >= 65 && ch <= 90) { ch = ch + 32; }
                if (ch != load8(want + j - 1)) { matched = 0; break; }
                j = j + 1;
            }
            if (matched == 1) { return 1; }
        }
        i = i + 1;
    }
    return 0;
}

fn _ref_unsupported_te(a, buf, blen) {
    if (_ref_find_header_a(a, buf, blen, "Transfer-Encoding") == 0) { return 0; }
    return 1;
}

var _fz_s = 1;

# The LCG's high bits: its low bits have short periods (bit 0 alternates), so
# `% k` over the raw state gives correlated draws that miss whole input shapes.
fn _fz_next(): i64 {
    _fz_s = (_fz_s * 1103515245 + 12345) & 0x7fffffff;
    return (_fz_s >> 16) & 0x7fff;
}

fn _fz_put(buf, w, s): i64 {
    var n = strlen(s);
    memcpy(buf + w, s, n);
    return w + n;
}

# One header name: mostly the framing names, in mixed case, sometimes a near miss.
fn _fz_name(): i64 {
    var k = _fz_next() % 9;
    if (k == 0) { return "Content-Length"; }
    if (k == 1) { return "content-LENGTH"; }
    if (k == 2) { return "Transfer-Encoding"; }
    if (k == 3) { return "transfer-encoding"; }
    if (k == 4) { return "Host"; }
    if (k == 5) { return "Content-Lengthx"; }
    if (k == 6) { return "Content-Lengt"; }
    if (k == 7) { return "X-A"; }
    return "Transfer-Encodin";
}

# One value byte from an alphabet weighted toward what the readers branch on.
fn _fz_vbyte(): i64 {
    var k = _fz_next() % 16;
    if (k < 6) { return 48 + _fz_next() % 10; }
    if (k == 6) { return 32; }
    if (k == 7) { return 9; }
    if (k == 8) { return 13; }
    if (k == 9) { return 0; }
    if (k == 10) { return 44; }
    if (k == 11) { return load8("chunked" + _fz_next() % 7); }
    if (k == 12) { return load8("CHUNKED" + _fz_next() % 7); }
    return _fz_next() % 256;
}

# Build a request into buf (cap bytes); returns its length.
fn _fz_request(buf, cap): i64 {
    var w = _fz_put(buf, 0, "POST /x HTTP/1.1\r\n");
    var lines = _fz_next() % 7;
    var li = 0;
    while (li < lines) {
        if (w + 64 >= cap) { break; }
        w = _fz_put(buf, w, _fz_name());
        store8(buf + w, 58); w = w + 1;
        var sp = _fz_next() % 3;
        while (sp > 0) { store8(buf + w, 32); w = w + 1; sp = sp - 1; }
        var lit = _fz_next() % 6;
        if (lit == 1) { w = _fz_put(buf, w, "chunked"); }
        elif (lit == 2) { w = _fz_put(buf, w, "CHUNKED"); }
        elif (lit == 3) { w = _fz_put(buf, w, "gzip, Chunked"); }
        elif (lit == 4) { w = _fz_put(buf, w, "chunke"); }
        var vlen = _fz_next() % 24;
        while (vlen > 0) { store8(buf + w, _fz_vbyte()); w = w + 1; vlen = vlen - 1; }
        var eol = _fz_next() % 4;
        if (eol < 2) { store8(buf + w, 13); w = w + 1; store8(buf + w, 10); w = w + 1; }
        elif (eol == 2) { store8(buf + w, 10); w = w + 1; }
        li = li + 1;
    }
    if (_fz_next() % 3 != 0) { store8(buf + w, 13); w = w + 1; store8(buf + w, 10); w = w + 1; }
    var body = _fz_next() % 16;
    while (body > 0) { store8(buf + w, _fz_next() % 256); w = w + 1; body = body - 1; }
    return w;
}

# Every reader against its reference over buf[0, blen). 0 when they agree, else
# the exit code naming the reader that differs.
fn _fz_check(a, buf, blen): i64 {
    reset_via(a);
    if (sandhi_server_content_length(buf, blen) != _ref_content_length(a, buf, blen)) { return 11; }
    reset_via(a);
    if (sandhi_server_request_has_cl_te_conflict(buf, blen) != _ref_cl_te_conflict(a, buf, blen)) { return 12; }
    reset_via(a);
    if (sandhi_server_request_has_unsupported_te(buf, blen) != _ref_unsupported_te(a, buf, blen)) { return 13; }
    var names = "Content-Length\0Transfer-Encoding\0Host\0";
    var off = 0;
    while (load8(names + off) != 0) {
        var name = names + off;
        reset_via(a);
        var got = sandhi_server_find_header_a(a, buf, blen, name);
        var want = _ref_find_header_a(a, buf, blen, name);
        if ((got == 0) != (want == 0)) { return 14; }
        if (got != 0) {
            var gl = strlen(got);
            if (gl != strlen(want)) { return 15; }
            if (memeq(got, want, gl) != 1) { return 15; }
        }
        off = off + strlen(name) + 1;
    }
    return 0;
}

fn main() {
    alloc_init();
    var a = arena_allocator(65536);
    var buf = alloc(4096);

    # --- baselines: the readers still answer the plain cases ---
    var ok = "POST / HTTP/1.1\r\nContent-Length: 5\r\n\r\nhello";
    if (sandhi_server_content_length(ok, strlen(ok)) != 5) { return 10; }
    var r = _fz_check(a, ok, strlen(ok));
    if (r != 0) { return r; }

    # --- degenerate / boundary ---
    var tiny = "\r\n\r\n";
    var bl = 0;
    while (bl <= 4) {
        r = _fz_check(a, tiny, bl);
        if (r != 0) { return r; }
        bl = bl + 1;
    }

    # --- structured requests, each also read at every-so-often truncations ---
    _fz_s = 1301;
    var iter = 0;
    while (iter < 20000) {
        var n = _fz_request(buf, 4000);
        r = _fz_check(a, buf, n);
        if (r != 0) { return r; }
        var cut = _fz_next() % (n + 1);
        r = _fz_check(a, buf, cut);
        if (r != 0) { return r; }
        iter = iter + 1;
    }

    # --- raw random buffers behind a request line ---
    var ri = 0;
    while (ri < 2000) {
        var w = _fz_put(buf, 0, "GET / HTTP/1.1\r\n");
        var rn = _fz_next() % 512;
        while (rn > 0) { store8(buf + w, _fz_vbyte()); w = w + 1; rn = rn - 1; }
        r = _fz_check(a, buf, w);
        if (r != 0) { return r; }
        ri = ri + 1;
    }

    syscall(1, 1, "server_request fuzz: ok\n", 24);
    return 0;
}

var _ec = main();
syscall(60, _ec);
