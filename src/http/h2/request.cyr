# sandhi/http/h2/request — encode + send an HTTP/2 request.
#
# Composes Bite 2 (HPACK), Bite 3 (frames), and Bite 5a (h2 conn) to
# produce + send a complete HEADERS frame for one h2 request.
#
# Wire shape (RFC 7540 §8.1.2):
#   1. Pseudo-headers in fixed order: :method, :scheme, :path,
#      :authority.
#   2. Regular headers — names MUST be lowercase per §8.1.2; we
#      lowercase on emit so callers can keep using the existing
#      mixed-case `sandhi_headers_*` API unchanged.
#   3. Empty body for GET/HEAD/DELETE: HEADERS frame with
#      END_HEADERS | END_STREAM. For request bodies: HEADERS without
#      END_STREAM, then DATA frame(s) with the body, last DATA has
#      END_STREAM.
#
# Static-table optimization: we use the obvious pre-baked indices
# for `:method GET`/`POST`, `:scheme http`/`https`, `:path /`, and
# `:authority` (name-only). Everything else is a literal without
# indexing (RFC 7541 §6.2.2), so the conn's encoder table stays empty.
#
# 1.13.6:
#   - Never index. Through 1.13.5 every other field was a literal with
#     incremental indexing: each was inserted into the conn's encoder
#     table on the global heap (at least 304 B a field, kept for the life
#     of the conn), holding pointers into the request's arena, and the
#     encoder never referenced its dynamic entries, so it bought nothing.
#   - The header block is sized per request, and one larger than the
#     peer's MAX_FRAME_SIZE goes out as HEADERS + CONTINUATION. Through
#     1.13.5 a fixed 8 KB buffer refused any larger block.
#   - A header list larger than the peer's SETTINGS_MAX_HEADER_LIST_SIZE is
#     refused before anything is sent (`_SANDHI_H2_ERR_HDR_LIST`).
#   - A body larger than the peer's MAX_FRAME_SIZE is split into DATA
#     frames, each within the peer's connection and stream windows; the
#     sender waits for WINDOW_UPDATE when they are spent. Through 1.13.5 a
#     body over one frame was refused, and the windows were never consulted.
#
# Bite 5b of 0.8.0.

# Static-table indices we hardcode (RFC 7541 Appendix A).
const _SANDHI_H2_REQ_IDX_AUTHORITY     = 1;
const _SANDHI_H2_REQ_IDX_METHOD_GET    = 2;
const _SANDHI_H2_REQ_IDX_METHOD_POST   = 3;
const _SANDHI_H2_REQ_IDX_PATH_ROOT     = 4;
const _SANDHI_H2_REQ_IDX_SCHEME_HTTP   = 6;
const _SANDHI_H2_REQ_IDX_SCHEME_HTTPS  = 7;

# The header-block buffer the public `sandhi_h2_request_encode_headers_a`
# contract names. sandhi's own sender sizes its buffer per request.
const _SANDHI_H2_REQ_HBUF_CAP = 8192;

# ================================================================
# Pseudo-header emit helpers
# ================================================================

fn _h2_emit_method(h2c, method, hbuf, off): i64 {
    if (streq(method, "GET") == 1)  {
        return sandhi_hpack_encode_indexed(hbuf, off, _SANDHI_H2_REQ_IDX_METHOD_GET);
    }
    if (streq(method, "POST") == 1) {
        return sandhi_hpack_encode_indexed(hbuf, off, _SANDHI_H2_REQ_IDX_METHOD_POST);
    }
    # PUT / DELETE / PATCH / HEAD — emit literal with name idx 2 + value.
    return _hpack_encode_literal_no_index_name(hbuf, off, _SANDHI_H2_REQ_IDX_METHOD_GET, method);
}

fn _h2_emit_scheme(h2c, scheme, hbuf, off): i64 {
    if (streq(scheme, "https") == 1) {
        return sandhi_hpack_encode_indexed(hbuf, off, _SANDHI_H2_REQ_IDX_SCHEME_HTTPS);
    }
    if (streq(scheme, "http") == 1) {
        return sandhi_hpack_encode_indexed(hbuf, off, _SANDHI_H2_REQ_IDX_SCHEME_HTTP);
    }
    return _hpack_encode_literal_no_index_name(hbuf, off, _SANDHI_H2_REQ_IDX_SCHEME_HTTP, scheme);
}

fn _h2_emit_path(h2c, path, hbuf, off): i64 {
    if (streq(path, "/") == 1) {
        return sandhi_hpack_encode_indexed(hbuf, off, _SANDHI_H2_REQ_IDX_PATH_ROOT);
    }
    return _hpack_encode_literal_no_index_name(hbuf, off, _SANDHI_H2_REQ_IDX_PATH_ROOT, path);
}

fn _h2_emit_authority(h2c, authority, hbuf, off): i64 {
    return _hpack_encode_literal_no_index_name(hbuf, off, _SANDHI_H2_REQ_IDX_AUTHORITY, authority);
}

# Emit one user header, allocating the lowercased-name copy from `a`.
# The HPACK encoder only references the lowercased name during this
# call (it never indexes), so the alloc is short-lived; arena callers
# reset after the request is on the wire.
fn _h2_emit_user_header_a(a, h2c, name, value, hbuf, off): i64 {
    var nlen = strlen(name);
    var lower = alloc_via(a, nlen + 1);
    if (lower == 0) { return off; }
    var i = 0;
    while (i < nlen) {
        var ch = load8(name + i);
        if (ch >= 65 && ch <= 90) { ch = ch + 32; }
        store8(lower + i, ch);
        i = i + 1;
    }
    store8(lower + nlen, 0);
    return sandhi_hpack_encode_literal_no_index(hbuf, off, lower, value);
}

fn _h2_emit_user_header(h2c, name, value, hbuf, off): i64 {
    return _h2_emit_user_header_a(default_alloc(), h2c, name, value, hbuf, off);
}

# ================================================================
# Build a complete header block for a request
# ================================================================
#
# Returns the byte length of the encoded block, or `_SANDHI_H2_ERR_MALFORMED`
# if the block will not fit. Caller-allocated `hbuf` MUST hold
# ≥ _SANDHI_H2_REQ_HBUF_CAP bytes. `user_headers` may be 0 for
# "no extras." `:method`/`:scheme`/`:path`/`:authority` are emitted in
# that exact order per RFC 7540 §8.1.2.1.
#
# 1.9.13 P1 — this comment used to end "(encoder lacks overflow checking —
# caller's responsibility)", and the only caller allocates EXACTLY
# `_SANDHI_H2_REQ_HBUF_CAP` (8192) and then loops over every user header
# without checking `off`. So the contract was unmet by sandhi's own caller:
# more than ~8 KiB of request headers walked off the end of a heap buffer.
# Request headers are caller-supplied rather than remote, but they routinely
# carry attacker-influenced content — a long cookie, a URL-derived value, a
# token from upstream — and the redirect-follow path re-emits them.
#
# The bound is enforced HERE rather than pushed onto callers, because the
# constant this buffer is sized from lives in this module. Each emit is
# preceded by a conservative worst-case reservation: HPACK literal output is
# never longer than the raw octets plus its length prefixes (the encoder picks
# Huffman only when strictly shorter), so `strlen(name) + strlen(value) + 16`
# covers index prefix + two length varints with room to spare.
fn _h2_hbuf_fits(off, need, cap): bool {
    if (off < 0)  { return false; }
    if (need < 0) { return false; }
    if (off + need > cap) { return false; }
    return true;
}

fn sandhi_h2_request_encode_headers_a(a, h2c, method, scheme, path, authority,
  user_headers, hbuf): i64 {
    return _h2_encode_headers_cap_a(a, h2c, method, scheme, path, authority,
      user_headers, hbuf, _SANDHI_H2_REQ_HBUF_CAP);
}

# The encode, into an `hbuf` of `cap` bytes.
fn _h2_encode_headers_cap_a(a, h2c, method, scheme, path, authority,
  user_headers, hbuf, cap): i64 {
    var off = 0;
    if (_h2_hbuf_fits(off, strlen(method) + 16, cap) == 0)    { return _SANDHI_H2_ERR_MALFORMED; }
    off = _h2_emit_method(h2c, method, hbuf, off);
    if (_h2_hbuf_fits(off, strlen(scheme) + 16, cap) == 0)    { return _SANDHI_H2_ERR_MALFORMED; }
    off = _h2_emit_scheme(h2c, scheme, hbuf, off);
    if (_h2_hbuf_fits(off, strlen(path) + 16, cap) == 0)      { return _SANDHI_H2_ERR_MALFORMED; }
    off = _h2_emit_path(h2c, path, hbuf, off);
    if (_h2_hbuf_fits(off, strlen(authority) + 16, cap) == 0) { return _SANDHI_H2_ERR_MALFORMED; }
    off = _h2_emit_authority(h2c, authority, hbuf, off);

    if (_h2_needs_te(user_headers) == 1) {
        if (_h2_hbuf_fits(off, 26, cap) == 0) { return _SANDHI_H2_ERR_MALFORMED; }
        off = _h2_emit_user_header_a(a, h2c, "te", "trailers", hbuf, off);
    }

    if (user_headers != 0) {
        var n = sandhi_headers_count(user_headers);
        var i = 0;
        while (i < n) {
            var name = sandhi_headers_name_at(user_headers, i);
            var value = sandhi_headers_value_at(user_headers, i);
            if (_h2_header_is_forbidden(name, value) == 0) {
                if (_h2_hbuf_fits(off, strlen(name) + strlen(value) + 16, cap) == 0) {
                    return _SANDHI_H2_ERR_MALFORMED;
                }
                off = _h2_emit_user_header_a(a, h2c, name, value, hbuf, off);
            }
            i = i + 1;
        }
    }
    return off;
}

# 1 when the encoder adds `te: trailers` (the caller sent no TE).
fn _h2_needs_te(user_headers): bool {
    if (user_headers == 0) { return true; }
    if (sandhi_headers_has(user_headers, "TE") == 1) { return false; }
    return true;
}

# The worst-case encoded size of the request's header block (the buffer
# `_h2_encode_headers_cap_a` needs: raw octets plus 16 a field, as
# `_h2_hbuf_fits` reserves), and into `list_out` its header-list size
# (RFC 7540 §6.5.2: name + value + 32 octets a field), over every field the
# encoder emits.
fn _h2_req_sizes(method, scheme, path, authority, user_headers, list_out): i64 {
    var need = strlen(method) + strlen(scheme) + strlen(path) + strlen(authority) + 64;
    var list = 7 + strlen(method) + 7 + strlen(scheme) + 5 + strlen(path)
    + 10 + strlen(authority) + 4 * 32;
    if (_h2_needs_te(user_headers) == 1) {
        need = need + 26;
        list = list + 10 + 32;
    }
    if (user_headers != 0) {
        var n = sandhi_headers_count(user_headers);
        var i = 0;
        while (i < n) {
            var name = sandhi_headers_name_at(user_headers, i);
            var value = sandhi_headers_value_at(user_headers, i);
            if (_h2_header_is_forbidden(name, value) == 0) {
                var fl = strlen(name) + strlen(value);
                need = need + fl + 16;
                list = list + fl + 32;
            }
            i = i + 1;
        }
    }
    store64(list_out, list);
    return need;
}

fn sandhi_h2_request_encode_headers(h2c, method, scheme, path, authority,
  user_headers, hbuf): i64 {
    return sandhi_h2_request_encode_headers_a(default_alloc(), h2c, method, scheme, path, authority,
      user_headers, hbuf);
}

# 1 if (name, value) is forbidden in an h2 header block per RFC 7540
# §8.1.2.2. Case-insensitive name match. The `te` header is
# conditionally allowed: only `te: trailers` may appear; any other
# value (e.g. `te: gzip`) must be dropped — the spec says a request
# with TE != "trailers" is malformed. We drop instead of erroring so
# the request still ships.
fn _h2_header_is_forbidden(name, value): bool {
    if (_h2_streq_ci(name, "connection") == 1)        { return true; }
    if (_h2_streq_ci(name, "keep-alive") == 1)        { return true; }
    if (_h2_streq_ci(name, "proxy-connection") == 1)  { return true; }
    if (_h2_streq_ci(name, "transfer-encoding") == 1) { return true; }
    if (_h2_streq_ci(name, "upgrade") == 1)           { return true; }
    if (_h2_streq_ci(name, "te") == 1) {
        if (_h2_te_value_is_trailers(value) == 1) { return false; }
        return true;
    }
    return false;
}

# 1 if `value` is the literal "trailers" (case-insensitive) with
# optional surrounding whitespace. NULL or any other value → 0.
# Used only by `_h2_header_is_forbidden` for the te-conditional rule.
fn _h2_te_value_is_trailers(value): bool {
    if (value == 0) { return false; }
    var i = 0;
    while (load8(value + i) == 32 || load8(value + i) == 9) { i = i + 1; }
    var need = "trailers";
    var j = 0;
    while (j < 8) {
        var ch = load8(value + i + j);
        if (ch >= 65 && ch <= 90) { ch = ch + 32; }
        if (ch != load8(need + j)) { return false; }
        j = j + 1;
    }
    var k = i + 8;
    loop {
        var ch2 = load8(value + k);
        if (ch2 == 0) { return true; }
        if (ch2 != 32 && ch2 != 9) { return false; }
        k = k + 1;
    }
    return true;
}

fn _h2_streq_ci(a, b): bool {
    var i = 0;
    loop {
        var ca = load8(a + i);
        var cb = load8(b + i);
        if (ca >= 65 && ca <= 90) { ca = ca + 32; }
        if (cb >= 65 && cb <= 90) { cb = cb + 32; }
        if (ca != cb) { return false; }
        if (ca == 0)  { return true; }
        i = i + 1;
    }
    return false;
}

# ================================================================
# Send a complete request
# ================================================================
#
# For body-less methods (GET/HEAD/DELETE): one HEADERS frame with
# END_HEADERS | END_STREAM (plus CONTINUATION frames for a block over the
# peer's MAX_FRAME_SIZE). For body-bearing (POST/PUT/PATCH): HEADERS
# without END_STREAM, then DATA frames with the body, the last carrying
# END_STREAM.
#
# Returns the allocated stream-id on success (≥ 1), or a negative
# `_SANDHI_H2_ERR_*` sentinel on failure. If the peer answers on the
# stream before the body is all sent, the sender stops and leaves that
# frame for `sandhi_h2_response_recv_a`.

fn sandhi_h2_request_send_a(a, h2c, method, scheme, path, authority,
  user_headers, body, body_len): i64 {
    var st = alloc_via(a, 8);
    if (st == 0) { return _SANDHI_H2_ERR_MALFORMED; }
    return _sandhi_h2_request_send_ex_a(a, h2c, method, scheme, path, authority,
      user_headers, body, body_len, st);
}

# The send, reporting into `state_out` how far it got: 0 nothing written,
# 1 the request is on the wire but its body was cut short by an early
# answer (the stream is still open on our side), 2 the request is complete.
fn _sandhi_h2_request_send_ex_a(a, h2c, method, scheme, path, authority,
  user_headers, body, body_len, state_out): i64 {
    store64(state_out, 0);
    var lcell = alloc_via(a, 8);
    if (lcell == 0) { return _SANDHI_H2_ERR_MALFORMED; }
    var need = _h2_req_sizes(method, scheme, path, authority, user_headers, lcell);
    var limit = load64(h2c + SANDHI_H2_CONN_OFF_PEER_HDR_LIST);
    if (limit > 0 && load64(lcell) > limit) { return _SANDHI_H2_ERR_HDR_LIST; }
    var hbuf = alloc_via(a, need);
    if (hbuf == 0) { return _SANDHI_H2_ERR_MALFORMED; }
    var hlen = _h2_encode_headers_cap_a(a, h2c, method, scheme, path,
      authority, user_headers, hbuf, need);
    if (hlen <= 0) { return _SANDHI_H2_ERR_MALFORMED; }

    var stream_id = sandhi_h2_conn_next_stream_id(h2c);
    var has_body = 0;
    if (body_len > 0 && body != 0) { has_body = 1; }

    var hr = _h2_send_header_block_a(a, h2c, stream_id, hbuf, hlen, has_body == 0);
    if (hr < 0) { return hr; }
    store64(state_out, 2);
    if (has_body == 1) {
        store64(state_out, 1);
        var br = _h2_send_body_a(a, h2c, stream_id, body, body_len);
        if (br < 0) { return br; }
        if (br == 1) { store64(state_out, 2); }
    }
    return stream_id;
}

# HEADERS, then CONTINUATION frames while the block is longer than the
# peer's MAX_FRAME_SIZE (RFC 7540 §6.10); END_HEADERS on the last.
fn _h2_send_header_block_a(a, h2c, sid, hbuf, hlen, end_stream): i64 {
    var max = sandhi_h2_conn_peer_max_frame(h2c);
    var n = hlen;
    if (n > max) { n = max; }
    var flags = 0;
    if (end_stream == 1) { flags = SANDHI_H2_FLAG_END_STREAM; }
    if (n == hlen) { flags = flags | SANDHI_H2_FLAG_END_HEADERS; }
    var r = sandhi_h2_conn_send_frame_a(a, h2c, SANDHI_H2_FRAME_HEADERS, flags, sid, hbuf, n);
    if (r < 0) { return r; }
    var off = n;
    while (off < hlen) {
        n = hlen - off;
        if (n > max) { n = max; }
        var cf = 0;
        if (off + n == hlen) { cf = SANDHI_H2_FLAG_END_HEADERS; }
        r = sandhi_h2_conn_send_frame_a(a, h2c, SANDHI_H2_FRAME_CONTINUATION, cf, sid, hbuf + off, n);
        if (r < 0) { return r; }
        off = off + n;
    }
    return 0;
}

# The body as DATA frames, each at most the peer's MAX_FRAME_SIZE and within
# its connection and stream windows (RFC 7540 §6.9); END_STREAM on the last.
# Returns 1 when all of it is sent, 0 when the peer answered first (that
# frame is left pending), or a negative sentinel.
fn _h2_send_body_a(a, h2c, sid, body, body_len): i64 {
    var swin = alloc_via(a, 8);
    if (swin == 0) { return _SANDHI_H2_ERR_TRUNCATED; }
    store64(swin, sandhi_h2_conn_peer_init_window(h2c));
    var sent = 0;
    while (sent < body_len) {
        var n = body_len - sent;
        var mf = sandhi_h2_conn_peer_max_frame(h2c);
        if (n > mf) { n = mf; }
        var cw = load64(h2c + SANDHI_H2_CONN_OFF_SEND_WINDOW);
        if (n > cw) { n = cw; }
        if (n > load64(swin)) { n = load64(swin); }
        if (n <= 0) {
            var w = _h2_await_window_a(a, h2c, sid, swin);
            if (w < 0) { return w; }
            if (w == 1) { return 0; }
        } else {
            var flags = 0;
            if (sent + n == body_len) { flags = SANDHI_H2_FLAG_END_STREAM; }
            var r = sandhi_h2_conn_send_frame_a(a, h2c, SANDHI_H2_FRAME_DATA, flags, sid, body + sent, n);
            if (r < 0) { return r; }
            store64(h2c + SANDHI_H2_CONN_OFF_SEND_WINDOW, cw - n);
            store64(swin, load64(swin) - n);
            sent = sent + n;
        }
    }
    return 1;
}

# Read one frame while the body waits on a window. Returns 0 to try again,
# 1 when the frame belongs to the response (an answer on `sid`, or a GOAWAY):
# it is left in the conn's pending slot for the response reader. Applies
# WINDOW_UPDATE, SETTINGS (a new INITIAL_WINDOW_SIZE moves the stream window
# by the difference, §6.9.2) and PING; returns DATA on other streams to the
# connection window. Negative on a read error.
fn _h2_await_window_a(a, h2c, sid, swin): i64 {
    var res = alloc_via(a, 16);
    if (res == 0) { return _SANDHI_H2_ERR_TRUNCATED; }
    var n = sandhi_h2_conn_recv_frame_a(a, h2c, res);
    if (n < 0) { return n; }
    var hdr = load64(res);
    var payload = load64(res + 8);
    var ftype = sandhi_h2_hdr_type(hdr);
    var fsid = sandhi_h2_hdr_stream_id(hdr);
    var flen = sandhi_h2_hdr_length(hdr);
    if (ftype == SANDHI_H2_FRAME_WINDOW_UPDATE) {
        if (flen != 4) { return _SANDHI_H2_ERR_MALFORMED; }
        var inc = sandhi_h2_window_update_decode(payload, flen, 0);
        if (fsid == 0) { return _h2_conn_window_grant(h2c, inc); }
        if (fsid == sid) {
            if (inc <= 0 || load64(swin) + inc > _SANDHI_H2_MAX_WINDOW) { return _SANDHI_H2_ERR_FLOW; }
            store64(swin, load64(swin) + inc);
        }
        return 0;
    }
    if (ftype == SANDHI_H2_FRAME_SETTINGS && fsid == 0) {
        var before = sandhi_h2_conn_peer_init_window(h2c);
        var sr = _h2_handle_settings_a(a, h2c, hdr, payload);
        if (sr < 0) { return sr; }
        store64(swin, load64(swin) + sandhi_h2_conn_peer_init_window(h2c) - before);
        return 0;
    }
    if (ftype == SANDHI_H2_FRAME_PING && fsid == 0) {
        return _h2_handle_ping_a(a, h2c, hdr, payload);
    }
    if (ftype == SANDHI_H2_FRAME_DATA && fsid != sid) {
        return _h2_conn_data_received_a(a, h2c, flen);
    }
    if (fsid == sid || (ftype == SANDHI_H2_FRAME_GOAWAY && fsid == 0)) {
        store64(h2c + SANDHI_H2_CONN_OFF_PENDING, res);
        return 1;
    }
    return 0;
}

fn sandhi_h2_request_send(h2c, method, scheme, path, authority,
  user_headers, body, body_len): i64 {
    return sandhi_h2_request_send_a(default_alloc(), h2c, method, scheme, path, authority,
      user_headers, body, body_len);
}

