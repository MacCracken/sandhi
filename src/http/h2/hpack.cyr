# sandhi/http/h2/hpack — HPACK header compression (RFC 7541).
#
# HPACK is the header-compression scheme HTTP/2 uses on every HEADERS
# and CONTINUATION frame. It combines:
#   - A static table (61 well-known headers, indexed by integer)
#   - A dynamic table (per-connection, size-limited, evicted from
#     the tail when over budget)
#   - A primitive integer encoding (variable-length, prefix-bits
#     spread across the first byte)
#   - A primitive string encoding (length-prefixed, optionally
#     Huffman-encoded — see Bite 2b)
#   - 5 header-field representations: indexed, literal-incremental,
#     literal-no-index, literal-never-index, dynamic-size-update
#
# This file implements everything except Huffman encode/decode (Bite
# 2b adds decode). Huffman-encoded strings on the wire are rejected
# with `_SANDHI_HPACK_ERR_HUFFMAN`. Encoding always emits raw strings.
#
# Conformance reference: tested against RFC 7541 Appendix C examples
# C.1 (integer), C.2 (header-field representations), C.3 (request
# sequence without Huffman), and C.5 (response sequence without
# Huffman).
#
# Bite 2 of 0.8.0.

# ================================================================
# Error sentinels
# ================================================================
const _SANDHI_HPACK_ERR_TRUNCATED   = 0 - 1;
const _SANDHI_HPACK_ERR_BAD_INDEX   = 0 - 2;
const _SANDHI_HPACK_ERR_HUFFMAN     = 0 - 3;
const _SANDHI_HPACK_ERR_MALFORMED   = 0 - 4;
const _SANDHI_HPACK_ERR_INT_OVERFLOW = 0 - 5;

# Default dynamic-table size from SETTINGS_HEADER_TABLE_SIZE — RFC
# 7540 §6.5.2 default is 4096 octets.
var SANDHI_HPACK_DEFAULT_TABLE_SIZE = 4096;

# ================================================================
# Static table — RFC 7541 Appendix A
# ================================================================
#
# One block of 61 (name, value) cstr pairs, built once on first use
# (`_hpack_static_get`). Indices in HPACK are 1-based:
# hpack_static_name(1) → ":authority".
#
# Block layout: +0 the number of entries filled; entry i's name at
# +8 + i*16 and its value at +16 + i*16.

# The static table's block size, in bytes.
const _SANDHI_HPACK_STATIC_TBL_SIZE = 8 + 61 * 16;
# The static table, published by `_hpack_static_get`.
var _hpack_static_tbl = 0;

fn _hpack_static_pair(t, n, v): i64 {
    var i = load64(t);
    store64(t + 8 + i * 16, n);
    store64(t + 16 + i * 16, v);
    store64(t, i + 1);
    return 0;
}

# Split into 4 chunks so each function stays under the Cyrius
# fixup-table cap. Each chunk handles ~15 entries.
fn _hpack_static_fill_1(t): i64 {
    _hpack_static_pair(t, ":authority", "");
    _hpack_static_pair(t, ":method", "GET");
    _hpack_static_pair(t, ":method", "POST");
    _hpack_static_pair(t, ":path", "/");
    _hpack_static_pair(t, ":path", "/index.html");
    _hpack_static_pair(t, ":scheme", "http");
    _hpack_static_pair(t, ":scheme", "https");
    _hpack_static_pair(t, ":status", "200");
    _hpack_static_pair(t, ":status", "204");
    _hpack_static_pair(t, ":status", "206");
    _hpack_static_pair(t, ":status", "304");
    _hpack_static_pair(t, ":status", "400");
    _hpack_static_pair(t, ":status", "404");
    _hpack_static_pair(t, ":status", "500");
    _hpack_static_pair(t, "accept-charset", "");
    return 0;
}

fn _hpack_static_fill_2(t): i64 {
    _hpack_static_pair(t, "accept-encoding", "gzip, deflate");
    _hpack_static_pair(t, "accept-language", "");
    _hpack_static_pair(t, "accept-ranges", "");
    _hpack_static_pair(t, "accept", "");
    _hpack_static_pair(t, "access-control-allow-origin", "");
    _hpack_static_pair(t, "age", "");
    _hpack_static_pair(t, "allow", "");
    _hpack_static_pair(t, "authorization", "");
    _hpack_static_pair(t, "cache-control", "");
    _hpack_static_pair(t, "content-disposition", "");
    _hpack_static_pair(t, "content-encoding", "");
    _hpack_static_pair(t, "content-language", "");
    _hpack_static_pair(t, "content-length", "");
    _hpack_static_pair(t, "content-location", "");
    _hpack_static_pair(t, "content-range", "");
    return 0;
}

fn _hpack_static_fill_3(t): i64 {
    _hpack_static_pair(t, "content-type", "");
    _hpack_static_pair(t, "cookie", "");
    _hpack_static_pair(t, "date", "");
    _hpack_static_pair(t, "etag", "");
    _hpack_static_pair(t, "expect", "");
    _hpack_static_pair(t, "expires", "");
    _hpack_static_pair(t, "from", "");
    _hpack_static_pair(t, "host", "");
    _hpack_static_pair(t, "if-match", "");
    _hpack_static_pair(t, "if-modified-since", "");
    _hpack_static_pair(t, "if-none-match", "");
    _hpack_static_pair(t, "if-range", "");
    _hpack_static_pair(t, "if-unmodified-since", "");
    _hpack_static_pair(t, "last-modified", "");
    _hpack_static_pair(t, "link", "");
    return 0;
}

fn _hpack_static_fill_4(t): i64 {
    _hpack_static_pair(t, "location", "");
    _hpack_static_pair(t, "max-forwards", "");
    _hpack_static_pair(t, "proxy-authenticate", "");
    _hpack_static_pair(t, "proxy-authorization", "");
    _hpack_static_pair(t, "range", "");
    _hpack_static_pair(t, "referer", "");
    _hpack_static_pair(t, "refresh", "");
    _hpack_static_pair(t, "retry-after", "");
    _hpack_static_pair(t, "server", "");
    _hpack_static_pair(t, "set-cookie", "");
    _hpack_static_pair(t, "strict-transport-security", "");
    _hpack_static_pair(t, "transfer-encoding", "");
    _hpack_static_pair(t, "user-agent", "");
    _hpack_static_pair(t, "vary", "");
    _hpack_static_pair(t, "via", "");
    _hpack_static_pair(t, "www-authenticate", "");
    return 0;
}

# Build the 61-entry static table from `a`. Returns the filled block,
# or 0 when its allocation fails.
fn _hpack_static_build_a(a): i64 {
    var t = alloc_via(a, _SANDHI_HPACK_STATIC_TBL_SIZE);
    if (t == 0) { return 0; }
    store64(t, 0);
    _hpack_static_fill_1(t);
    _hpack_static_fill_2(t);
    _hpack_static_fill_3(t);
    _hpack_static_fill_4(t);
    return t;
}

# The static table, or 0 on OOM. Built on first use from
# `default_alloc()`: it is a process-wide singleton consulted by every
# HPACK encode/decode and must outlive any per-request arena.
#
# 1.13.4 — built in a local and published by one store after a fence, as
# `_sandhi_alpn_wire_get` does. Through 1.13.3 the build wrote straight
# into two global vecs and set a "built" flag last, so two threads making
# their first h2 request together both built: the second replaced the
# vecs mid-fill, both pushed into its pair, and static-index lookups
# answered wrong names for the life of the process. Two threads building
# at once now each fill their own block; one of them is never used.
fn _hpack_static_get(): i64 {
    var t = _hpack_static_tbl;
    if (t != 0) { return t; }
    t = _hpack_static_build_a(default_alloc());
    if (t == 0) { return 0; }
    atomic_fence();
    _hpack_static_tbl = t;
    return t;
}

# 61, or 0 when the table cannot be built (out of memory).
fn sandhi_hpack_static_size(): i64 {
    var t = _hpack_static_get();
    if (t == 0) { return 0; }
    return load64(t);
}

fn sandhi_hpack_static_name(idx): i64 {
    var t = _hpack_static_get();
    if (t == 0) { return 0; }
    if (idx < 1 || idx > load64(t)) { return 0; }
    return load64(t + 8 + (idx - 1) * 16);
}

fn sandhi_hpack_static_value(idx): i64 {
    var t = _hpack_static_get();
    if (t == 0) { return 0; }
    if (idx < 1 || idx > load64(t)) { return 0; }
    return load64(t + 16 + (idx - 1) * 16);
}

# ================================================================
# Dynamic table (RFC 7541 §4.1, §4.2)
# ================================================================
#
# Each entry has size = strlen(name) + strlen(value) + 32 (overhead).
# Total table size = sum of all entry sizes; must stay ≤ max_size.
# When adding would exceed max_size, evict from the tail (oldest)
# until it fits. If even an empty table can't hold the new entry,
# the entry is silently dropped (RFC 7541 §4.4).
#
# Indexing: dynamic entries get indices starting at 62 (after the
# 61-entry static table). Newest entry is index 62.
#
# Storage (1.13.6): the table keeps its own copy of every entry, one
# `fl_alloc` block holding "name\0value\0", freed when the entry is
# evicted; entries are held oldest first, so an add appends and an
# eviction removes from the front, and neither rebuilds the vecs. The
# vecs grow on the global heap only up to the table's largest entry
# count. Through 1.13.5 the table held the caller's pointers (a decoded
# field's, in the request's arena), and every add rebuilt both vecs
# through the caller's allocator: after a per-request arena was reset,
# the conn's decode table pointed into reused memory.
#
# Struct layout (40 bytes):
#   +0   names    (vec<cstr>: oldest at vec[0]; each entry's block)
#   +8   values   (vec<cstr>: parallel; inside the same blocks)
#   +16  cur_size (int: bytes used)
#   +24  max_size (int: cap)
#   +32  limit    (int: the size the table was built with — for a decode
#                  table, the SETTINGS_HEADER_TABLE_SIZE its endpoint
#                  advertised; a peer's size update may not exceed it)

enum SandhiHpackTableOff {
    SANDHI_HPACK_TBL_OFF_NAMES    = 0;
    SANDHI_HPACK_TBL_OFF_VALUES   = 8;
    SANDHI_HPACK_TBL_OFF_CUR_SIZE = 16;
    SANDHI_HPACK_TBL_OFF_MAX_SIZE = 24;
    SANDHI_HPACK_TBL_OFF_LIMIT    = 32;
}

var SANDHI_HPACK_TABLE_STRUCT_SIZE = 40;
var SANDHI_HPACK_ENTRY_OVERHEAD    = 32;

# Build a dynamic table from `a`. The struct + parallel name/value
# vecs flow through `a`, which must outlive the table (an h2 conn's
# tables live as long as the conn). Entries are the table's own copies
# (see Storage above). Returns 0 on OOM.
fn sandhi_hpack_table_new_a(a, max_size): i64 {
    var t = alloc_via(a, SANDHI_HPACK_TABLE_STRUCT_SIZE);
    if (t == 0) { return 0; }
    # 1.13.3 — both vecs must land, or there is no table (they were stored
    # unchecked, and the first entry added pushed onto a null vec).
    var names = vec_new_a(a);
    if (names == 0) { return 0; }
    var values = vec_new_a(a);
    if (values == 0) { return 0; }
    store64(t + SANDHI_HPACK_TBL_OFF_NAMES, names);
    store64(t + SANDHI_HPACK_TBL_OFF_VALUES, values);
    store64(t + SANDHI_HPACK_TBL_OFF_CUR_SIZE, 0);
    var ms = max_size;
    if (ms <= 0) { ms = SANDHI_HPACK_DEFAULT_TABLE_SIZE; }
    store64(t + SANDHI_HPACK_TBL_OFF_MAX_SIZE, ms);
    store64(t + SANDHI_HPACK_TBL_OFF_LIMIT, ms);
    return t;
}

fn sandhi_hpack_table_new(max_size): i64 {
    return sandhi_hpack_table_new_a(default_alloc(), max_size);
}

fn sandhi_hpack_table_count(t): i64 {
    if (t == 0) { return 0; }
    return vec_len(load64(t + SANDHI_HPACK_TBL_OFF_NAMES));
}

fn sandhi_hpack_table_size(t): i64 {
    if (t == 0) { return 0; }
    return load64(t + SANDHI_HPACK_TBL_OFF_CUR_SIZE);
}

fn sandhi_hpack_table_max_size(t): i64 {
    if (t == 0) { return SANDHI_HPACK_DEFAULT_TABLE_SIZE; }
    return load64(t + SANDHI_HPACK_TBL_OFF_MAX_SIZE);
}

fn _hpack_entry_size(name, value): i64 {
    return strlen(name) + strlen(value) + SANDHI_HPACK_ENTRY_OVERHEAD;
}

# Drop oldest entries until cur_size + need ≤ max_size, freeing each
# entry's block. Used by add() before insertion and by set_max_size()
# on shrink.
fn _hpack_table_evict_until_fits(t, need): i64 {
    var names = load64(t + SANDHI_HPACK_TBL_OFF_NAMES);
    var values = load64(t + SANDHI_HPACK_TBL_OFF_VALUES);
    var cur = load64(t + SANDHI_HPACK_TBL_OFF_CUR_SIZE);
    var max = load64(t + SANDHI_HPACK_TBL_OFF_MAX_SIZE);
    while (cur + need > max && vec_len(names) > 0) {
        var n = vec_get(names, 0);
        var v = vec_get(values, 0);
        cur = cur - _hpack_entry_size(n, v);
        vec_remove(names, 0);
        vec_remove(values, 0);
        fl_free(n);
    }
    store64(t + SANDHI_HPACK_TBL_OFF_CUR_SIZE, cur);
    return 0;
}

# Insert a copy of (name, value) as the newest entry. Evicts as needed.
# If the entry is larger than max_size, the table is emptied and the
# entry dropped (RFC 7541 §4.4). Returns 0. An allocation failure drops
# the insert and leaves the table as the eviction left it, the same
# observable outcome as the §4.4 drop.
#
# `a` is unused since 1.13.6 (the table owns its storage, see above); the
# parameter stays for the call sites.
#
# 1.9.13 — never install a half-built table. The rebuild that guard
# protected is gone: an add now appends one block to each vec, and a
# failed push takes nothing with it.
fn sandhi_hpack_table_add_a(a, t, name, value): i64 {
    if (t == 0) { return 0; }
    var sz = _hpack_entry_size(name, value);
    var max = load64(t + SANDHI_HPACK_TBL_OFF_MAX_SIZE);
    if (sz > max) {
        _hpack_table_evict_until_fits(t, max + 1);
        return 0;
    }
    _hpack_table_evict_until_fits(t, sz);
    var nlen = strlen(name);
    var vlen = strlen(value);
    var blk = fl_alloc(nlen + vlen + 2);
    if (blk == 0) { return 0; }
    memcpy(blk, name, nlen);
    store8(blk + nlen, 0);
    memcpy(blk + nlen + 1, value, vlen);
    store8(blk + nlen + 1 + vlen, 0);
    var names = load64(t + SANDHI_HPACK_TBL_OFF_NAMES);
    var values = load64(t + SANDHI_HPACK_TBL_OFF_VALUES);
    if (vec_push_a(default_alloc(), names, blk) != 0) {
        fl_free(blk);
        return 0;
    }
    if (vec_push_a(default_alloc(), values, blk + nlen + 1) != 0) {
        vec_pop(names);
        fl_free(blk);
        return 0;
    }
    store64(t + SANDHI_HPACK_TBL_OFF_CUR_SIZE,
      load64(t + SANDHI_HPACK_TBL_OFF_CUR_SIZE) + sz);
    return 0;
}

fn sandhi_hpack_table_add(t, name, value): i64 {
    return sandhi_hpack_table_add_a(default_alloc(), t, name, value);
}

# Update max_size; shrink immediately if needed (peer sent a
# Dynamic-Table-Size-Update or a SETTINGS_HEADER_TABLE_SIZE change).
# Uncapped: the encoder table follows the peer's SETTINGS, whatever they
# are. The decoder bounds a peer's size update itself (§6.3 below).
fn sandhi_hpack_table_set_max_size(t, max_size): i64 {
    if (t == 0) { return 0; }
    store64(t + SANDHI_HPACK_TBL_OFF_MAX_SIZE, max_size);
    _hpack_table_evict_until_fits(t, 0);
    return 0;
}

# Index lookup. Static = 1..61; dynamic = 62..(61+count), 62 newest.
# Returns (name, value) cstrs via out cells; -1 on bad index. A dynamic
# entry's strings are the table's: valid until the next add or eviction
# on it (1.13.6; `sandhi_hpack_decode_field_a` hands out copies).
fn sandhi_hpack_lookup(t, idx, name_out, value_out): i64 {
    var static_count = sandhi_hpack_static_size();
    # No static table (out of memory): no index can be placed.
    if (static_count == 0) { return _SANDHI_HPACK_ERR_TRUNCATED; }
    if (idx < 1) { return _SANDHI_HPACK_ERR_BAD_INDEX; }
    if (idx <= static_count) {
        store64(name_out,  sandhi_hpack_static_name(idx));
        store64(value_out, sandhi_hpack_static_value(idx));
        return 0;
    }
    var dyn_idx = idx - static_count - 1;  # 62 → 0, the newest
    if (t == 0) { return _SANDHI_HPACK_ERR_BAD_INDEX; }
    var names = load64(t + SANDHI_HPACK_TBL_OFF_NAMES);
    var values = load64(t + SANDHI_HPACK_TBL_OFF_VALUES);
    var n = vec_len(names);
    if (dyn_idx >= n) { return _SANDHI_HPACK_ERR_BAD_INDEX; }
    store64(name_out,  vec_get(names, n - 1 - dyn_idx));
    store64(value_out, vec_get(values, n - 1 - dyn_idx));
    return 0;
}

# ================================================================
# Integer encoding (RFC 7541 §5.1)
# ================================================================
#
# 1.13.7 (cyrius 6.7.18's D1) — the decoders read the peer's block
# through a fn-local `[u8]` slice over (buf, blen): every `s[i]` is
# bounds-checked in every build, so a read past the block (or before it)
# stops the process with `slice bounds violation` (exit 134) instead of
# answering bytes that are not the peer's. Through 1.13.6 they were raw
# `load8(buf + off)`s, checked only by each fn's own arithmetic.
#
# encode: writes prefix byte + continuation bytes into `out` starting
# at offset `off`. Returns new offset. `prefix_bits` is N (4-7);
# `prefix_high` is the high (8-N) bits already set in out[off] —
# typically the representation type marker.
#
# decode: reads prefix bits from buf[off] (already extracted by
# caller) plus continuation bytes. Returns the decoded int via
# `value_out`, updates `off_cell` to next byte; returns 0 on success
# or a negative error sentinel.

fn _hpack_int_encode(out, off, prefix_high, prefix_bits, value): i64 {
    var max_prefix = (1 << prefix_bits) - 1;
    if (value < max_prefix) {
        store8(out + off, prefix_high | value);
        return off + 1;
    }
    store8(out + off, prefix_high | max_prefix);
    var p = off + 1;
    var v = value - max_prefix;
    while (v >= 128) {
        store8(out + p, (v & 0x7F) | 0x80);
        p = p + 1;
        v = v >> 7;
    }
    store8(out + p, v);
    return p + 1;
}

# The largest integer the decoder answers. Every HPACK integer sandhi
# reads is an index, a string length or a table size: 32-bit quantities.
const _SANDHI_HPACK_INT_MAX = 0xFFFFFFFF;

# 1.13.7 — a value past `_SANDHI_HPACK_INT_MAX` is an INT_OVERFLOW (RFC
# 7541 §5.1: an integer past the implementation's limit is a decoding
# error), checked as each continuation byte lands. Through 1.13.6 nine
# continuation bytes were allowed, and the sum wrapped into a negative
# value the caller took as a length, index or table size.
fn _hpack_int_decode(buf, blen, off_cell, prefix_bits, value_out): i64 {
    var s: [u8] = 0;
    slice_set(&s, buf, blen);
    var off = load64(off_cell);
    if (off >= blen) { return _SANDHI_HPACK_ERR_TRUNCATED; }
    var max_prefix = (1 << prefix_bits) - 1;
    var first = s[off] & max_prefix;
    off = off + 1;
    if (first < max_prefix) {
        store64(value_out, first);
        store64(off_cell, off);
        return 0;
    }
    var i = first;
    var m = 0;
    loop {
        if (off >= blen) { return _SANDHI_HPACK_ERR_TRUNCATED; }
        if (m > 28) { return _SANDHI_HPACK_ERR_INT_OVERFLOW; }
        var b = s[off];
        off = off + 1;
        i = i + ((b & 0x7F) << m);
        if (i > _SANDHI_HPACK_INT_MAX) { return _SANDHI_HPACK_ERR_INT_OVERFLOW; }
        if ((b & 0x80) == 0) { break; }
        m = m + 7;
    }
    store64(value_out, i);
    store64(off_cell, off);
    return 0;
}

# ================================================================
# String encoding (RFC 7541 §5.2)
# ================================================================
#
# Encode: 7-bit length prefix with the H bit (high bit of the prefix
# byte) set per representation choice. Since 0.9.8, the encoder
# probes the Huffman size first and picks Huffman when strictly
# smaller than raw. `huffman.cyr`'s `sandhi_hpack_huffman_encoded_len`
# answers the probe; `sandhi_hpack_huffman_encode` writes the bytes
# (MSB-first packing, EOS-prefix padding on the final byte).
#
# Wire-size impact: ~25-30% smaller for ASCII text headers, matching
# the canonical RFC 7541 Appendix C.4 examples. Binary / short tokens
# often round-trip larger under Huffman — we keep raw for those.

fn _hpack_string_encode(out, off, s): i64 {
    var raw_len = strlen(s);
    var huff_len = sandhi_hpack_huffman_encoded_len(s);
    if (huff_len >= 0 && huff_len < raw_len) {
        var ph = _hpack_int_encode(out, off, 0x80, 7, huff_len);  # H=1
        return sandhi_hpack_huffman_encode(out, ph, s);
    }
    var p = _hpack_int_encode(out, off, 0, 7, raw_len);  # H=0
    var i = 0;
    while (i < raw_len) {
        store8(out + p + i, load8(s + i));
        i = i + 1;
    }
    return p + raw_len;
}

# Decode a string into `a`. Both the transient length cell and the
# returned cstr (or Huffman-decoded cstr) live in `a`; arena reset
# after the caller has copied/consumed the string reclaims everything.
fn _hpack_string_decode_a(a, buf, blen, off_cell, out_cell): i64 {
    var s: [u8] = 0;
    slice_set(&s, buf, blen);
    var off = load64(off_cell);
    if (off >= blen) { return _SANDHI_HPACK_ERR_TRUNCATED; }
    var huffman = (s[off] & 0x80) >> 7;
    var len_cell = alloc_via(a, 8);
    if (len_cell == 0) { return _SANDHI_HPACK_ERR_TRUNCATED; }
    store64(len_cell, 0);
    var ir = _hpack_int_decode(buf, blen, off_cell, 7, len_cell);
    if (ir < 0) { return ir; }
    var slen = load64(len_cell);
    var soff = load64(off_cell);
    if (soff + slen > blen) { return _SANDHI_HPACK_ERR_TRUNCATED; }
    if (huffman == 1) {
        var dec = sandhi_hpack_huffman_decode_a(a, buf, soff, slen);
        if (dec == 0) {
            store64(off_cell, soff + slen);
            return _SANDHI_HPACK_ERR_HUFFMAN;
        }
        store64(off_cell, soff + slen);
        store64(out_cell, dec);
        return 0;
    }
    var out = alloc_via(a, slen + 1);
    if (out == 0) { return _SANDHI_HPACK_ERR_TRUNCATED; }
    var i = 0;
    while (i < slen) {
        store8(out + i, s[soff + i]);
        i = i + 1;
    }
    store8(out + slen, 0);
    store64(off_cell, soff + slen);
    store64(out_cell, out);
    return 0;
}

fn _hpack_string_decode(buf, blen, off_cell, out_cell): i64 {
    return _hpack_string_decode_a(default_alloc(), buf, blen, off_cell, out_cell);
}

# ================================================================
# Header field encoding (RFC 7541 §6)
# ================================================================
#
# All encoders write into a caller-allocated `out` buffer starting at
# offset `off` and return the new offset. Caller is responsible for
# sizing `out` adequately (worst case: ~5 bytes overhead per header
# + name + value bytes + Huffman-disable so always raw).

# §6.1 Indexed Header Field — single byte 1xxxxxxx (7-bit prefix).
fn sandhi_hpack_encode_indexed(out, off, idx): i64 {
    return _hpack_int_encode(out, off, 0x80, 7, idx);
}

# §6.2.1 Literal with Incremental Indexing.
# 01xxxxxx (6-bit prefix on name index; 0 = inline name).
# Caller passes name_idx=0 + name string for inline, or name_idx>0 for
# indexed-name variant.
fn sandhi_hpack_encode_literal_indexed(t, out, off, name, value): i64 {
    var p = _hpack_int_encode(out, off, 0x40, 6, 0);  # name_idx=0 (inline)
    p = _hpack_string_encode(out, p, name);
    p = _hpack_string_encode(out, p, value);
    if (t != 0) { sandhi_hpack_table_add(t, name, value); }
    return p;
}

# §6.2.1 Literal with Incremental Indexing, indexed name — 01xxxxxx
# (6-bit prefix). Emits the name by table index `name_idx` + the literal
# `value` into `out` at `off`; also inserts (name, value) into the dynamic
# table `t` when `t != 0`. Returns the new write offset.
fn sandhi_hpack_encode_literal_indexed_name(t, out, off, name_idx, name, value): i64 {
    var p = _hpack_int_encode(out, off, 0x40, 6, name_idx);
    p = _hpack_string_encode(out, p, value);
    if (t != 0) { sandhi_hpack_table_add(t, name, value); }
    return p;
}

# §6.2.2 Literal without Indexing — 0000xxxx (4-bit prefix).
fn sandhi_hpack_encode_literal_no_index(out, off, name, value): i64 {
    var p = _hpack_int_encode(out, off, 0x00, 4, 0);
    p = _hpack_string_encode(out, p, name);
    p = _hpack_string_encode(out, p, value);
    return p;
}

# §6.2.2 Literal without Indexing, indexed name — 0000xxxx (4-bit prefix
# on the name index) + the literal `value`. Leaves every table alone. The
# request encoder's form since 1.13.6.
fn _hpack_encode_literal_no_index_name(out, off, name_idx, value): i64 {
    var p = _hpack_int_encode(out, off, 0x00, 4, name_idx);
    return _hpack_string_encode(out, p, value);
}

# §6.2.3 Literal Never Indexed — 0001xxxx (4-bit prefix).
fn sandhi_hpack_encode_literal_never(out, off, name, value): i64 {
    var p = _hpack_int_encode(out, off, 0x10, 4, 0);
    p = _hpack_string_encode(out, p, name);
    p = _hpack_string_encode(out, p, value);
    return p;
}

# §6.3 Dynamic Table Size Update — 001xxxxx (5-bit prefix).
fn sandhi_hpack_encode_table_size_update(out, off, new_max_size): i64 {
    return _hpack_int_encode(out, off, 0x20, 5, new_max_size);
}

# ================================================================
# Header field decoding (RFC 7541 §6)
# ================================================================
#
# Decode one header field starting at off_cell. On success, writes the
# decoded name + value cstrs (caller-owned) to name_out / value_out
# and updates the dynamic table when the representation requires.
# Returns 0 on success or a negative error sentinel.
#
# A "dynamic-table-size-update" representation has no associated
# header — sandhi_hpack_decode_field returns a special sentinel
# `_SANDHI_HPACK_TBL_UPDATE` (positive non-zero) and writes the new
# max size to `value_out` (re-purposed; name_out is set to 0).

const _SANDHI_HPACK_TBL_UPDATE = 1;  # not zero so caller can distinguish

# Copy a dynamic-table string out to `a`, so a decoded field never points
# into the table (its entries are freed on eviction). Static strings are
# literals and stay as they are. 0, or a negative sentinel on OOM.
fn _hpack_own_a(a, idx, cell): i64 {
    if (idx <= sandhi_hpack_static_size()) { return 0; }
    var src = load64(cell);
    var n = strlen(src);
    var cp = alloc_via(a, n + 1);
    if (cp == 0) { return _SANDHI_HPACK_ERR_TRUNCATED; }
    memcpy(cp, src, n + 1);
    store64(cell, cp);
    return 0;
}

# Decode one HPACK header field into `a`. Every transient cell + the
# decoded name + value cstrs live in `a`. An incremental-indexing
# insert copies the field into the table's own storage (1.13.6; through
# 1.13.5 it inserted these `a` pointers, and rebuilt the table's vecs
# in `a`, so a per-request arena reset left the conn's table pointing
# into reused memory).
fn sandhi_hpack_decode_field_a(a, t, buf, blen, off_cell, name_out, value_out): i64 {
    var s: [u8] = 0;
    slice_set(&s, buf, blen);
    var off = load64(off_cell);
    if (off >= blen) { return _SANDHI_HPACK_ERR_TRUNCATED; }
    var first = s[off];

    if ((first & 0x80) != 0) {
        # 1xxxxxxx — Indexed Header Field.
        var idx_cell = alloc_via(a, 8);
        if (idx_cell == 0) { return _SANDHI_HPACK_ERR_TRUNCATED; }
        var ir = _hpack_int_decode(buf, blen, off_cell, 7, idx_cell);
        if (ir < 0) { return ir; }
        var idx = load64(idx_cell);
        if (idx == 0) { return _SANDHI_HPACK_ERR_MALFORMED; }
        var lr0 = sandhi_hpack_lookup(t, idx, name_out, value_out);
        if (lr0 < 0) { return lr0; }
        if (_hpack_own_a(a, idx, name_out) < 0) { return _SANDHI_HPACK_ERR_TRUNCATED; }
        return _hpack_own_a(a, idx, value_out);
    }

    if ((first & 0xC0) == 0x40) {
        # 01xxxxxx — Literal with Incremental Indexing.
        var idx_cell = alloc_via(a, 8);
        if (idx_cell == 0) { return _SANDHI_HPACK_ERR_TRUNCATED; }
        var ir = _hpack_int_decode(buf, blen, off_cell, 6, idx_cell);
        if (ir < 0) { return ir; }
        var name_idx = load64(idx_cell);
        var name = 0;
        var name_held = alloc_via(a, 8);
        if (name_held == 0) { return _SANDHI_HPACK_ERR_TRUNCATED; }
        store64(name_held, 0);
        if (name_idx == 0) {
            var sr = _hpack_string_decode_a(a, buf, blen, off_cell, name_held);
            if (sr < 0) { return sr; }
            name = load64(name_held);
        } else {
            var v_unused = alloc_via(a, 8);
            if (v_unused == 0) { return _SANDHI_HPACK_ERR_TRUNCATED; }
            var lr = sandhi_hpack_lookup(t, name_idx, name_held, v_unused);
            if (lr < 0) { return lr; }
            if (_hpack_own_a(a, name_idx, name_held) < 0) { return _SANDHI_HPACK_ERR_TRUNCATED; }
            name = load64(name_held);
        }
        var val_cell = alloc_via(a, 8);
        if (val_cell == 0) { return _SANDHI_HPACK_ERR_TRUNCATED; }
        var sr2 = _hpack_string_decode_a(a, buf, blen, off_cell, val_cell);
        if (sr2 < 0) { return sr2; }
        var value = load64(val_cell);
        store64(name_out, name);
        store64(value_out, value);
        sandhi_hpack_table_add_a(a, t, name, value);
        return 0;
    }

    if ((first & 0xE0) == 0x20) {
        # 001xxxxx — Dynamic Table Size Update.
        var sz_cell = alloc_via(a, 8);
        if (sz_cell == 0) { return _SANDHI_HPACK_ERR_TRUNCATED; }
        var ir = _hpack_int_decode(buf, blen, off_cell, 5, sz_cell);
        if (ir < 0) { return ir; }
        # 1.13.7 (CYRIUS-2026-0044) — RFC 7541 §6.3 / §4.2: a size above
        # the one this decoder's endpoint advertised (sandhi sends no
        # SETTINGS_HEADER_TABLE_SIZE, so the 4096 default) is a decoding
        # error, an HTTP/2 COMPRESSION_ERROR. Through 1.13.6 any size was
        # applied, so a server grew the client's decode table without bound.
        if (t != 0 && load64(sz_cell) > load64(t + SANDHI_HPACK_TBL_OFF_LIMIT)) {
            return _SANDHI_HPACK_ERR_MALFORMED;
        }
        sandhi_hpack_table_set_max_size(t, load64(sz_cell));
        store64(name_out, 0);
        store64(value_out, load64(sz_cell));
        return _SANDHI_HPACK_TBL_UPDATE;
    }

    # 0000xxxx (no-index) or 0001xxxx (never-index) — 4-bit prefix.
    var idx_cell = alloc_via(a, 8);
    if (idx_cell == 0) { return _SANDHI_HPACK_ERR_TRUNCATED; }
    var ir = _hpack_int_decode(buf, blen, off_cell, 4, idx_cell);
    if (ir < 0) { return ir; }
    var name_idx = load64(idx_cell);
    var name = 0;
    var name_held = alloc_via(a, 8);
    if (name_held == 0) { return _SANDHI_HPACK_ERR_TRUNCATED; }
    store64(name_held, 0);
    if (name_idx == 0) {
        var sr = _hpack_string_decode_a(a, buf, blen, off_cell, name_held);
        if (sr < 0) { return sr; }
        name = load64(name_held);
    } else {
        var v_unused = alloc_via(a, 8);
        if (v_unused == 0) { return _SANDHI_HPACK_ERR_TRUNCATED; }
        var lr = sandhi_hpack_lookup(t, name_idx, name_held, v_unused);
        if (lr < 0) { return lr; }
        if (_hpack_own_a(a, name_idx, name_held) < 0) { return _SANDHI_HPACK_ERR_TRUNCATED; }
        name = load64(name_held);
    }
    var val_cell = alloc_via(a, 8);
    if (val_cell == 0) { return _SANDHI_HPACK_ERR_TRUNCATED; }
    var sr2 = _hpack_string_decode_a(a, buf, blen, off_cell, val_cell);
    if (sr2 < 0) { return sr2; }
    store64(name_out, name);
    store64(value_out, load64(val_cell));
    return 0;
}

fn sandhi_hpack_decode_field(t, buf, blen, off_cell, name_out, value_out): i64 {
    return sandhi_hpack_decode_field_a(default_alloc(), t, buf, blen, off_cell, name_out, value_out);
}

