[package]
name = "sandhi"
version = "${file:VERSION}"
description = "Service-boundary layer for AGNOS — shared HTTP/TCP/TLS + service discovery"
license = "GPL-3.0-only"
repository = "https://github.com/MacCracken/sandhi"
language = "cyrius"
cyrius = "6.6.18"

[build]
entry = "programs/smoke.cyr"
output = "build/sandhi-smoke"

[lib]
modules = [
    "src/version_str.cyr",
    "src/error.cyr",
    "src/obs/trace.cyr",
    "src/obs/prof.cyr",
    "src/http/headers.cyr",
    "src/http/url.cyr",
    "src/tls_policy/session_cache.cyr",
    "src/http/conn.cyr",
    "src/tls_policy/policy.cyr",
    "src/tls_policy/fingerprint.cyr",
    "src/tls_policy/apply.cyr",
    "src/http/response.cyr",
    "src/net/resolve.cyr",
    "src/http/client.cyr",
    "src/http/pool.cyr",
    "src/http/h2/huffman.cyr",
    "src/http/h2/hpack.cyr",
    "src/http/h2/frame.cyr",
    "src/http/h2/conn.cyr",
    "src/http/h2/request.cyr",
    "src/http/h2/response.cyr",
    "src/http/h2/pool_glue.cyr",
    "src/http/h2/dispatch.cyr",
    "src/http/retry.cyr",
    "src/http/sse.cyr",
    "src/http/stream.cyr",
    "src/http/download.cyr",
    "src/tls_policy/alpn.cyr",
    "src/tls_policy/mod.cyr",
    "src/rpc/json.cyr",
    "src/rpc/dispatch.cyr",
    "src/rpc/webdriver.cyr",
    "src/rpc/appium.cyr",
    "src/rpc/mcp.cyr",
    "src/rpc/mod.cyr",
    "src/discovery/service.cyr",
    "src/discovery/chain.cyr",
    "src/discovery/daimon.cyr",
    "src/discovery/local.cyr",
    "src/discovery/register.cyr",
    "src/discovery/mod.cyr",
    "src/server/mod.cyr",
    "src/main.cyr",
]

[lib.tls]
modules = [
    "src/tls_policy/session_cache.cyr",
    "src/http/conn.cyr",
    "src/tls_policy/policy.cyr",
    "src/tls_policy/fingerprint.cyr",
    "src/tls_policy/apply.cyr",
    "src/tls_policy/alpn.cyr",
    "src/tls_policy/mod.cyr",
]

[lib.server]
modules = [
    "src/tls_policy/session_cache.cyr",
    "src/http/conn.cyr",
    "src/server/mod.cyr",
]

[lib.rpc]
modules = [
    "src/version_str.cyr",
    "src/error.cyr",
    "src/obs/trace.cyr",
    "src/obs/prof.cyr",
    "src/http/headers.cyr",
    "src/http/url.cyr",
    "src/tls_policy/session_cache.cyr",
    "src/http/conn.cyr",
    "src/tls_policy/policy.cyr",
    "src/tls_policy/fingerprint.cyr",
    "src/tls_policy/apply.cyr",
    "src/http/response.cyr",
    "src/net/resolve.cyr",
    "src/http/client.cyr",
    "src/http/pool.cyr",
    "src/http/sse.cyr",
    "src/http/stream.cyr",
    "src/rpc/json.cyr",
    "src/rpc/dispatch.cyr",
    "src/rpc/webdriver.cyr",
    "src/rpc/appium.cyr",
    "src/rpc/mcp.cyr",
    "src/rpc/mod.cyr",
    "src/main.cyr",
]

[lib.discovery]
modules = [
    "src/version_str.cyr",
    "src/error.cyr",
    "src/obs/trace.cyr",
    "src/obs/prof.cyr",
    "src/http/headers.cyr",
    "src/http/url.cyr",
    "src/tls_policy/session_cache.cyr",
    "src/http/conn.cyr",
    "src/tls_policy/policy.cyr",
    "src/tls_policy/fingerprint.cyr",
    "src/tls_policy/apply.cyr",
    "src/http/response.cyr",
    "src/net/resolve.cyr",
    "src/http/client.cyr",
    "src/http/pool.cyr",
    "src/rpc/json.cyr",
    "src/discovery/service.cyr",
    "src/discovery/chain.cyr",
    "src/discovery/daimon.cyr",
    "src/discovery/local.cyr",
    "src/discovery/register.cyr",
    "src/discovery/mod.cyr",
    "src/main.cyr",
]

[deps]
stdlib = [
    "syscalls",
    "alloc",
    "fmt",
    "io",
    "fs",
    "str",
    "string",
    "vec",
    "args",
    "hashmap",
    "process",
    "thread",
    "fnptr",
    "async",
    "atomic",
    "chrono",
    "tagged",
    "assert",
    "regression",
    "mmap",
    "dynlib",
    "fdlopen",
    "net",
    "http",
    "tls",
    "ws",
    "sakshi",
    "sigil",
]
