# programs/_server_tls_probe.cyr — 1.6.8 live gate for server-side TLS
# (sandhi_server_run_pooled_tls + the conn seam + conn-aware routing).
#
# Closes the headline yeo-cy-test bite: "sandhi has NO server-side TLS." This
# proves sandhi can SERVE HTTPS end to end, using sandhi's OWN client to drive
# it (client + server both sandhi, native TLS stack, no openssl dependency).
#
# Forks: child runs a POOLED TLS server (4 worker threads) on 127.0.0.1 with a
# one-route table `GET /notes/:id` (echoes the captured :id), reading the
# Ed25519 test cert (DER leaf) + key (PEM) from programs/_tls_fixtures/.
# Parent (run from the repo root) asserts, over real TLS 1.3 handshakes:
#   [1] burst of 8 HTTPS GETs with a trust-store policy (cert.pem as the CA)
#       → all 200 + body "55"   (serving + routing + cert verify SUCCEEDS).
#       NOTE: SEQUENTIAL — each _https_get completes before the next, so this
#       never drives two handshakes at the same instant.
#   [2] a DEFAULT-policy client (no trust store) → must NOT get 200
#       (the self-signed cert is rejected — verify is NOT bypassed; mirrors the
#        probe's "default-CA client rejected" finding)
#   [3] accept-loop isolation: hold a SILENT *plaintext* raw-TCP connection open
#       (pins one worker in the handshake read until SO_RCVTIMEO) and confirm real
#       HTTPS requests STILL serve on the other workers. This exercises accept /
#       handoff non-serialization, NOT a second concurrent TLS handshake (the
#       silent socket is use_tls=0).
#   [4] concurrent TLS handshakes (GATING as of sandhi 1.8.0 / cyrius 6.4.49):
#       fork pairs of clients that handshake at the SAME instant against the
#       4-worker pool — the property a multi-worker HTTPS pool promises. This
#       was unsafe through sandhi 1.7.0 / cyrius 6.3.5 (0/16: sigil's crypto
#       primitives raced process-global scratch — filed
#       2026-06-28-concurrent-tls-handshake-global-scratch-race). sigil fixed it
#       by auto-banking a private crypto-scratch lane per thread (since 3.9.7;
#       vendored 3.11.1 under the 6.4.49 pin), so simultaneous handshakes are now
#       race-free (verified 16/16). [4] is therefore a GATE: a shortfall is a
#       real regression (a sigil/cyrius pin that broke the per-thread lanes, or a
#       max_conns>1 HTTPS break), NOT a tolerated limitation.
#
#   [5] whole-request budget over TLS (1.10.7): a raw client that dribbles a TLS
#       record one byte every 300 ms never trips the 1 s per-read idle_ms, so
#       through 1.10.6 it held a worker in the handshake indefinitely. With
#       request_ms 1500 the server must drop it at about 1.5 s.
#   [6] policy-hook isolation (1.10.7): one trust-store thread and three
#       no-policy threads request concurrently. Through 1.10.6 the policy hook
#       was a process-wide global, so a no-policy request could run under the
#       trust store another thread armed and ACCEPT the self-signed cert its
#       own default verification rejects (162-167 of 180 measured). Every
#       no-policy request must fail; the trust-store requests must succeed.
#   [7] a policied open never touches the TLS session cache (1.10.7): the key
#       does not identify the policy, so with the cache enabled a session made
#       under one policy was offered to the next (a TLS 1.2 resumption on the
#       libssl backend skipped the trust store). With the cache on, a policied
#       request must make no lookup and no store.
#   [8] per-request arena on HTTPS (1.10.7): with `req_arena` set, a TLS
#       handler sees `sandhi_server_request_arena()` (it was 0: the TLS worker
#       never created one), and 40 routed requests grow the server's global
#       heap by at most 128 B each. The remaining ~120 B/accept is the stdlib's
#       PEM key decode (lib/sigil.cyr pem_decode_privkey); a DER key measures 0.
#       Through 1.10.6 the documented handler shape grew it 472 B/request.
#
# Skip-cleanly (exit 0) if TLS is unavailable or the fixtures are missing.
# Exit 0 = PASS / clean-SKIP; non-zero = FAIL. All eight checks contribute to FAIL.
include "lib/thread_local.cyr"
include "lib/ct.cyr"
include "lib/keccak.cyr"
include "lib/sigil.cyr"
include "src/version_str.cyr"
include "src/error.cyr"
include "src/obs/trace.cyr"
include "src/obs/prof.cyr"
include "src/http/headers.cyr"
include "src/http/url.cyr"
include "src/tls_policy/session_cache.cyr"
include "src/http/conn.cyr"
include "src/tls_policy/policy.cyr"
include "src/tls_policy/fingerprint.cyr"
include "src/tls_policy/apply.cyr"
include "src/http/response.cyr"
include "src/net/resolve.cyr"
include "src/http/client.cyr"
include "src/http/pool.cyr"
include "src/http/h2/huffman.cyr"
include "src/http/h2/hpack.cyr"
include "src/http/h2/frame.cyr"
include "src/http/h2/conn.cyr"
include "src/http/h2/request.cyr"
include "src/http/h2/response.cyr"
include "src/http/h2/pool_glue.cyr"
include "src/http/h2/dispatch.cyr"
include "src/http/sse.cyr"
include "src/http/stream.cyr"
include "src/http/download.cyr"
include "src/tls_policy/alpn.cyr"
include "src/tls_policy/mod.cyr"
include "src/rpc/json.cyr"
include "src/rpc/dispatch.cyr"
include "src/rpc/webdriver.cyr"
include "src/rpc/appium.cyr"
include "src/rpc/mcp.cyr"
include "src/rpc/mod.cyr"
include "src/discovery/service.cyr"
include "src/discovery/chain.cyr"
include "src/discovery/daimon.cyr"
include "src/discovery/local.cyr"
include "src/discovery/register.cyr"
include "src/discovery/mod.cyr"
include "src/server/mod.cyr"
include "src/main.cyr"

fn say(m) { syscall(1, 1, m, strlen(m)); return 0; }

var CERT_PATH = "programs/_tls_fixtures/cert.der";   # DER leaf — native server cert
var KEY_PATH  = "programs/_tls_fixtures/key.pem";    # PEM — Ed25519 key
var CA_PATH   = "programs/_tls_fixtures/cert.pem";   # PEM — client trust anchor

# Conn route handler (fncall5 shape: ctx, conn, buf, blen, params). Allocates
# through the per-request arena when the server has one (`req_arena`), which is
# the shape that keeps a long-running HTTPS server's heap flat.
fn note_handler(ctx, conn, buf, blen, params): i64 {
    var a = sandhi_server_request_arena();
    if (a == 0) { a = default_alloc(); }
    var id = sandhi_route_param_a(a, params, 0);
    sandhi_server_send_response_c_a(a, conn, 200, "OK", "text/plain", id, strlen(id), 0);
    return 0;
}

# [8] "1" when this worker handed the handler a per-request arena, else "0".
fn arena_handler(ctx, conn, buf, blen, params): i64 {
    var a = sandhi_server_request_arena();
    var b = "1";
    if (a == 0) { b = "0"; a = default_alloc(); }
    sandhi_server_send_response_c_a(a, conn, 200, "OK", "text/plain", b, 1, 0);
    return 0;
}

# [8] the server process's global-heap usage, in decimal, written from a stack buffer.
fn mem_handler(ctx, conn, buf, blen, params): i64 {
    var digits[32];
    var v = alloc_used();
    var n = 0;
    var tmp[32];
    if (v == 0) { store8(&tmp, 48); n = 1; }
    while (v > 0) { store8(&tmp + n, 48 + (v % 10)); v = v / 10; n = n + 1; }
    var i = 0;
    while (i < n) { store8(&digits + i, load8(&tmp + n - 1 - i)); i = i + 1; }
    var a = sandhi_server_request_arena();
    if (a == 0) { a = default_alloc(); }
    sandhi_server_send_response_c_a(a, conn, 200, "OK", "text/plain", &digits, n, 0);
    return 0;
}

# GET and return the body as an integer (decimal), or -1.
fn _https_get_int(url, policy): i64 {
    var opts = sandhi_http_options_new();
    sandhi_http_options_tls_policy(opts, policy);
    var r = sandhi_http_get_opts(url, 0, opts);
    if (r == 0) { return 0 - 1; }
    if (sandhi_http_err_kind(r) != SANDHI_OK || sandhi_http_status(r) != 200) { return 0 - 1; }
    var b = sandhi_http_body(r);
    var bl = sandhi_http_body_len(r);
    var v = 0;
    var i = 0;
    while (i < bl) { v = v * 10 + (load8(b + i) - 48); i = i + 1; }
    return v;
}

# Does the response body contain "55"?
fn _has_55(body, blen): i64 {
    var i = 0;
    while (i + 1 < blen) {
        if (load8(body + i) == 53 && load8(body + i + 1) == 53) { return 1; }
        i = i + 1;
    }
    return 0;
}

# One HTTPS GET with the given TLS policy (0 = default/no-trust-store). Returns
# the status code, or a negative error kind if the request failed (e.g. the
# handshake's cert verify rejected the server).
fn _https_get(url, policy): i64 {
    var opts = sandhi_http_options_new();
    if (policy != 0) { sandhi_http_options_tls_policy(opts, policy); }
    var r = sandhi_http_get_opts(url, 0, opts);
    if (r == 0) { return 0 - 99; }
    var ek = sandhi_http_err_kind(r);
    if (ek != SANDHI_OK) { return 0 - ek; }
    if (_has_55(sandhi_http_body(r), sandhi_http_body_len(r)) == 0) { return 0 - 50; }
    return sandhi_http_status(r);
}

# wait4(pid) → child's effective result code: WEXITSTATUS on a normal exit, or 1
# if the child was killed by a signal (a crashing concurrent handshake takes the
# whole server process — and any child blocked on its dead socket — down).
fn _wait_code(pid): i64 {
    var st = alloc(8);
    store64(st, 0);
    syscall(61, pid, st, 0, 0);          # wait4(pid, &status, 0, 0)
    var status = load64(st);
    if ((status & 127) != 0) { return 1; }   # WIFSIGNALED → treat as failure
    return (status >> 8) & 255;              # WEXITSTATUS
}

# Child body for a [4] worker: align to the shared instant, fire ONE HTTPS GET,
# exit 0 iff it returned 200. The fixed pre-connect sleep lets sibling forks (a
# few µs apart) converge so their handshakes actually overlap at the server.
fn _conc_child(url, trust): i64 {
    async_sleep_ms(120);
    if (_https_get(url, trust) == 200) { syscall(60, 0); }
    syscall(60, 1);
    return 0;
}

# [6] workers: each fires `_h6_n` GETs at the shared URL, with the trust-store
# policy or with none, and counts the 200s.
var _h6_url = 0;
var _h6_trust = 0;
var _h6_n = 30;
var _h6_trust_ok = 0;
var _h6_open_ok = 0;

fn _h6_trust_worker(arg) {
    var i = 0;
    while (i < _h6_n) {
        if (_https_get(_h6_url, _h6_trust) == 200) { atomic_fetch_add(&_h6_trust_ok, 1); }
        i = i + 1;
    }
    return 0;
}

fn _h6_open_worker(arg) {
    var i = 0;
    while (i < _h6_n) {
        if (_https_get(_h6_url, 0) == 200) { atomic_fetch_add(&_h6_open_ok, 1); }
        i = i + 1;
    }
    return 0;
}

fn main() {
    alloc_init();
    say("=== sandhi server-side TLS gate ===\n");

    if (tls_available() == 0) { say("SKIP (TLS unavailable)\n"); return 0; }

    # Read the fixtures up front — if any is missing, skip cleanly.
    var cert = alloc(8192);
    var key  = alloc(8192);
    var cert_len = file_read_all(CERT_PATH, cert, 8192);
    var key_len  = file_read_all(KEY_PATH, key, 8192);
    if (cert_len <= 0 || key_len <= 0) { say("SKIP (TLS fixtures missing)\n"); return 0; }

    var port = 18443;
    var pid = sys_fork();
    if (pid == 0) {
        # child: pooled TLS server, 4 worker threads, one route.
        var router = sandhi_router_new(0);
        sandhi_router_add(router, "GET", "/notes/:id", &note_handler);
        sandhi_router_add(router, "GET", "/arena", &arena_handler);
        sandhi_router_add(router, "GET", "/mem", &mem_handler);
        var opts = sandhi_server_options_new();
        sandhi_server_options_tls(opts, cert, cert_len, key, key_len);
        sandhi_server_options_max_conns(opts, 4);    # 4 worker threads
        sandhi_server_options_idle_ms(opts, 1000);   # slow-peer / silent bound
        sandhi_server_options_request_ms(opts, 1500);  # whole-request budget, [5]
        sandhi_server_options_req_arena(opts, 65536);  # per-request arena, [8]
        sandhi_server_run_pooled_tls(INADDR_LOOPBACK(), port,
          &sandhi_server_router_handler_c, router, opts);
        syscall(60, 0);
    }

    async_sleep_ms(500);   # let the child bind + spawn workers

    var fails = 0;
    var url = "https://127.0.0.1:18443/notes/55";

    # A trust-store policy that anchors on our self-signed cert (cert.pem).
    var trust = sandhi_tls_policy_new_trust_store(CA_PATH);

    # [1] burst of 8 HTTPS GETs — each a full TLS 1.3 handshake — all 200 + body.
    var ok = 0;
    var k = 0;
    while (k < 8) {
        if (_https_get(url, trust) == 200) { ok = ok + 1; }
        k = k + 1;
    }
    say("[1] HTTPS burst (trusted): "); fmt_int(ok); say(" / 8 → 200+body\n");
    if (ok != 8) { fails = fails + 1; }

    # [2] default-policy client (no trust store): the self-signed cert MUST be
    # rejected → anything but 200. A 200 here means verify was bypassed.
    var rej = _https_get(url, 0);
    say("[2] HTTPS default policy (untrusted) → "); fmt_int(rej);
    say(" (want != 200; rejected)\n");
    if (rej == 200) { fails = fails + 1; }

    # [3] isolation: a silent raw-TCP connection pins one worker in the
    # handshake read until SO_RCVTIMEO; the other workers must keep serving.
    var silent = sandhi_conn_open(INADDR_LOOPBACK(), port, 0, "");
    var ok2 = 0;
    var i = 0;
    while (i < 8) {
        if (_https_get(url, trust) == 200) { ok2 = ok2 + 1; }
        i = i + 1;
    }
    if (silent != 0) { sandhi_conn_close(silent); }
    say("[3] isolation (silent client held): "); fmt_int(ok2); say(" / 8 → 200\n");
    # The point is non-serialization: with a worker pinned, real requests still
    # serve. A serialized server would yield ~0 here; tolerate a rare 1-off
    # client transient (cold-start handshake hiccup) rather than be CI-flaky.
    if (ok2 < 7) { fails = fails + 1; }

    # [4] concurrent TLS handshakes — the multi-worker pool's core promise, and
    # the exact thing [1]-[3] never exercised. Fork pairs of clients that
    # handshake at the same instant against the 4-worker pool. GATING as of
    # sandhi 1.8.0 / cyrius 6.4.49: sigil auto-banks a private crypto-scratch
    # lane per thread (since 3.9.7; the 2026-06-28 process-global-scratch race is
    # fixed — verified 16/16), so a shortfall here is a real REGRESSION.
    var conc_ok = 0;
    var conc_total = 0;
    var r = 0;
    while (r < 8) {
        var p1 = sys_fork();
        if (p1 == 0) { _conc_child(url, trust); }
        var p2 = sys_fork();
        if (p2 == 0) { _conc_child(url, trust); }
        if (_wait_code(p1) == 0) { conc_ok = conc_ok + 1; }
        if (_wait_code(p2) == 0) { conc_ok = conc_ok + 1; }
        conc_total = conc_total + 2;
        r = r + 1;
    }
    say("[4] concurrent TLS handshakes (gate): "); fmt_int(conc_ok);
    say(" / "); fmt_int(conc_total); say(" survived\n");
    if (conc_ok < conc_total) {
        # REGRESSION — every concurrent handshake must survive on sigil's
        # per-thread crypto-scratch banking. If this fires, a sigil/cyrius pin
        # regressed the per-thread lanes, or max_conns>1 HTTPS broke.
        say("    REGRESSION: a concurrent TLS handshake failed — sigil per-thread\n");
        say("    crypto-scratch banking may have regressed on this pin.\n");
        fails = fails + 1;
    }

    # [5] dribble a TLS record header + body one byte every 300 ms. The server
    # must close the connection at its 1.5 s budget; a send fails soon after.
    signal_ignore(13);
    var dfd = 0 - 1;
    var dt_tag, dsock = tcp_socket();
    if (is_err_result(dt_tag) == 0) {
        if (is_err_result(sock_connect(dsock, INADDR_LOOPBACK(), port)) == 0) { dfd = dsock; }
    }
    var dropped_ms = 0 - 1;
    if (dfd >= 0) {
        var rec = alloc(16);
        store8(rec, 22); store8(rec + 1, 3); store8(rec + 2, 1); store8(rec + 3, 2); store8(rec + 4, 0);
        var t0 = clock_now_ms();
        var k5 = 0;
        while (dropped_ms < 0 && clock_now_ms() - t0 < 8000) {
            var b = 0;
            if (k5 < 5) { b = load8(rec + k5); }
            var one[8];
            store8(&one, b);
            if (sock_send_all(dfd, &one, 1) < 0) { dropped_ms = clock_now_ms() - t0; }
            k5 = k5 + 1;
            async_sleep_ms(300);
        }
        sock_close(dfd);
    }
    say("[5] dribbled handshake dropped after "); fmt_int(dropped_ms);
    say(" ms (want 0..4000; budget 1500)\n");
    if (dropped_ms < 0 || dropped_ms > 4000) { fails = fails + 1; }

    # [6] policy-hook isolation under concurrency.
    _h6_url = url;
    _h6_trust = trust;
    _h6_trust_ok = 0;
    _h6_open_ok = 0;
    var w0 = thread_create(&_h6_trust_worker, 0);
    var w1 = thread_create(&_h6_open_worker, 0);
    var w2 = thread_create(&_h6_open_worker, 0);
    var w3 = thread_create(&_h6_open_worker, 0);
    thread_join(w0); thread_join(w1); thread_join(w2); thread_join(w3);
    say("[6] concurrent hook isolation: no-policy accepted "); fmt_int(_h6_open_ok);
    say(" / "); fmt_int(3 * _h6_n); say(" (want 0); trust-store 200 ");
    fmt_int(_h6_trust_ok); say(" / "); fmt_int(_h6_n); say("\n");
    if (_h6_open_ok != 0) {
        say("    SECURITY: a no-policy request ran under another thread's policy hook\n");
        fails = fails + 1;
    }
    if (_h6_trust_ok < _h6_n - 1) { fails = fails + 1; }

    # [7] a policied request with the session cache on makes no lookup and no store.
    sandhi_session_cache_enable(1);
    sandhi_session_cache_reset_stats();
    var c7 = _https_get(url, trust);
    var lookups7 = sandhi_session_cache_hit_count() + sandhi_session_cache_miss_count();
    var size7 = sandhi_session_cache_size();
    sandhi_session_cache_enable(0);
    say("[7] policied open with the session cache on: status "); fmt_int(c7);
    say(", cache lookups "); fmt_int(lookups7); say(", entries "); fmt_int(size7);
    say(" (want 200, 0, 0)\n");
    if (c7 != 200 || lookups7 != 0 || size7 != 0) { fails = fails + 1; }

    # [8] the per-request arena reaches HTTPS handlers, and the heap stays flat.
    var ar = _https_get_int("https://127.0.0.1:18443/arena", trust);
    var m0 = _https_get_int("https://127.0.0.1:18443/mem", trust);
    var k8 = 0;
    while (k8 < 40) { _https_get(url, trust); k8 = k8 + 1; }
    var m1 = _https_get_int("https://127.0.0.1:18443/mem", trust);
    var per = 0 - 1;
    if (m0 >= 0 && m1 >= m0) { per = (m1 - m0) / 41; }
    say("[8] per-request arena on HTTPS: handler sees it "); fmt_int(ar);
    say(" (want 1); server heap growth "); fmt_int(per);
    say(" B/request (want 0..128: the stdlib PEM key decode)\n");
    if (ar != 1 || per < 0 || per > 128) { fails = fails + 1; }

    sys_kill(pid, 9);
    syscall(61, pid, 0, 0, 0);   # wait4 — reap the child

    if (fails == 0) { say("PASS\n"); return 0; }
    say("FAIL ("); fmt_int(fails); say(" checks failed)\n");
    return 1;
}

var ec = main();
syscall(60, ec);
