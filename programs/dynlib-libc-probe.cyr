fn say(m) {
    syscall(1, 1, m, strlen(m));
    syscall(74, 1);
    return 0;
}

fn main() {
    alloc_init();
    say("ENTRY\n");
    var h = dynlib_open("libcrypto.so.3");
    say("POST-LIBCRYPTO\n");
    return 0;
}

var exit_code = main();
syscall(60, exit_code);
